{
  "name": "landing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "build": "astro build && node -e \"const fs=require('fs'),path=require('path');function cp(src,dest){if(fs.statSync(src).isDirectory()){fs.mkdirSync(dest,{recursive:true});fs.readdirSync(src).forEach(f=>cp(path.join(src,f),path.join(dest,f)));}else{fs.copyFileSync(src,dest);}};if(fs.existsSync('dist/client')){fs.readdirSync('dist/client').forEach(f=>cp(path.join('dist/client',f),path.join('dist',f)));}\"",
    "start": "HOST=0.0.0.0 PORT=3000 node ./dist/server/entry.mjs",
    "og": "node scripts/generate-og.mjs",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "preview:worker": "astro build && wrangler dev",
    "deploy": "astro build && npm run db:migrate:remote && wrangler deploy",
    "deploy:ci": "npm run db:migrate:remote && wrangler deploy",
    "preview:ci": "node scripts/preview-ci.mjs",
    "version:upload": "astro build && wrangler versions upload",
    "version:promote": "wrangler versions deploy",
    "typecheck": "tsc -p src/server",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create squai",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "hono": "^4.13.13",
    "motion": "^14.14.0",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
