{
  "name": "landing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "og": "node scripts/generate-og.mjs",
    "preview": "astro preview",
    "preview:worker": "astro build && wrangler dev",
    "deploy": "astro build && pnpm db:migrate:remote && wrangler deploy",
    "deploy:ci": "pnpm db:migrate:remote && wrangler deploy",
    "version:upload": "astro build && wrangler versions upload",
    "version:promote": "wrangler versions deploy",
    "typecheck": "tsc -p src/server",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:create": "wrangler d1 create squai",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "hono": "^4.13.13",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
