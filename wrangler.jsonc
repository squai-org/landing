{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-page",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  // Workers Builds corre `npx wrangler preview` en las ramas que no son la de
  // produccion y exige este bloque aunque este vacio. Los Previews no heredan
  // los bindings de produccion (D1, rate limit, llaves de Bold): hasta que se
  // les asigne una base de pruebas, /api/* no funciona en una preview.
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {},
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squai",
      "database_id": "e4929a67-be39-4bc1-b0e1-ac37ceffa1db",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
