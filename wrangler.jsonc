{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-page",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squai",
      "database_id": "e4929a67-be39-4bc1-b0e1-ac37ceffa1db",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
