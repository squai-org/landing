# Sitekey pública del widget de Turnstile (se inyecta en el HTML en build time).
# Si se deja vacía, los formularios se renderizan sin verificación de bot.
# https://developers.cloudflare.com/turnstile/get-started/
PUBLIC_TURNSTILE_SITE_KEY=

# La secret key de Turnstile NO va en este archivo: es un secret del Worker.
#   pnpm wrangler secret put TURNSTILE_SECRET_KEY
