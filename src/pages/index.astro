---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Outcomes from '../components/Outcomes.astro';
import Program from '../components/Program.astro';
import Origin from '../components/Origin.astro';
import Instructors from '../components/Instructors.astro';
import Squad from '../components/Squad.astro';
import Includes from '../components/Includes.astro';
import Faq from '../components/Faq.astro';
import Organizations from '../components/Organizations.astro';
import FinalCta from '../components/FinalCta.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
---

<Layout
  title="Fundamentos de Inteligencia Artificial Generativa | Squai"
  description="Desarrolla el criterio para entender la IA, aprende a razonar con ella y domina las bases para usar cualquier herramienta con confianza."
>
  <div style="padding: 0 0 40px; background-color: #F4F6FF">
    <Header />
    <Hero />

    <div style="max-width:1344px;margin:28px auto 0;padding:0 32px;display:flex;flex-direction:column;gap:28px">
      <Problems />
      <Outcomes />
      <Program />
      <Origin />
      <Instructors />
      <Squad />
      <Includes />
      <Faq />
      <Organizations />
      <FinalCta />
      <Waitlist />
    </div>

    <Footer />
  </div>

  <ContactModal />
</Layout>

<script>
  // Smooth scroll to a section, matching the easing and 96px offset of the design.
  const scrollToSection = (id: string) => {
    const el = document.getElementById(id);
    if (!el) return;
    const target = el.getBoundingClientRect().top + window.scrollY - 96;
    const start = window.scrollY;
    const dist = target - start;
    const dur = 450;
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const step = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      window.scrollTo(0, start + dist * ease(p));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  document.querySelectorAll<HTMLElement>('[data-scroll-to]').forEach((el) => {
    el.addEventListener('click', (event) => {
      event.preventDefault();
      scrollToSection(el.dataset.scrollTo!);
    });
  });

  // FAQ accordion: one panel open at a time, closed on load.
  let openFaq: string | null = null;

  document.querySelectorAll<HTMLElement>('[data-faq-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const index = toggle.dataset.faqToggle!;
      openFaq = openFaq === index ? null : index;

      document.querySelectorAll<HTMLElement>('[data-faq-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.faqPanel !== openFaq;
      });
      document.querySelectorAll<HTMLElement>('[data-faq-sign]').forEach((sign) => {
        sign.textContent = sign.dataset.faqSign === openFaq ? '−' : '+';
      });
    });
  });

  // "Agendar llamada" modal.
  const modal = document.querySelector<HTMLElement>('[data-modal]');
  const modalPanel = document.querySelector<HTMLElement>('[data-modal-panel]');

  const setModal = (open: boolean) => {
    if (modal) modal.hidden = !open;
  };

  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((el) => {
    el.addEventListener('click', () => setModal(true));
  });
  document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((el) => {
    el.addEventListener('click', () => setModal(false));
  });
  modal?.addEventListener('click', () => setModal(false));
  modalPanel?.addEventListener('click', (event) => event.stopPropagation());
</script>
