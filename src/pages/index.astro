---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import Impact from '../components/Impact.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Origin from '../components/Origin.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import { getSiteContent } from '../lib/content';
const { faqs, seo } = await getSiteContent();
---

<Layout
  title={seo.title}
  description={seo.description}
>
  <div class="page-frame">
    <Header />

    <main id="contenido">
      <Hero />

      <div class="content-shell content-shell-spaced">
        <Statement />
        <WhatWeDo />
        <Impact />
        <ServicesGrid />
        <Origin />
        <Team />
        <Faq items={faqs} />
        <FinalCta />
      </div>
    </main>

    <Footer />
  </div>

  <ContactModal />
</Layout>

<style>
  .page-frame { padding-bottom: 40px; background: var(--canvas); }
  .content-shell-spaced { margin-top: clamp(16px, 1.6vw, 28px); }
</style>
