---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import WhatWeDo from '../components/WhatWeDo.astro';
import Impact from '../components/Impact.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Origin from '../components/Origin.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Follow from '../components/Follow.astro';
import Footer from '../components/Footer.astro';
import ContactModal from '../components/ContactModal.astro';
import { faqs } from '../data/landing';
---

<Layout
  title="Squai — Aprende IA, potencia tus habilidades"
  description="Squai enseña inteligencia artificial a personas, equipos y comunidades educativas que no vienen de la tecnología. Sin jerga, sin humo y con práctica desde el primer día."
>
  <div style="padding:0 0 40px;background-color:#F4F6FF">
    <Header />
    <Hero />

    <div class="content-shell" style="margin-top:clamp(16px,1.6vw,28px)">
      <Statement />
      <WhatWeDo />
      <Impact />
      <ServicesGrid />
      <Origin />
      <Team />
      <Faq items={faqs} />
      <FinalCta />
      <Follow />
    </div>

    <Footer />
  </div>

  <ContactModal />
</Layout>
