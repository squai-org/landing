---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceBento from '../../components/ServiceBento.astro';
import ServicePayback from '../../components/ServicePayback.astro';
import ServiceCapabilities from '../../components/ServiceCapabilities.astro';
import Waitlist from '../../components/Waitlist.astro';
import Faq from '../../components/Faq.astro';
import Footer from '../../components/Footer.astro';
import ContactModal from '../../components/ContactModal.astro';
import Button from '../../components/Button.astro';
import { getSiteContent } from '../../lib/content';
import {
  absoluteUrl,
  breadcrumbSchema,
  courseSchema,
  faqSchema,
  organizationSchema,
  serviceSchema,
  serviceSeo,
  webPageSchema,
  websiteSchema,
} from '../../lib/seo';

const content = await getSiteContent();

export async function getStaticPaths() {
  const { services } = await getSiteContent();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;

const pageUrl = absoluteUrl(`/servicios/${service.slug}`);
const seo = serviceSeo(service, content.seo.serviceTitle);
const capabilitiesHeadline = service.slug === 'squai-one' ? service.capabilities.headline : content.ui.services.capabilitiesFallback;

const offering =
  service.slug === 'squai-one' ? courseSchema(content, service, pageUrl) : serviceSchema(service, pageUrl);

const schemas = [
  organizationSchema(content),
  websiteSchema(),
  webPageSchema({ url: pageUrl, title: seo.title, description: seo.description }),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/#servicios' },
    { name: service.name, path: `/servicios/${service.slug}` },
  ]),
  offering,
  faqSchema(service.faqs, pageUrl),
];
---

<Layout title={seo.title} description={seo.description} schemas={schemas}>
  <div class="page-frame">
  <Header />

  <main id="contenido">
  <ServiceHero service={service} />

  <div class="content-shell content-shell-spaced">

  <ServicePayback headline={service.payback.headline} body={service.payback.body} cta={service.cta} />

  <ServiceBento title={service.challenge.headline} cards={service.challenge.cards} tones={['', '', '']} dark />

  <ServiceCapabilities headline={capabilitiesHeadline} groups={service.capabilities.groups} />

  {
    service.cta.modal ? (
      <section class="section tint">
        <div class="shell service-contact-shell">
          <h2 class="display d-h2 service-contact-title">
            {service.contactCopy}
          </h2>
          {service.contactAside && <p class="service-contact-aside">{service.contactAside}</p>}
          <Button variant="dark" data-open-modal={service.cta.modal}>{service.cta.label}</Button>
        </div>
      </section>
    ) : (
      <Waitlist />
    )
  }

  <Faq items={service.faqs} />
  </div>
  </main>

  <Footer />
  </div>

  <ContactModal />
</Layout>

<style>
  .page-frame { padding-bottom: 40px; background: var(--canvas); }
  .content-shell-spaced { margin-top: clamp(16px, 1.6vw, 28px); }
  .service-contact-shell { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(20px, 2.4vw, 36px); }
  .service-contact-title { max-width: 22ch; color: var(--ink); }
  .service-contact-aside {
    max-width: 38ch;
    margin: 0;
    color: var(--periwinkle-ink);
    font-family: var(--font-hand);
    font-size: clamp(18px, 1.5vw, 24px);
    font-weight: 100;
    line-height: 1.5;
  }
</style>
