---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import OneHero from '../../components/OneHero.astro';
import OneKeyFacts from '../../components/OneKeyFacts.astro';
import VideoSection from '../../components/VideoSection.astro';
import ServiceBento from '../../components/ServiceBento.astro';
import ServicePayback from '../../components/ServicePayback.astro';
import ServiceCapabilities from '../../components/ServiceCapabilities.astro';
import AudienceFit from '../../components/AudienceFit.astro';
import OneRequirements from '../../components/OneRequirements.astro';
import OneOutcomes from '../../components/OneOutcomes.astro';
import OneMarquee from '../../components/OneMarquee.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Syllabus from '../../components/Syllabus.astro';
import Checkout from '../../components/Checkout.astro';
import Faq from '../../components/Faq.astro';
import OneTeam from '../../components/OneTeam.astro';
import OneTestimonials from '../../components/OneTestimonials.astro';
import Footer from '../../components/Footer.astro';
import ContactModal from '../../components/ContactModal.astro';
import Button from '../../components/Button.astro';
import { getSiteContent } from '../../lib/content';
import {
  absoluteUrl,
  breadcrumbSchema,
  courseSchema,
  faqSchema,
  organizationSchema,
  serviceSchema,
  serviceSeo,
  webPageSchema,
  websiteSchema,
} from '../../lib/seo';
import { resolveWhatsappConfig } from '../../lib/whatsapp';

const content = await getSiteContent();

export async function getStaticPaths() {
  const { services } = await getSiteContent();
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const whatsapp = resolveWhatsappConfig(content.ui.whatsapp, service.whatsapp);

const pageUrl = absoluteUrl(`/servicios/${service.slug}`);
const seo = serviceSeo(service, content.seo.serviceTitle);

const offering = service.keyFacts
  ? courseSchema(content, service, service.keyFacts.load, pageUrl)
  : serviceSchema(content, service, pageUrl);
const headerTone = service.hero ? 'light' : 'dark';

const schemas = [
  organizationSchema(content),
  websiteSchema(content),
  webPageSchema({ url: pageUrl, title: seo.title, description: seo.description }),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Servicios', path: '/#servicios' },
    { name: service.name, path: `/servicios/${service.slug}` },
  ]),
  offering,
  faqSchema(service.faqs, pageUrl),
];
---

<Layout title={seo.title} description={seo.description} schemas={schemas} service={service.slug}>
  <div class="page-frame">
  <Header tone={headerTone} />

  <main id="contenido">
  {service.hero ? <OneHero service={service} /> : <ServiceHero service={service} />}
  {service.keyFacts && <OneKeyFacts service={service} />}

  {service.video && <VideoSection video={service.video} />}

  {
    service.payback && (
      <div class="content-shell content-shell-spaced">
        <ServicePayback
          headline={service.payback.headline}
          body={service.payback.body}
          cta={service.ctaSecondary ? { ...service.cta, label: service.ctaSecondary } : service.cta}
        />
      </div>
    )
  }

  {service.audienceFit && <AudienceFit fit={service.audienceFit} cta={service.cta} />}

  {service.beforeSignup && <OneRequirements beforeSignup={service.beforeSignup} />}

  {service.outcomes && <OneOutcomes outcomes={service.outcomes} />}

  {service.howItWorks && <HowItWorks flow={service.howItWorks} cta={service.cta} />}

  {service.syllabus && <Syllabus syllabus={service.syllabus} cta={service.cta} />}

  <div class="content-shell content-shell-joined">

  {service.challenge && <ServiceBento title={service.challenge.headline} cards={service.challenge.cards} tones={['', '', '']} dark />}

  {service.capabilities && <ServiceCapabilities headline={service.capabilities.headline} groups={service.capabilities.groups} />}

  </div>

  {service.marquee && service.hero && <OneMarquee marquee={service.marquee} hero={service.hero} />}

  {service.team && <OneTeam title={service.team.title} closing={service.team.closing} cta={service.cta} profiles={service.team.mentors} />}

  {service.testimonials && <OneTestimonials title={service.testimonials.title} quotes={service.testimonials.quotes} />}

  {
    service.cta.modal ? (
      <div class="content-shell content-shell-joined">
      <section class="section tint">
        <div class="shell service-contact-shell">
          <h2 class="display d-h2 service-contact-title">
            {service.contactCopy}
          </h2>
          {service.contactAside && <p class="service-contact-aside">{service.contactAside}</p>}
          <Button variant="dark" data-open-modal={service.cta.modal}>{service.contactCta ?? service.cta.label}</Button>
        </div>
      </section>
      </div>
    ) : (
      <Checkout investment={service.investment} />
    )
  }

  {
    service.hero ? (
      <Faq items={service.faqs} intro={service.faqIntro} />
    ) : (
      <div class="content-shell content-shell-joined content-shell-over-footer">
        <Faq items={service.faqs} intro={service.faqIntro} />
      </div>
    )
  }
  </main>

  <Footer overlap whatsappMessage={whatsapp.message} />
  </div>

  <ContactModal />
</Layout>

<style>
  .page-frame { background: var(--surface); }
  .content-shell-spaced { margin-top: clamp(16px, 1.6vw, 28px); }
  .content-shell-joined { margin-top: clamp(16px, 1.6vw, 28px); }
  .content-shell-joined:empty { display: none; }
  .content-shell-over-footer { position: relative; z-index: 20; }
  .service-contact-shell { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(20px, 2.4vw, 36px); }
  .service-contact-title { max-width: 22ch; color: var(--ink); }
  .service-contact-aside {
    max-width: 38ch;
    margin: 0;
    color: var(--accent-ink);
    font-family: var(--font-hand);
    font-size: clamp(18px, 1.5vw, 24px);
    font-weight: 100;
    line-height: 1.5;
  }
</style>
