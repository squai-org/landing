---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import ServiceBento from '../../components/ServiceBento.astro';
import ServiceCapabilities from '../../components/ServiceCapabilities.astro';
import Waitlist from '../../components/Waitlist.astro';
import Faq from '../../components/Faq.astro';
import Follow from '../../components/Follow.astro';
import Footer from '../../components/Footer.astro';
import ContactModal from '../../components/ContactModal.astro';
import { services } from '../../data/landing';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
---

<Layout title={`${service.name} — Squai`} description={service.slogan}>
  <Header />
  <ServiceHero service={service} />

  <ServiceBento
    title="Qué obtienes"
    headline={service.payback.headline}
    cards={service.payback.cards}
    tones={['peri', '', 'teal']}
  />

  <ServiceBento title={service.challenge.headline} cards={service.challenge.cards} tones={['', '', '']} dark />

  <ServiceCapabilities headline={service.capabilities.headline} groups={service.capabilities.groups} />

  {
    service.cta.modal ? (
      <section class="section-tight">
        <div class="shell" style="display:flex;flex-direction:column;align-items:flex-start;gap:clamp(20px,2.4vw,36px)">
          <h2 class="display d-h2" style="color:var(--ink);max-width:22ch">
            Cuéntanos dónde están hoy y armamos la propuesta sobre eso.
          </h2>
          <button
            type="button"
            class="btn-dark"
            data-open-modal={service.cta.modal}
            style="font-family:var(--font-body);font-size:16px;font-weight:700;color:#FFFFFF;background:#0D0D0D;border:0;border-radius:100px;padding:16px 32px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(13,27,42,.4)"
          >
            {service.cta.label}
          </button>
        </div>
      </section>
    ) : (
      <Waitlist />
    )
  }

  <Faq items={service.faqs} />
  <Follow />
  <Footer />
  <ContactModal />
</Layout>
