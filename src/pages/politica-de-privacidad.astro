---
import LegalLayout from '../layouts/LegalLayout.astro';
import LegalSections from '../components/LegalSections.astro';
import { getSiteContent } from '../lib/content';
const { legal, labels } = await getSiteContent();
const page = legal.privacy;
---

<LegalLayout title={page.title} description={page.description} pageTitle={labels.privacy} updated={page.updated}>
  <LegalSections sections={page.sections} />
</LegalLayout>
