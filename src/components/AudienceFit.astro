---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import OneBackdrop from './OneBackdrop.astro';
import type { Service } from '../lib/content';
import teamTable from '../assets/one/para-ti/pexels-3184325.jpeg';
import teamLead from '../assets/one/para-ti/pexels-3184405.jpeg';
import charts from '../assets/one/para-ti/pexels-3184292.jpeg';
import officeTalk from '../assets/one/para-ti/pexels-3182765.jpeg';
import laptopDesk from '../assets/one/para-ti/pexels-4050315.jpeg';
import colleagues from '../assets/one/para-ti/pexels-3153198.jpeg';
import shrugMan from '../assets/one/para-ti/pexels-8638716.jpeg';
import shrugWoman from '../assets/one/para-ti/pexels-3958872.jpeg';
import '../styles/one-sections.css';

interface Props {
  fit: NonNullable<Service['audienceFit']>;
  cta: Service['cta'];
}

const { fit, cta } = Astro.props;

interface Photo {
  src: ImageMetadata;
  alt: string;
  position: string;
}

interface Art {
  src: string;
  alt: string;
}

type StepMedia =
  | { kind: 'photo'; pair: [Photo, Photo] }
  | { kind: 'art'; pair: [Art, Art] };

interface FitStep {
  index: number;
  blockIndex: number;
  itemIndex: number;
  t: string;
  d?: string;
  media: StepMedia;
}

interface FitBlock {
  blockIndex: number;
  title: string;
  handwritten: string;
  items: FitStep[];
}

const photoSources: { src: ImageMetadata; position: string }[] = [
  { src: teamTable, position: 'center' },
  { src: teamLead, position: 'right top' },
  { src: charts, position: 'center' },
  { src: officeTalk, position: 'top' },
  { src: laptopDesk, position: 'center' },
  { src: colleagues, position: 'top' },
];

const photos: Photo[] = photoSources.map((photo, index) => ({ ...photo, alt: fit.photoAlts[index]! }));

const photoPairs: [Photo, Photo][] = [
  [photos[0]!, photos[1]!],
  [photos[2]!, photos[3]!],
  [photos[4]!, photos[5]!],
];

const notForYouSources: { src: ImageMetadata; position: string }[] = [
  { src: shrugMan, position: 'center 18%' },
  { src: shrugWoman, position: 'center 25%' },
];

const notForYouPair: [Photo, Photo] = [
  { src: notForYouSources[0]!.src, alt: fit.notForYou?.photoAlts?.[0] ?? '', position: notForYouSources[0]!.position },
  { src: notForYouSources[1]!.src, alt: fit.notForYou?.photoAlts?.[1] ?? '', position: notForYouSources[1]!.position },
];

const pairFor = (index: number) => photoPairs[index % photoPairs.length]!;

const rawBlocks: { title: string; handwritten: string; items: { t: string; d?: string; media: StepMedia }[] }[] = [
  {
    title: fit.title,
    handwritten: fit.handwritten,
    items: fit.profiles.map((profile, index) => ({
      t: profile.t,
      d: profile.d,
      media: { kind: 'photo', pair: pairFor(index) },
    })),
  },
];

if (fit.notForYou) {
  rawBlocks.push({
    title: fit.notForYou.title,
    handwritten: fit.notForYou.handwritten,
    items: fit.notForYou.items.map((item) => ({
      t: item.t,
      d: item.d,
      media: { kind: 'photo', pair: notForYouPair },
    })),
  });
}

if (fit.requirements) {
  rawBlocks.push({
    title: fit.requirements.title,
    handwritten: fit.requirements.handwritten,
    items: fit.requirements.items.map((item) => ({
      t: item.t,
      d: item.d,
      media: {
        kind: 'art',
        pair: [
          { src: item.leftIllustration, alt: item.leftAlt },
          { src: item.rightIllustration, alt: item.rightAlt },
        ],
      },
    })),
  });
}

const steps: FitStep[] = [];
const blocks: FitBlock[] = rawBlocks.map((block, blockIndex) => {
  const items = block.items.map((item, itemIndex) => {
    const step: FitStep = {
      index: steps.length,
      blockIndex,
      itemIndex,
      t: item.t,
      d: item.d,
      media: item.media,
    };
    steps.push(step);
    return step;
  });
  return {
    blockIndex,
    title: block.title,
    handwritten: block.handwritten,
    items,
  };
});
const blockCounts = blocks.map((block) => block.items.length);
---

<section id="para-quien" class="one-fit one-u" aria-labelledby="fit-title" data-fit data-fit-counts={JSON.stringify(blockCounts)}>
  <OneBackdrop shape="benefits" colors={['#5a5bb6', '#777ae3']} opacities={[0.35, 0.18]} flip="x" small />

  <div class="one-fit-content">
    <div class="one-fit-heading" data-fit-heading>
      <h2 id="fit-title" class="one-h2">
        {blocks.map((block) => <span data-fit-title-part={block.blockIndex} hidden={block.blockIndex !== 0}>{block.title}</span>)}
      </h2>
      <p class="one-hand one-fit-note">
        {blocks.map((block) => <span data-fit-note-part={block.blockIndex} hidden={block.blockIndex !== 0}>{block.handwritten}</span>)}
      </p>
    </div>

    <div class="one-fit-stage">
      <div class="one-fit-previews" aria-hidden="true">
        {
          [0, 1].map((side) => (
            <div class:list={['one-fit-preview', side === 0 ? 'is-left' : 'is-right']} data-fit-preview={side}>
              <div class="one-fit-photo">
                {steps.map((step) =>
                  step.media.kind === 'photo' ? (
                    <Image
                      src={step.media.pair[side]!.src}
                      alt={step.media.pair[side]!.alt}
                      widths={[350, 700]}
                      sizes="(min-width: 992px) 18vw, 50vw"
                      loading="lazy"
                      style={`object-position:${step.media.pair[side]!.position}`}
                      data-fit-photo={step.index}
                      hidden={step.index !== 0}
                    />
                  ) : (
                    <img
                      class="one-fit-art"
                      src={step.media.pair[side]!.src}
                      alt={step.media.pair[side]!.alt}
                      loading="lazy"
                      data-fit-photo={step.index}
                      hidden={step.index !== 0}
                    />
                  )
                )}
              </div>
            </div>
          ))
        }
      </div>

      {
        blocks.map((block) => (
          <ul class="one-fit-list" data-fit-block={block.blockIndex} hidden={block.blockIndex !== 0}>
            {
              block.items.map((step) => (
                <li class="one-fit-item" data-fit-step={step.index} data-selected={step.index === 0 ? 'true' : 'false'}>
                  <button type="button" class="one-fit-button" data-fit-option={step.index} aria-pressed={step.index === 0 ? 'true' : 'false'} aria-controls="fit-example">
                    <span class="one-fit-label">{step.t}</span>
                    <span class="one-fit-label-active" aria-hidden="true">{step.t}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        ))
      }
    </div>

    <div class="one-fit-bottom">
      <div id="fit-example" aria-live="polite" data-fit-example-wrap hidden={!steps[0]?.d}>
        {
          steps.map((step) => (
            <p
              class="one-lead one-fit-example"
              data-fit-example={step.index}
              data-empty={step.d ? undefined : 'true'}
              hidden={step.index !== 0 || !step.d}
            >
              {step.d ?? ''}
            </p>
          ))
        }
      </div>

      <div class="one-fit-cta">
        {
          cta.modal ? (
            <Button variant="gold" arrow data-open-modal={cta.modal}>{cta.label}</Button>
          ) : (
            <Button variant="gold" arrow href={`#${cta.target}`} data-scroll-to={cta.target}>{cta.label}</Button>
          )
        }
      </div>
    </div>
  </div>

  <div class="one-fit-runway" aria-hidden="true" data-fit-runway style={`--fit-profiles: ${steps.length}`}></div>
</section>

<script>
  import { animate, onReducedMotionChange, prefersReducedMotion, springs, tweens } from '../lib/motion';
  import { profileAt, scrollDrivesProfile, scrollTopFor, stepLocation } from '../lib/fit-scroll';

  const section = document.querySelector<HTMLElement>('[data-fit]');
  if (section) {
    const counts: number[] = JSON.parse(section.dataset.fitCounts ?? '[]');
    const items = Array.from(section.querySelectorAll<HTMLElement>('[data-fit-step]'));
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-fit-option]'));
    const lists = Array.from(section.querySelectorAll<HTMLElement>('[data-fit-block]'));
    const titleParts = Array.from(section.querySelectorAll<HTMLElement>('[data-fit-title-part]'));
    const noteParts = Array.from(section.querySelectorAll<HTMLElement>('[data-fit-note-part]'));
    const heading = section.querySelector<HTMLElement>('[data-fit-heading]');
    const examples = Array.from(section.querySelectorAll<HTMLElement>('[data-fit-example]'));
    const exampleWrap = section.querySelector<HTMLElement>('[data-fit-example-wrap]');
    const previews = Array.from(section.querySelectorAll<HTMLElement>('[data-fit-preview]'));
    const runway = section.querySelector<HTMLElement>('[data-fit-runway]');
    let reduced = prefersReducedMotion();
    onReducedMotionChange((value) => {
      reduced = value;
    });
    let settled = false;

    let selected = 0;
    let shownBlock = 0;
    let shownExample = 0;
    let pointer = { x: 0, y: 0 };

    const showBlock = (nextBlock: number) => {
      if (nextBlock === shownBlock) return;
      const previousList = lists[shownBlock];
      const nextList = lists[nextBlock];
      shownBlock = nextBlock;
      const reveal = () => {
        titleParts.forEach((part) => (part.hidden = Number(part.dataset.fitTitlePart) !== nextBlock));
        noteParts.forEach((part) => (part.hidden = Number(part.dataset.fitNotePart) !== nextBlock));
        lists.forEach((list) => (list.hidden = list !== nextList));
        if (!reduced && settled) {
          if (heading) animate(heading, { opacity: [0, 1], y: [8, 0] }, tweens.audienceExample);
          if (nextList) animate(nextList, { opacity: [0, 1], y: [8, 0] }, tweens.audienceExample);
        }
      };
      if (reduced || !settled) {
        reveal();
        return;
      }
      const animations: Promise<unknown>[] = [];
      if (heading) animations.push(animate(heading, { opacity: 0, y: -6 }, tweens.audienceExample).finished);
      if (previousList) animations.push(animate(previousList, { opacity: 0, y: -6 }, tweens.audienceExample).finished);
      Promise.all(animations).then(() => {
        if (shownBlock === nextBlock) reveal();
      });
    };

    const showExample = (next: number) => {
      if (next === shownExample) return;
      const current = examples[shownExample]!;
      const incoming = examples[next]!;
      const currentHasText = current.dataset.empty !== 'true';
      const incomingHasText = incoming.dataset.empty !== 'true';
      shownExample = next;
      const reveal = () => {
        examples.forEach((example) => (example.hidden = example !== incoming || !incomingHasText));
        if (exampleWrap) exampleWrap.hidden = !incomingHasText;
        if (!reduced && settled && incomingHasText) animate(incoming, { opacity: [0, 1], y: [8, 0] }, tweens.audienceExample);
      };
      if (reduced || !settled || !currentHasText) {
        reveal();
        return;
      }
      animate(current, { opacity: 0, y: -6 }, tweens.audienceExample).finished.then(() => {
        if (shownExample === next) reveal();
      });
    };

    const render = () => {
      const location = stepLocation(selected, counts);
      const rowY = location.itemIndex * 54;
      items.forEach((item, index) => (item.dataset.selected = String(selected === index)));
      buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(selected === index)));
      showBlock(location.blockIndex);
      previews.forEach((preview, side) => {
        const left = side === 0;
        const x = left ? pointer.x * -0.7 : pointer.x * 0.85;
        const y = left ? rowY * 0.5 + pointer.y * -0.5 : rowY * 0.5 + 32 + pointer.y * 0.65;
        animate(preview, { opacity: 1, x, y, scale: 1, rotate: left ? -8 : 7 }, reduced || !settled ? { duration: 0 } : springs.audienceSwap);
        preview.querySelectorAll<HTMLElement>('[data-fit-photo]').forEach((photo) => {
          photo.hidden = Number(photo.dataset.fitPhoto) !== selected;
        });
      });
      showExample(selected);
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        selected = index;
        render();
        const fitTrack = track();
        if (!scrollDrivesProfile(fitTrack)) return;
        jumpTarget = index;
        window.scrollTo({ top: scrollTopFor(index, fitTrack), behavior: reduced ? 'instant' : 'smooth' });
      });
    });

    const track = () => ({
      start: section.getBoundingClientRect().top + window.scrollY,
      length: runway?.offsetHeight ?? 0,
      profiles: buttons.length,
    });
    let jumpTarget: number | null = null;
    let ticking = false;
    const followScroll = () => {
      ticking = false;
      const fitTrack = track();
      if (!scrollDrivesProfile(fitTrack)) return;
      const next = profileAt(window.scrollY, fitTrack);
      if (jumpTarget !== null) {
        if (next !== jumpTarget) return;
        jumpTarget = null;
      }
      if (next === selected) return;
      selected = next;
      render();
    };
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(followScroll);
      },
      { passive: true }
    );
    window.addEventListener('scrollend', () => {
      jumpTarget = null;
      followScroll();
    });
    section.addEventListener('mousemove', (event) => {
      const rect = section.getBoundingClientRect();
      pointer = {
        x: ((event.clientX - rect.left) / rect.width - 0.5) * 28,
        y: ((event.clientY - rect.top) / rect.height - 0.5) * 22,
      };
      render();
    });
    selected = profileAt(window.scrollY, track());
    render();
    settled = true;
  }
</script>

<style>
  .one-fit {
    --fit-step: 70svh;
    position: relative;
    z-index: 10;
    width: 100%;
    overflow: clip;
    margin-top: calc(var(--edge-r) * -1);
    padding: 0 var(--gutter) var(--edge-r);
    border-radius: var(--edge-r) var(--edge-r) 0 0;
    background: var(--periwinkle-12);
    color: var(--canvas);
  }
  .one-fit-content {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    margin-inline: auto;
    padding-block: var(--section-py);
  }
  .one-fit-runway { height: calc(var(--fit-profiles) * var(--fit-step)); }
  .one-fit-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--u) * 16);
    width: 100%;
    max-width: calc(var(--u) * 1100);
    margin: 0 auto calc(var(--u) * 64);
    text-align: center;
  }
  .one-fit-heading h2 { color: var(--canvas); }
  .one-fit-note { display: inline-block; color: var(--gold-9); rotate: -1.5deg; }
  .one-fit-stage { position: relative; width: 100%; max-width: calc(var(--u) * 1760); margin-inline: auto; }
  .one-fit-previews { display: none; pointer-events: none; }
  .one-fit-preview {
    position: absolute;
    z-index: 20;
    width: calc(var(--u) * 333);
    padding: calc(var(--u) * 13);
    border-radius: calc(var(--u) * 37);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  }
  .one-fit-preview.is-left { left: 0; top: 1rem; background: #fff; }
  .one-fit-preview.is-right { right: 0; top: 2.5rem; background: var(--gold-9); }
  .one-fit-photo {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: calc(var(--u) * 26);
    background: var(--periwinkle-2);
  }
  .one-fit-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .one-fit-photo :global(img.one-fit-art) { object-fit: contain; padding: calc(var(--u) * 14); }
  .one-fit-list {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: calc(var(--u) * 960);
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  .one-fit-list[hidden] { display: none; }
  .one-fit-item { width: 100%; padding: calc(var(--u) * 10) 0; }
  .one-fit-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .one-fit-label {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 0.91;
    letter-spacing: -0.04em;
    color: var(--canvas);
    -webkit-text-stroke: 0.02em currentColor;
    paint-order: stroke fill;
    text-wrap: balance;
    will-change: transform, filter, opacity;
    transition:
      opacity 0.15s 0.05s var(--ease-smooth),
      scale 0.35s var(--ease-bounce),
      filter 0.25s 0.05s var(--ease-smooth);
  }
  .one-fit-label-active {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-hand);
    font-size: calc(var(--fs-h2) * 0.74);
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--gold-9);
    opacity: 0;
    scale: 0.75 1.25;
    filter: blur(2px);
    will-change: transform, filter, opacity;
    transition:
      opacity 0.15s 0.05s var(--ease-smooth),
      scale 0.35s var(--ease-bounce),
      filter 0.25s 0.05s var(--ease-smooth);
  }
  .one-fit-item[data-selected='true'] .one-fit-label { opacity: 0; scale: 0.75 1.25; filter: blur(2px); }
  .one-fit-item[data-selected='true'] .one-fit-label-active { opacity: 1; scale: 1 1; filter: blur(0); }

  .one-fit-bottom {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 24);
    width: 100%;
    max-width: calc(var(--u) * 840);
    margin: calc(var(--u) * 64) auto 0;
    text-align: center;
  }
  .one-fit-example { color: var(--periwinkle-4); }
  .one-fit-cta { display: flex; justify-content: center; }

  @media (max-width: 1023px) {
    .one-fit-content { padding-block: min(var(--section-py), 5svh); }
    .one-fit-heading { margin-bottom: min(calc(var(--u) * 64), 4svh); }
    .one-fit-bottom { margin-top: min(calc(var(--u) * 64), 4svh); }
  }
  @media (max-width: 1023px) and (min-height: 560px) {
    .one-fit-content, .one-fit-heading, .one-fit-bottom { transition: padding .3s var(--ease-smooth), margin .3s var(--ease-smooth); }
    :global(html:has(.site-header[data-hidden='false'])) .one-fit-content { padding-block: calc(var(--header-pt) + var(--pill-h) + 12px) 2svh; }
    :global(html:has(.site-header[data-hidden='false'])) .one-fit-heading { margin-bottom: min(calc(var(--u) * 64), 2.5svh); }
    :global(html:has(.site-header[data-hidden='false'])) .one-fit-bottom { margin-top: min(calc(var(--u) * 64), 2.5svh); }
  }
  @media (max-height: 559px) {
    .one-fit-content { position: relative; min-height: 0; }
    .one-fit-runway { display: none; }
  }
  @media (min-width: 1024px) {
    .one-fit-previews { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .one-fit-content, .one-fit-heading, .one-fit-bottom { transition: none; }
  }
</style>
