---
import { manifesto } from '../data/landing';
---

<!-- Statement block. Purpose lives in the sentence, not in a "Misión:" label. -->
<div class="section-pad" style="background:#8A8EF9;border-radius:40px;padding:96px 64px">
  <div class="grid-sidebar" style="max-width:1152px;margin:0 auto;display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:start">
    <div>
      <h2
        class="statement"
        style="margin:0;font-family:var(--font-display);font-weight:700;font-size:56px;line-height:.98;letter-spacing:-0.05em;color:#0A0C1A;text-wrap:balance"
      >
        {manifesto.statement}
      </h2>
      <p class="hand-note" style="margin:32px 0 0;font-family:var(--font-hand);font-size:22px;line-height:1.45;color:#0A0C1A;opacity:.72;transform:rotate(-1deg)">
        {manifesto.note}
      </p>
    </div>
    <div style="display:flex;flex-direction:column;gap:20px;padding-top:8px">
      {
        manifesto.body.map((para) => (
          <p style="margin:0;font-size:18px;line-height:1.7;color:#0A0C1A;opacity:.88;text-wrap:pretty">{para}</p>
        ))
      }
    </div>
  </div>
</div>
