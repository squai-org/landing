---
import { instructors } from '../data/landing';
---

<div id="instructores" class="section-pad" style="padding:88px 64px 0">
  <div style="max-width:1152px;margin:0 auto">
    <div class="eyebrow" style="margin-bottom:18px">Quiénes enseñan</div>
    <h2
      class="h2-title"
      style="margin:0 0 12px;font-family:var(--font-display);font-weight:700;font-size:44px;line-height:1.02;letter-spacing:-0.045em;color:#0A0C1A"
    >
      Fundadores de Squai
    </h2>
    <p style="margin:0 0 36px;font-size:17px;line-height:1.7;color:#4B5167;max-width:60ch;text-wrap:pretty">
      Los mismos que dan las clases en vivo y responden en la comunidad. Nadie graba una vez y desaparece.
    </p>
    <div class="grid-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px">
      {
        instructors.map((ins) => (
          <div
            class="instructor-card card-instructor"
            style="display:flex;gap:26px;align-items:center;background:#FFFFFF;border:1px solid #DCE1F0;border-radius:32px;padding:26px"
          >
            <img
              src={ins.img}
              alt={ins.name}
              loading="lazy"
              class="instructor-photo"
              style="width:143px;height:164px;flex:none;object-fit:cover;border-radius:24px;background:#E4E5FE"
            />
            <div style="min-width:0">
              <div style="font-family:var(--font-display);font-weight:700;font-size:24px;letter-spacing:-0.03em;color:#0A0C1A">
                {ins.name}
              </div>
              <div style="margin:6px 0 16px;font-size:15px;line-height:1.55;color:#4B5167">{ins.role}</div>
              <a
                href={ins.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={ins.aria}
                class="btn-white"
                style="display:inline-flex;align-items:center;gap:9px;padding:9px 16px;border:1px solid #DCE1F0;border-radius:100px;font-family:var(--font-display);font-size:13px;font-weight:700;color:#0A0C1A;background:#FFFFFF"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4V9Z" />
                </svg>
                LinkedIn
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
