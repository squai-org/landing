---
import OneBackdrop from './OneBackdrop.astro';
import type { Service } from '../lib/content';
import '../styles/one-sections.css';

interface Props {
  outcomes: NonNullable<Service['outcomes']>;
}

const { outcomes } = Astro.props;
---

<section id="logros" class="one-outcomes one-u" aria-labelledby="one-outcomes-title" data-header-tone="light">
  <OneBackdrop shape="benefits" colors={['#fdebc9', '#FFFFFF']} opacities={[0.7, 0.85]} />

  <div class="one-outcomes-content">
    <div class="one-outcomes-heading">
      <h2 id="one-outcomes-title" class="one-h2">{outcomes.title}</h2>
      <p class="one-lead one-outcomes-lead">{outcomes.lead}</p>
      {outcomes.handwritten && <p class="one-hand one-outcomes-note">{outcomes.handwritten}</p>}
    </div>

    <div class="one-outcomes-stage" data-outcomes-stage>
      <ul class="one-outcomes-list">
        {
          outcomes.pills.map((text) => (
            <li class="outcome-label" data-outcome-label>
              <div class="outcome-push" data-outcome-push>
                <div class="outcome-pill" data-outcome-pill>
                  <span class="outcome-text">{text}</span>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  import { animate, inView, onReducedMotionChange, prefersReducedMotion, springs } from '../lib/motion';
  import { kick, restingBody, settled, step, transformOf } from '../lib/momentum';

  const stage = document.querySelector<HTMLElement>('[data-outcomes-stage]');

  if (stage) {
    const pills = Array.from(stage.querySelectorAll<HTMLElement>('[data-outcome-pill]'));
    let entered = prefersReducedMotion();

    if (!entered) {
      const entryRotate = Math.round(Math.random() * 66 - 33);
      pills.forEach((pill) => animate(pill, { scale: 0, rotate: entryRotate }, { duration: 0 }));
      inView(
        stage,
        () => {
          if (entered) return;
          entered = true;
          pills.forEach((pill, index) => animate(pill, { scale: 1, rotate: 0 }, { ...springs.outcomeLabel, delay: index * 0.072 }));
        },
        { margin: '0px 0px -75% 0px' }
      );
    }

    onReducedMotionChange((reduced) => {
      if (!reduced || entered) return;
      entered = true;
      pills.forEach((pill) => animate(pill, { scale: 1, rotate: 0 }, { duration: 0 }));
    });

    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const pointer = { x: 0, y: 0, vx: 0, vy: 0 };
      stage.addEventListener('mousemove', (event) => {
        pointer.vx = event.clientX - pointer.x;
        pointer.vy = event.clientY - pointer.y;
        pointer.x = event.clientX;
        pointer.y = event.clientY;
      });

      stage.querySelectorAll<HTMLElement>('[data-outcome-label]').forEach((label) => {
        const target = label.querySelector<HTMLElement>('[data-outcome-push]')!;
        let body = restingBody();
        let frame = 0;
        let last = 0;

        const tick = (now: number) => {
          body = step(body, (now - last) / 1000);
          last = now;
          target.style.transform = transformOf(body);
          if (settled(body)) {
            body = restingBody();
            target.style.transform = '';
            frame = 0;
            return;
          }
          frame = requestAnimationFrame(tick);
        };

        label.addEventListener('mouseenter', (event) => {
          if (prefersReducedMotion()) return;
          const rect = target.getBoundingClientRect();
          body = kick(body, pointer, {
            x: event.clientX - (rect.left + rect.width / 2),
            y: event.clientY - (rect.top + rect.height / 2),
          });
          if (frame) return;
          last = performance.now();
          frame = requestAnimationFrame(tick);
        });
      });
    }
  }
</script>

<style>
  .one-outcomes {
    position: relative;
    z-index: 20;
    width: 100%;
    overflow: hidden;
    margin-top: calc(var(--edge-r) * -1);
    padding: var(--section-py) var(--gutter) calc(var(--section-py) * 0.65);
    border-radius: var(--edge-r);
    background: #fcf6ea;
    color: var(--midnight);
  }
  .one-outcomes-content { position: relative; z-index: 10; }
  .one-outcomes-heading {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 24);
    max-width: calc(var(--u) * 1280);
    margin: 0 auto calc(var(--u) * 24);
    text-align: center;
  }
  .one-outcomes-heading h2 { color: var(--midnight); }
  .one-outcomes-lead { max-width: calc(var(--u) * 640); margin-inline: auto; color: #525770; }
  .one-outcomes-note {
    display: inline-block;
    margin-inline: auto;
    color: var(--periwinkle-11);
    rotate: -1.6deg;
  }
  .one-outcomes-stage {
    position: relative;
    width: 100%;
    margin: calc(var(--u) * 24) auto 0;
    aspect-ratio: 402 / 860;
  }
  .one-outcomes-list { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .outcome-label {
    position: absolute;
    list-style: none;
    user-select: none;
    rotate: var(--rest-rotate);
    top: var(--rest-top);
    left: var(--rest-left, auto);
    right: var(--rest-right, auto);
  }
  .outcome-label:nth-child(6n + 1) { --rest-top: 0%; --rest-left: 0%; --rest-rotate: -5deg; --bg: #0a0c1a; --ink: #f4f6ff; }
  .outcome-label:nth-child(6n + 2) { --rest-top: 17%; --rest-right: 0%; --rest-rotate: 4deg; --bg: #f9c24d; --ink: #0a0c1a; }
  .outcome-label:nth-child(6n + 3) { --rest-top: 34%; --rest-left: 2%; --rest-rotate: -2.5deg; --bg: #8a8ef9; --ink: #0a0c1a; }
  .outcome-label:nth-child(6n + 4) { --rest-top: 50.5%; --rest-right: 1%; --rest-rotate: 4.5deg; --bg: #fff; --ink: #303163; }
  .outcome-label:nth-child(6n + 5) { --rest-top: 67.5%; --rest-left: 3%; --rest-rotate: -3.5deg; --bg: #303163; --ink: #f4f6ff; }
  .outcome-label:nth-child(6n + 6) { --rest-top: 84%; --rest-right: 2%; --rest-rotate: 3deg; --bg: #d2d7fc; --ink: #0a0c1a; }
  .outcome-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--label-py) var(--label-px);
    border-radius: var(--label-r);
    background: var(--bg);
    color: var(--ink);
  }
  .outcome-text {
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 700;
    line-height: 0.91;
    letter-spacing: -0.04em;
    text-align: center;
    text-wrap: balance;
    -webkit-text-stroke: 0.02em currentColor;
    paint-order: stroke fill;
  }

  @media (min-width: 768px) {
    .one-outcomes-stage { aspect-ratio: 834 / 720; }
  }
  @media (min-width: 1024px) {
    .one-outcomes-stage { margin-top: calc(var(--u) * 56); aspect-ratio: 1840 / 1080; }
    .outcome-text { max-width: none; white-space: nowrap; }
    .outcome-label:nth-child(6n + 1) { --rest-top: 1%; --rest-left: 4%; --rest-rotate: -4deg; }
    .outcome-label:nth-child(6n + 2) { --rest-top: 17%; --rest-right: 3%; --rest-rotate: 2.2deg; }
    .outcome-label:nth-child(6n + 3) { --rest-top: 34%; --rest-left: 5%; --rest-rotate: -2.2deg; }
    .outcome-label:nth-child(6n + 4) { --rest-top: 51%; --rest-right: 3%; --rest-rotate: 3.6deg; }
    .outcome-label:nth-child(6n + 5) { --rest-top: 68%; --rest-left: 6%; --rest-rotate: -3deg; }
    .outcome-label:nth-child(6n + 6) { --rest-top: 84%; --rest-right: 5%; --rest-rotate: 2.8deg; }
  }
</style>
