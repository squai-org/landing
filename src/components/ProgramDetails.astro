---
import { getSiteContent } from '../lib/content';
const { cohort, ui } = await getSiteContent();
---

<section id="programa" class="section tint">
  <div class="shell">
    <span class="program-status">
      <span class="program-status-dot" aria-hidden="true"></span>
      <span class="program-status-text">{cohort.status}</span>
      <span class="program-status-name">{cohort.name}</span>
    </span>
    <h2 class="display d-h1 program-title">{ui.program.title}</h2>

    <div class="bento program-grid">
      <div class="bento-card span-2 peri">
        <h3 class="display d-h3">{ui.program.duration}</h3>
        <p class="body">{cohort.duration}</p>
      </div>
      <div class="bento-card span-2 teal">
        <h3 class="display d-h3">{ui.program.schedule}</h3>
        <p class="body">{cohort.schedule}</p>
      </div>
      <div class="bento-card span-2 gold">
        <h3 class="display d-h3">{ui.program.modality}</h3>
        <p class="body">{cohort.modality}</p>
      </div>
    </div>

    <p class="lead program-seats">{cohort.seats}</p>
  </div>
</section>

<style>
  .program-status {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
  }
  .program-status-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--teal); }
  .program-status-text {
    flex: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }
  .program-status-name { min-width: 0; color: var(--ink-body); font-size: 14px; }
  .program-title { margin-top: clamp(20px, 2vw, 32px); color: var(--ink); }
  .program-grid { margin-top: clamp(36px, 4vw, 64px); }
  .program-seats { margin-top: clamp(24px, 2.6vw, 36px); color: var(--ink-body); }

  @media (max-width: 640px) {
    .program-status { flex-wrap: wrap; gap: 6px 10px; padding: 8px 16px; }
  }
</style>
