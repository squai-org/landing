---
import { Image } from 'astro:assets';
import BackdropShape from './BackdropShape.astro';
import Block from './Block.astro';
import Button from './Button.astro';
import { endpoints } from '../config/endpoints';
import { checkout } from '../config/checkout';
import { getSiteContent, type Service } from '../lib/content';
import { programStatusAttributes } from '../lib/program-status';
import persona from '../assets/one/persona-laptop.webp';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const hero = service.hero!;
const { program, ui } = await getSiteContent();
const statusAttributes = programStatusAttributes({ program, ui });
const cohortEndpoint = `${endpoints.checkoutProgram}/${checkout.program}`;
---

<section class="one-hero" data-hero aria-labelledby="one-hero-title" data-cohort-endpoint={cohortEndpoint}>
  <BackdropShape shape="hero" align="xMaxYMin" parallax={0.12} class="one-hero-backdrop" />

  <div class="one-hero-inner">
    <div class="one-hero-copy">
      <p class="one-hero-eyebrow">
        <span class="one-hero-eyebrow-dot" aria-hidden="true"></span>
        <span class="one-hero-eyebrow-status" {...statusAttributes} hidden>{program.status}</span>
        <span class="one-hero-eyebrow-name">{program.name}</span>
      </p>
      <h1 id="one-hero-title" class="display one-hero-title">{hero.title}</h1>
      <p class="one-hero-lead">{hero.lead}</p>
      <div class="one-hero-action">
        <Button variant="dark" arrow href={`#${service.cta.target}`} data-scroll-to={service.cta.target} class="one-hero-cta">{service.cta.label}</Button>
      </div>
      <dl class="one-hero-cohort">
        <div>
          <dt>{service.keyFacts!.labels.dates}</dt>
          <dd data-cohort-dates>{hero.datesPending}</dd>
        </div>
        <div>
          <dt>{service.keyFacts!.labels.schedule}</dt>
          <dd data-cohort-schedule>{hero.schedulePending}</dd>
        </div>
      </dl>
    </div>

    <div class="one-hero-stage">
      <span class="one-hero-arch" aria-hidden="true"></span>
      <div class="one-hero-person" data-parallax="0.05">
        <span class="one-hero-block" aria-hidden="true"><Block /></span>
        <Image
          src={persona}
          alt={hero.photoAlt}
          widths={[360, 540, 768]}
          sizes="(min-width: 1024px) 40vw, 80vw"
          loading="eager"
          fetchpriority="high"
          draggable="false"
          class="one-hero-photo"
        />
        <p class="one-hero-tag one-hero-tag-note" data-reveal="pop" data-reveal-delay="300">{hero.note}</p>
        <p class="one-hero-tag one-hero-tag-sticker" data-reveal="pop" data-reveal-delay="420">{hero.sticker}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { showProgramStatuses } from '../lib/program-status-client';
  import { showCohort } from '../lib/cohort-client';
  showProgramStatuses();
  void showCohort();
</script>

<style>
  .one-hero {
    --shape-1: var(--periwinkle-8);
    --shape-2: var(--periwinkle-7);
    --shape-1-opacity: .6;
    --shape-2-opacity: .5;
    position: relative;
    overflow: hidden;
    background: var(--periwinkle-9);
    color: var(--midnight);
    border-radius: 0 0 clamp(24px, 3vw, 56px) clamp(24px, 3vw, 56px);
    padding: calc(var(--nav-space) + clamp(12px, 3svh, 40px)) var(--gutter) 0;
  }
  .one-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    max-width: 1320px;
    margin: 0 auto;
  }
  .one-hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(16px, 2.4vw, 28px); }
  .one-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin: 0;
    padding: 9px 18px;
    background: var(--canvas);
    color: var(--midnight);
    border-radius: 24px;
    font-size: 14px;
  }
  .one-hero-eyebrow-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--teal-9); }
  .one-hero-eyebrow-status {
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .one-hero-title {
    margin: 0;
    max-width: 11ch;
    font-size: clamp(46px, 7.4vw, 124px);
    letter-spacing: -0.055em;
    line-height: .9;
    color: var(--midnight);
  }
  .one-hero-lead {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--midnight);
  }
  .one-hero-cohort {
    display: flex;
    flex-wrap: wrap;
    gap: 14px clamp(20px, 3vw, 44px);
    margin: clamp(4px, 1vw, 12px) 0 0;
    padding: 0;
  }
  .one-hero-cohort div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .one-hero-cohort dt {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .one-hero-cohort dd { margin: 0; font-weight: 700; font-size: 17px; line-height: 1.3; max-width: 26ch; }

  .one-hero-stage {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 320px;
    margin-top: clamp(24px, 5vw, 40px);
  }
  .one-hero-arch {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: min(78%, 420px);
    height: 78%;
    translate: -50% 0;
    border-radius: 999px 999px 0 0;
    background: var(--periwinkle-10);
  }
  .one-hero-person {
    position: relative;
    width: min(74vw, 340px);
    aspect-ratio: 768 / 1050;
    align-self: flex-end;
  }
  .one-hero-photo { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; }
  .one-hero-block {
    position: absolute;
    left: 60%;
    top: 4%;
    width: 42%;
    color: var(--gold-9);
    rotate: 14deg;
    z-index: 0;
  }
  .one-hero-tag {
    position: absolute;
    z-index: 2;
    width: max-content;
    max-width: 62%;
    margin: 0;
    padding: 9px 16px;
    background: var(--midnight);
    color: var(--canvas);
    font-family: var(--font-hand);
    font-size: 15px;
    line-height: 1.3;
    box-shadow: var(--shadow-float);
  }
  .one-hero-tag-note { left: -16%; top: 34%; border-radius: 18px; rotate: -4deg; }
  .one-hero-tag-sticker { left: -8%; top: 56%; border-radius: var(--radius-pill); rotate: 3deg; }

  @media (min-width: 768px) {
    .one-hero-person { width: min(52vw, 400px); }
    .one-hero-tag { font-size: 17px; padding: 10px 20px; }
    .one-hero-tag-note { left: -34%; top: 40%; }
    .one-hero-tag-sticker { left: -22%; top: 62%; }
  }

  @media (min-width: 1024px) {
    .one-hero { padding-top: calc(var(--nav-space) + clamp(16px, 4svh, 56px)); }
    .one-hero-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
      column-gap: clamp(24px, 3vw, 56px);
      align-items: end;
      min-height: min(760px, calc(100svh - var(--nav-space)));
    }
    .one-hero-copy { align-self: center; padding-bottom: clamp(32px, 4vw, 64px); }
    .one-hero-stage { margin-top: 0; min-height: 0; align-self: stretch; }
    .one-hero-person { width: min(100%, 460px); height: auto; max-height: 100%; }
    .one-hero-arch { width: min(92%, 500px); height: 66%; }
    .one-hero-tag { font-size: clamp(17px, 1.5vw, 22px); }
    .one-hero-tag-note { left: -30%; top: 52%; }
    .one-hero-tag-sticker { left: 52%; top: 70%; }
  }

  @media (max-width: 640px) {
    .one-hero { --nav-space: 84px; }
    .one-hero-cta { width: 100%; }
    .one-hero-title { max-width: 9ch; }
  }
</style>
