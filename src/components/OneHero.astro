---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import OneBackdrop from './OneBackdrop.astro';
import { endpoints } from '../config/endpoints';
import { checkout } from '../config/checkout';
import { getSiteContent, type Service } from '../lib/content';
import persona from '../assets/one/persona-laptop.webp';
import '../styles/one-sections.css';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const hero = service.hero!;
const cohortEndpoint = `${endpoints.checkoutProgram}/${checkout.program}`;
const { ui } = await getSiteContent();
---

<div class="one-hero-band one-u">
  <section class="one-hero" data-hero aria-labelledby="one-hero-title" data-cohort-endpoint={cohortEndpoint} data-cohort-from={ui.cohort.from} data-cohort-range={ui.cohort.range}>
    <OneBackdrop
      shape="hero"
      colors={['#969bfc', '#777ae3']}
      opacities={[0.45, 0.35]}
      align="xMaxYMin"
      small
      frameClass="one-hero-ribbon"
      scrollY={[0, 84]}
    />

    <div class="one-hero-copy">
      <h1 id="one-hero-title" class="one-h1 one-hero-title">{hero.title}</h1>
      <p class="one-hero-lead">{hero.lead}</p>
      <div class="one-hero-action">
        <Button variant="dark" arrow href={`#${service.cta.target}`} data-scroll-to={service.cta.target}>{hero.ctaLabel ?? service.cta.label}</Button>
      </div>
      <div class="one-hero-support">
        {
          hero.supportSchedule ? (
            <p class="one-small one-hero-schedule">{hero.supportSchedule}</p>
          ) : (
            <p class="one-small one-hero-schedule">
              <span data-cohort-schedule>{hero.schedulePending}</span> · <span data-cohort-dates>{hero.datesPending}</span>
            </p>
          )
        }
        {hero.supportOffer && <p class="one-small one-hero-offer">{hero.supportOffer}</p>}
      </div>
    </div>

    <div class="one-hero-stage">
      <div class="one-hero-person">
        <Image
          src={persona}
          alt={hero.photoAlt}
          widths={[360, 540, 768]}
          sizes="(min-width: 1024px) 34vw, 80vw"
          loading="eager"
          fetchpriority="high"
          draggable="false"
          class="one-hero-photo"
        />
        <div class="one-hero-tags">
          <p class="one-hero-tag one-hero-tag-note">{hero.note}</p>
          <p class="one-hero-tag one-hero-tag-sticker">{hero.sticker}</p>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { showCohort } from '../lib/cohort-client';

  void showCohort();
</script>

<style>
  .one-hero-band { background: #fff; }
  .one-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    background: var(--periwinkle-9);
    color: var(--midnight);
    border-radius: 0 0 var(--edge-r) var(--edge-r);
  }
  .one-hero :global(.one-hero-ribbon) {
    inset: -8% 0 -14% 0;
  }
  .one-hero-copy {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    padding: var(--hero-title-top) var(--gutter) 0 var(--hero-x);
  }
  .one-hero-title {
    max-width: var(--hero-title-w);
    line-height: 0.8;
    color: var(--midnight);
  }
  .one-hero-lead {
    max-width: var(--hero-p-w);
    margin: var(--hero-gap-title) 0 0;
    font-size: var(--hero-p-fs);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--midnight);
  }
  .one-hero-action {
    display: flex;
    align-items: center;
    column-gap: 1.25rem;
    margin-top: var(--hero-gap-cta);
  }
  .one-hero-support {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 6);
    max-width: min(100%, calc(var(--u) * 540));
    margin-top: calc(var(--u) * 14);
    color: var(--midnight);
  }
  .one-hero-schedule {
    margin: 0;
    font-weight: 700;
    color: var(--midnight);
  }
  .one-hero-offer {
    margin: 0;
    font-weight: 500;
    color: var(--midnight);
  }
  .one-hero-stage {
    position: relative;
    z-index: 10;
    flex: 1;
    width: 100%;
    min-height: 280px;
    margin-top: calc(var(--u) * 24);
  }
  .one-hero-person {
    position: absolute;
    bottom: 0;
    right: 12%;
    height: 96%;
    aspect-ratio: 768 / 1050;
  }
  .one-hero-photo {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
  }
  .one-hero-tags { display: contents; }
  .one-hero-tag {
    position: absolute;
    width: max-content;
    margin: 0;
    padding: calc(var(--u) * 9) calc(var(--u) * 14);
    background: var(--midnight);
    color: var(--canvas);
    border-radius: 18px;
    font-family: var(--font-hand);
    font-size: max(15px, var(--fs-tag));
    line-height: 1.375;
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  }
  .one-hero-tag-note { rotate: -4deg; }
  .one-hero-tag-sticker { rotate: 3deg; }

  @media (max-width: 1023px) {
    .one-hero {
      --hero-fit: max(100svh, 560px);
      height: 100svh;
      min-height: 560px;
    }
    .one-hero-copy {
      padding-top: calc(var(--header-pt) + var(--pill-h) + clamp(24px, calc(var(--hero-fit) * 0.04), 32px));
    }
    .one-hero-stage {
      flex: 1;
      min-height: 64px;
      container-type: size;
    }
    .one-hero-person {
      --photo-h: min(100cqh, calc(100cqw * 1050 / 768));
      --photo-w: calc(var(--photo-h) * 768 / 1050);
      --photo-right: max(0px, min(12cqw, 100cqw - var(--photo-w)));
      bottom: 0;
      right: var(--photo-right);
      height: var(--photo-h);
    }
    .one-hero-tags {
      position: absolute;
      top: calc(var(--photo-h) * 0.47);
      right: calc(var(--photo-w) * 0.45);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 12px;
      width: calc(100cqw - var(--photo-right) - var(--photo-w) * 0.45 - var(--hero-x) - 8px);
    }
    .one-hero-tag {
      position: static;
      max-width: 100%;
      white-space: normal;
    }
  }

  @media (max-width: 991px) {
    .one-hero {
      --hero-gap-title: calc(var(--u) * 16);
      --hero-gap-cta: calc(var(--u) * 16);
      --hero-p-fs: max(16px, calc(var(--u) * 18));
      --fs-small: max(16px, calc(var(--u) * 16));
      --fs-tag: max(15px, calc(var(--u) * 16));
      --btn-h: max(44px, calc(var(--u) * 48));
      --btn-fs: max(16px, calc(var(--u) * 17));
      --btn-px: calc(var(--u) * 14);
      --btn-r: calc(var(--u) * 8);
      --btn-icon: max(16px, calc(var(--u) * 20));
    }
  }

  @media (max-width: 767px) {
    .one-hero {
      --u: min(calc(100vw / 402), calc(var(--hero-fit) / 874));
      --fs-h1: calc(var(--u) * 52);
    }
  }

  @media (min-width: 768px) and (max-width: 991px) {
    .one-hero {
      --u: min(calc(100vw / 834), calc(var(--hero-fit) / 1194));
      --fs-h1: calc(var(--u) * 96);
    }
  }

  @container (max-height: 199px) {
    .one-hero-photo { display: none; }
    .one-hero-person {
      position: static;
      height: auto;
      aspect-ratio: auto;
    }
    .one-hero-tags {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      width: auto;
      padding: 0 var(--gutter) 0 var(--hero-x);
    }
  }

  @media (min-width: 640px) {
    .one-hero-tag-note {
      padding: calc(var(--u) * 10) calc(var(--u) * 16);
      border-radius: var(--tag-r);
    }
    .one-hero-tag-sticker {
      padding: calc(var(--u) * 12) calc(var(--u) * 22);
      border-radius: 9999px;
    }
  }

  @media (min-width: 1024px) {
    .one-hero {
      display: block;
      height: calc(var(--u) * 1100);
    }
    .one-hero-stage {
      position: absolute;
      top: 0;
      bottom: 0;
      right: calc(var(--u) * 190);
      width: calc(var(--u) * 640);
      min-height: 0;
      margin-top: 0;
    }
    .one-hero-person {
      right: auto;
      bottom: 0;
      left: 50%;
      height: calc(100% - var(--u) * 170);
      translate: -50%;
    }
    .one-hero-tag { font-size: calc(var(--u) * 28); white-space: nowrap; }
    .one-hero-tag-note { right: auto; left: -10%; top: 56%; }
    .one-hero-tag-sticker { right: auto; left: 59%; top: 70%; max-width: calc(var(--u) * 340); white-space: normal; text-wrap: balance; }
  }
</style>
