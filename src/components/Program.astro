---
import { weeks } from '../data/landing';
---

<div id="programa" class="section-pad" style="padding:80px 64px 0">
  <div style="max-width:1152px;margin:0 auto">
    <h2
      class="h2-title"
      style="margin:0;font-family:var(--font-display);font-weight:700;font-size:44px;line-height:1.02;letter-spacing:-0.045em;color:#0A0C1A"
    >
      El programa paso a paso
    </h2>
    <p style="margin:18px 0 0;font-size:17px;line-height:1.7;color:#4B5167;max-width:60ch;text-wrap:pretty">
      Cinco módulos que siguen el mismo recorrido de siempre: primero entiendes, después pruebas, y al final aterrizas
      algo tuyo.
    </p>

    <div class="program-card" style="margin-top:36px;background:#FFFFFF;border:1px solid #DCE1F0;border-radius:32px;padding:8px 40px">
      {
        weeks.map((w) => (
          <div
            class="grid-week"
            style={`display:grid;grid-template-columns:88px 1fr;gap:28px;align-items:start;padding:28px 0;border-top:${w.bt}`}
          >
            <div>
              <div style="font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#7A5A0C;margin-bottom:4px">
                Módulo
              </div>
              <div
                class="module-num"
                style="font-family:var(--font-display);font-weight:700;font-size:40px;letter-spacing:-0.05em;color:#8A8EF9;line-height:1"
              >
                {w.n}
              </div>
            </div>
            <div>
              <h3
                class="h3-title"
                style="margin:0 0 8px;font-family:var(--font-display);font-weight:700;font-size:24px;letter-spacing:-0.03em;color:#0A0C1A"
              >
                {w.t}
              </h3>
              <p style="margin:0;font-size:16px;line-height:1.65;color:#4B5167;max-width:62ch">{w.d}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
