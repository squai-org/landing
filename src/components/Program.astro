---
import { weeks } from '../data/landing';
---

<div id="programa" class="section-pad" style="background:#F4F6FF;border-radius:40px;padding:80px 64px">
  <div style="max-width:920px;margin:0 auto">
    <h2
      class="h2-title"
      style="margin:0 0 14px;font-family:'Urbanist',sans-serif;font-weight:900;font-size:46px;line-height:1.05;letter-spacing:-0.03em;color:#0D1B2A;text-align:center"
    >
      El programa paso a paso
    </h2>
    <p
      style="margin:0 auto 48px;text-align:center;font-size:17px;font-weight:300;line-height:1.6;color:#333;max-width:620px"
    >
      Cinco módulos diseñados para construir tus bases con claridad, de forma práctica y a tu propio ritmo.
    </p>
    <div
      class="program-card"
      style="background:#FFFFFF;border:1px solid rgba(13,27,42,.07);border-radius:28px;padding:12px 36px;box-shadow:0 1px 2px rgba(13,27,42,.03), 0 24px 60px -40px rgba(13,27,42,.35)"
    >
      {
        weeks.map((w) => (
          <div
            class="grid-week"
            style={`display:grid;grid-template-columns:92px 1fr;gap:28px;padding:30px 0;border-top:${w.bt};align-items:start`}
          >
            <div>
              <div style="font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#C49018;margin-bottom:4px">
                Módulo
              </div>
              <div class="module-num" style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:40px;letter-spacing:-0.04em;color:#5568EE;line-height:1">
                {w.n}
              </div>
            </div>
            <div>
              <h3 style="margin:0 0 8px;font-family:'Urbanist',sans-serif;font-weight:800;font-size:24px;letter-spacing:-0.015em;color:#0D1B2A">
                {w.t}
              </h3>
              <p style="margin:0;font-size:16px;font-weight:300;line-height:1.65;color:#333;max-width:620px">{w.d}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
