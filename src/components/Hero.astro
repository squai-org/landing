---
import { cohort, cohortMeta, heroStatement, heroSubtitle } from '../data/landing';
---

<!--
  Night hero. Always the same inset on every side until the visitor scrolls,
  so it reads as one full panel on any device. No imagery (Brand Book §14.6).
-->
<section class="hero">
  <div class="hero-inner">
    <a href="/servicios/squai-one" class="hero-eyebrow">
      <span class="hero-eyebrow-status">{cohort.status}</span>
      <span class="hero-eyebrow-text">{cohort.ecosystem} · {cohort.name}</span>
      <span class="hero-eyebrow-arrow" aria-hidden="true">→</span>
    </a>

    <h1 class="display d-display hero-title">
      {heroStatement[0]}<br /><span style="color:#8A8EF9">{heroStatement[1]}</span>
    </h1>

    <p class="hero-subtitle">{heroSubtitle}</p>

    <div class="hero-actions">
      <a
        href="/servicios/squai-one#lista"
        class="btn-gold-lift"
        style="display:inline-block;font-family:var(--font-body);font-size:17px;font-weight:700;color:#3B2B05;background:linear-gradient(180deg, #F7D96A 0%, #EFC13C 100%);border:0;border-radius:100px;padding:18px 36px;cursor:pointer;backdrop-filter:blur(8px);box-shadow:inset 0 1px 0 rgba(255,255,255,.95), inset 0 0 0 1px rgba(255,255,255,.55), 0 1px 2px rgba(13,27,42,.08), 0 8px 20px -8px rgba(13,27,42,.22)"
      >
        Reservar mi lugar
      </a>
      <a
        href="/#servicios"
        data-scroll-to="servicios"
        class="btn-ghost"
        style="display:inline-block;font-family:var(--font-body);font-size:17px;font-weight:700;color:#FFFFFF;background:linear-gradient(180deg, rgba(255,255,255,.26) 0%, rgba(255,255,255,.13) 100%);border:0;border-radius:100px;padding:18px 36px;cursor:pointer;backdrop-filter:blur(8px);box-shadow:inset 0 1px 0 rgba(255,255,255,.5), inset 0 0 0 1px rgba(255,255,255,.3), 0 8px 20px -10px rgba(13,27,42,.35)"
      >
        Ver servicios
      </a>
    </div>

    <p class="hero-meta">
      {
        cohortMeta.map((m, i) => (
          <>
            {i > 0 && <span class="hero-meta-sep" aria-hidden="true"> / </span>}
            <span style={`color:${m.color}`}>{m.text}</span>
          </>
        ))
      }
    </p>
  </div>

  <button type="button" data-scroll-to="statement" class="hero-scroll" aria-label="Bajar al contenido">
    Seguir bajando
    <span class="hero-scroll-icon" aria-hidden="true">↓</span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--midnight);
    border-radius: clamp(20px, 2vw, 36px);
    /* Equal inset on all four sides, whatever the viewport. */
    margin: var(--hero-inset);
    min-height: calc(100svh - var(--hero-inset) * 2);
    padding: calc(var(--nav-space) + var(--gutter) * 0.5) var(--gutter) calc(var(--gutter) * 1.2);
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--shell);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(14px, 1.6vw, 24px);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    padding: 9px 10px 9px 18px;
    background: rgba(244, 246, 255, .07);
    border: 1px solid rgba(244, 246, 255, .16);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background .2s, border-color .2s;
  }
  .hero-eyebrow:hover { background: rgba(244, 246, 255, .12); border-color: rgba(244, 246, 255, .3); }
  .hero-eyebrow-status {
    flex: none;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .hero-eyebrow-text { font-size: 13px; color: #D7DBEC; min-width: 0; }
  .hero-eyebrow-arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(244, 246, 255, .1);
    color: var(--canvas);
    font-size: 13px;
  }

  /* Bound by height as well as width so the panel always fits one screen. */
  .hero-title { color: var(--canvas); font-size: max(38px, min(10.8vw, 13.5svh)); }

  .hero-subtitle {
    margin: 0;
    max-width: 62ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: #B7BCD0;
    text-wrap: pretty;
  }

  .hero-actions { display: flex; gap: 14px; align-items: center; justify-content: center; flex-wrap: wrap; }

  .hero-meta {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(14px, 1.15vw, 18px);
    letter-spacing: -0.01em;
    line-height: 1.7;
  }
  .hero-meta-sep { color: #3A4058; }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: calc(var(--gutter) * 0.6);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px 11px 20px;
    backdrop-filter: blur(16px);
    border: 1px solid rgba(13, 27, 42, .07);
    border-radius: var(--radius-pill);
    box-shadow: 0 1px 2px rgba(13, 27, 42, .04), 0 14px 34px -22px rgba(13, 27, 42, .28);
    background-color: #FFFFFF77;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: transform .2s, background-color .2s;
  }
  .hero-scroll:hover { transform: translateX(-50%) translateY(2px); background-color: #FFFFFFAA; }
  .hero-scroll-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(13, 27, 42, .07);
    font-size: 14px;
    line-height: 1;
  }

  /* Short viewports: tighten so the panel still fits one screen exactly. */
  @media (max-height: 700px) {
    .hero-inner { gap: 10px; }
    .hero-title { font-size: max(28px, min(8.4vw, 11svh)); }
    .hero-subtitle { font-size: 14px; }
    .hero-meta { font-size: 13px; }
    .hero-actions a { padding: 13px 24px !important; font-size: 14px !important; }
  }

  @media (max-width: 639px) {
    .hero { --nav-space: 72px; }
    .hero-eyebrow { flex-wrap: wrap; justify-content: center; gap: 6px; padding: 10px 16px; }
    .hero-eyebrow-text { font-size: 12px; }
    .hero-eyebrow-arrow { display: none; }
    /* A wrapped line must not begin or end with a dangling separator. */
    .hero-meta-sep { display: none; }
    .hero-meta { display: flex; flex-direction: column; gap: 4px; }
    .hero-scroll { display: none; }
  }
</style>
