---
import { cohort, cohortMeta, heroStatement, heroSubtitle, tagline } from '../data/landing';
---

<!-- Night hero. Brand Book §14.6: statement first, no fake product UI. -->
<div
  class="hero-shell"
  style="position:relative;background:#0A0C1A;border-radius:36px;padding:190px 64px 96px;overflow:hidden;margin:0 12px;z-index:0"
>
  <!-- Modular field: Bloque + Unión, held back to a whisper so the text leads. -->
  <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:.5">
    <div style="position:absolute;right:-90px;top:120px;width:280px;height:280px;border-radius:96px;border:1px solid rgba(138,142,249,.22)"></div>
    <div style="position:absolute;right:150px;top:-60px;width:180px;height:180px;border-radius:64px;border:1px solid rgba(68,212,200,.16)"></div>
    <div style="position:absolute;left:-70px;bottom:-40px;width:220px;height:220px;border-radius:76px;border:1px solid rgba(249,194,77,.14)"></div>
  </div>

  <div style="position:relative;max-width:1120px;margin:0 auto;display:flex;flex-direction:column;align-items:flex-start;gap:26px">
    <!-- Eyebrow = the cohort that is open right now. -->
    <a
      href="/#cohorte"
      data-scroll-to="cohorte"
      class="hero-eyebrow"
      style="display:inline-flex;align-items:center;gap:12px;padding:9px 10px 9px 16px;background:rgba(244,246,255,.07);border:1px solid rgba(244,246,255,.16);border-radius:100px;text-decoration:none;max-width:100%"
    >
      <span style="display:inline-flex;align-items:center;gap:8px;flex:none">
        <span class="pulse-dot" style="width:8px;height:8px;border-radius:50%;flex:none;background:#44D4C8"></span>
        <span style="font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#44D4C8">
          {cohort.status}
        </span>
      </span>
      <span class="hero-eyebrow-text" style="font-size:13px;color:#D7DBEC;min-width:0">
        {cohort.ecosystem} · {cohort.name}
      </span>
      <span
        style="flex:none;display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;background:rgba(244,246,255,.1);color:#F4F6FF;font-size:13px"
        >→</span
      >
    </a>

    <h1
      class="hero-title"
      style="margin:0;font-family:var(--font-display);font-weight:700;font-size:88px;line-height:.92;letter-spacing:-0.055em;color:#F4F6FF;max-width:15ch;text-wrap:balance"
    >
      {heroStatement[0]}<br />{heroStatement[1]}<br /><span style="color:#8A8EF9">{heroStatement[2]}</span>
    </h1>

    <p class="hero-subtitle" style="margin:0;font-size:20px;line-height:1.6;color:#B7BCD0;max-width:62ch;text-wrap:pretty">
      {heroSubtitle}
    </p>

    <div class="hero-actions" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:8px">
      <a
        href="/#lista"
        data-scroll-to="lista"
        class="btn-gold-lift"
        style="display:inline-block;font-family:var(--font-display);font-size:17px;font-weight:700;letter-spacing:-0.01em;color:#0A0C1A;background:#F9C24D;border:0;border-radius:100px;padding:18px 34px;cursor:pointer;box-shadow:0 1px 2px rgba(10,12,26,.2), 0 10px 24px -12px rgba(249,194,77,.5)"
      >
        Reservar mi lugar
      </a>
      <a
        href="/#ecosistemas"
        data-scroll-to="ecosistemas"
        class="btn-ghost"
        style="display:inline-block;font-family:var(--font-display);font-size:17px;font-weight:700;letter-spacing:-0.01em;color:#F4F6FF;background:transparent;border:1px solid rgba(244,246,255,.28);border-radius:100px;padding:17px 32px;cursor:pointer"
      >
        Qué hacemos
      </a>
    </div>

    <div class="hero-meta" style="display:flex;flex-wrap:wrap;gap:8px 10px;margin-top:14px;font-size:13px;color:#8E94AC">
      {
        cohortMeta.map((m, i) => (
          <span style="display:inline-flex;align-items:center;gap:10px">
            {i > 0 && <span style="width:4px;height:4px;border-radius:50%;background:#3A4058"></span>}
            {m}
          </span>
        ))
      }
    </div>

    <p class="hand-note" style="margin:34px 0 0;font-family:var(--font-hand);font-size:21px;line-height:1.4;color:#8A8EF9;transform:rotate(-1.2deg)">
      {tagline}
    </p>
  </div>
</div>

<style>
  .hero-eyebrow { transition: background .2s, border-color .2s; }
  .hero-eyebrow:hover { background: rgba(244, 246, 255, .12); border-color: rgba(244, 246, 255, .3); }

  .pulse-dot { animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(68, 212, 200, .5); }
    60% { box-shadow: 0 0 0 7px rgba(68, 212, 200, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse-dot { animation: none; }
  }

  @media (max-width: 639px) {
    .hero-eyebrow { flex-wrap: wrap; gap: 8px; padding: 10px 14px !important; }
    .hero-eyebrow-text { font-size: 12px !important; }
  }
</style>
