---
import { cohort, cohortMeta, heroLines, heroSubtitle, heroVerbs } from '../data/landing';
---

<!--
  Night hero. Always the same inset on every side until the visitor scrolls,
  so it reads as one full panel on any device. No imagery (Brand Book §14.6).
-->
<section class="hero" data-hero>
  <div class="hero-inner">
    <a href="/servicios/squai-one" class="hero-eyebrow">
      <span class="hero-dot" aria-hidden="true"></span>
      <span class="hero-eyebrow-status">{cohort.status}</span>
      <span class="hero-eyebrow-text">{cohort.ecosystem} · {cohort.name}</span>
    </a>

    <h1 class="hero-title">
      <span class="hero-line-1">
        <span class="hero-verb" data-hero-verb style={`color:${heroVerbs[0].color}`}>{heroVerbs[0].word}</span>
        {' '}{heroLines.object}
      </span>
      <span class="hero-line-2">{heroLines.middle}</span>
      <span class="hero-line-3">{heroLines.last}</span>
    </h1>

    <p class="hero-subtitle">{heroSubtitle}</p>

    <div class="hero-actions">
      <a
        href="/servicios/squai-one#lista"
        class="btn-gold-lift"
        style="display:inline-block;font-family:var(--font-body);font-size:17px;font-weight:700;color:#3B2B05;background:linear-gradient(180deg, #F7D96A 0%, #EFC13C 100%);border:0;border-radius:100px;padding:18px 36px;cursor:pointer;backdrop-filter:blur(8px);box-shadow:inset 0 1px 0 rgba(255,255,255,.95), inset 0 0 0 1px rgba(255,255,255,.55), 0 1px 2px rgba(13,27,42,.08), 0 8px 20px -8px rgba(13,27,42,.22)"
      >
        Reservar mi lugar
      </a>
      <a
        href="/#servicios"
        data-scroll-to="servicios"
        class="btn-ghost"
        style="display:inline-block;font-family:var(--font-body);font-size:17px;font-weight:700;color:#FFFFFF;background:linear-gradient(180deg, rgba(255,255,255,.26) 0%, rgba(255,255,255,.13) 100%);border:0;border-radius:100px;padding:18px 36px;cursor:pointer;backdrop-filter:blur(8px);box-shadow:inset 0 1px 0 rgba(255,255,255,.5), inset 0 0 0 1px rgba(255,255,255,.3), 0 8px 20px -10px rgba(13,27,42,.35)"
      >
        Ver servicios
      </a>
    </div>

    <p class="hero-meta">
      {
        cohortMeta.map((m, i) => (
          <>
            {i > 0 && <span class="hero-meta-sep" aria-hidden="true"> / </span>}
            <span style={`color:${m.color}`}>{m.text}</span>
          </>
        ))
      }
    </p>
  </div>

  <button type="button" data-scroll-to="statement" class="hero-scroll">
    <span class="hero-dot" aria-hidden="true"></span>
    Seguir bajando
  </button>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--midnight);
    border-radius: clamp(20px, 2vw, 36px);
    /* Equal inset on all four sides, whatever the viewport. */
    margin: var(--hero-inset);
    min-height: calc(100svh - var(--hero-inset) * 2);
    padding: calc(var(--nav-space) + var(--gutter) * 0.4) var(--gutter) calc(var(--gutter) * 2.2);
    overflow: hidden;
  }

  .hero-inner {
    max-width: var(--shell);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(14px, 1.6vw, 24px);
  }

  /* One dot shape for the eyebrow and the scroll cue, no stock glyphs. */
  .hero-dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--gold);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 9px 20px;
    background: rgba(244, 246, 255, .92);
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background .2s, transform .2s;
  }
  .hero-eyebrow:hover { background: #FFFFFF; transform: translateY(-1px); }
  .hero-eyebrow-status {
    flex: none;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }
  .hero-eyebrow-text { font-size: 13px; color: var(--ink-body); min-width: 0; }

  .hero-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--canvas);
  }
  .hero-line-1,
  .hero-line-3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.94;
    font-size: max(34px, min(9.6vw, 12svh));
  }
  /* The middle line steps down into the reading face on purpose. */
  .hero-line-2 {
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: -0.01em;
    line-height: 1.15;
    font-size: max(18px, min(4.2vw, 5.4svh));
    color: #B7BCD0;
  }
  .hero-verb { transition: opacity .28s ease, color .28s ease; }
  .hero-verb.is-out { opacity: 0; }

  .hero-subtitle {
    margin: 0;
    max-width: 52ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: #B7BCD0;
    text-wrap: pretty;
  }

  .hero-actions { display: flex; gap: 14px; align-items: center; justify-content: center; flex-wrap: wrap; }

  .hero-meta {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(14px, 1.15vw, 18px);
    letter-spacing: -0.01em;
    line-height: 1.7;
  }
  .hero-meta-sep { color: #3A4058; }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: calc(var(--gutter) * 0.6);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
    background: rgba(244, 246, 255, .92);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: transform .2s, background-color .2s;
  }
  .hero-scroll:hover { transform: translateX(-50%) translateY(2px); background-color: #FFFFFF; }

  /* Short viewports: tighten so the panel still fits one screen exactly. */
  @media (max-height: 700px) {
    .hero-inner { gap: 10px; }
    .hero-line-1, .hero-line-3 { font-size: max(26px, min(7.6vw, 10svh)); }
    .hero-line-2 { font-size: max(16px, min(3.4vw, 4.6svh)); }
    .hero-subtitle { font-size: 14px; }
    .hero-meta { font-size: 13px; }
    .hero-actions a { padding: 13px 24px !important; font-size: 14px !important; }
  }

  @media (max-width: 639px) {
    .hero { --nav-space: 76px; }
    .hero-eyebrow { flex-wrap: wrap; justify-content: center; gap: 6px 10px; padding: 10px 16px; }
    .hero-eyebrow-text { font-size: 12px; }
    .hero-meta-sep { display: none; }
    .hero-meta { display: flex; flex-direction: column; gap: 4px; }
    .hero-scroll { display: none; }
  }
</style>

<script>
  import { heroVerbs } from '../data/landing';

  const verb = document.querySelector<HTMLElement>('[data-hero-verb]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (verb && !reduced && heroVerbs.length > 1) {
    let i = 0;
    setInterval(() => {
      verb.classList.add('is-out');
      window.setTimeout(() => {
        i = (i + 1) % heroVerbs.length;
        verb.textContent = heroVerbs[i].word;
        verb.style.color = heroVerbs[i].color;
        verb.classList.remove('is-out');
      }, 280);
    }, 2600);
  }
</script>
