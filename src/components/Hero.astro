---
import Button from './Button.astro';
import { getSiteContent } from '../lib/content';
const { cohort, heroLines, heroSubtitle, heroVerbs, ui, labels } = await getSiteContent();
---

<!--
  Night hero. Always the same inset on every side until the visitor scrolls,
  so it reads as one full panel on any device. No imagery (Brand Book §14.6).
-->
<section class="hero" data-hero data-hero-copy={JSON.stringify({ verbs: heroVerbs, ...ui.hero })}>
  <img class="brand-shape hero-shape hero-shape-gold" src="/images/shape-hero-gold.svg" alt="" aria-hidden="true" />
  <img class="brand-shape hero-shape hero-shape-periwinkle" src="/images/shape-hero-periwinkle.svg" alt="" aria-hidden="true" />

  <div class="hero-inner">
    <div class="hero-eyebrow-row">
      <button
        type="button"
        class="hero-animation-toggle"
        data-hero-animation-toggle
        aria-label={ui.hero.pause}
        aria-pressed="false"
        title={ui.hero.pause}
      >
        <svg class="hero-animation-icon hero-animation-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M7 5h3v14H7V5Zm7 0h3v14h-3V5Z" />
        </svg>
        <svg class="hero-animation-icon hero-animation-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7L8 5Z" />
        </svg>
      </button>
      <a href="/servicios/squai-one" class="hero-eyebrow">
        <span class="hero-dot" aria-hidden="true"></span>
        <span class="hero-eyebrow-status">{cohort.status}</span>
        <span class="hero-eyebrow-text">{cohort.name}</span>
      </a>
    </div>

    <h1 class="hero-title">
      <span class="hero-line">
        <span class="hero-animated-word">
          <span class="hero-verb" data-hero-verb aria-live="off" style={`color:${heroVerbs[0].color}`}>{heroVerbs[0].word}</span><span
            class="hero-caret"
            data-hero-caret
            aria-hidden="true"></span>
        </span>
        {' '}{heroLines.object}
      </span>
      <span class="hero-line hero-line-mid">{heroLines.middle}</span>
      <span class="hero-line hero-line-last">{heroLines.last}</span>
    </h1>

    <p class="hero-subtitle">{heroSubtitle}</p>

    <div class="hero-actions">
      <Button variant="primary" href="/servicios/squai-one#lista">{labels.reserve}</Button>
      <Button variant="white" href="/#servicios" data-scroll-to="servicios">{ui.hero.services}</Button>
    </div>

  </div>

  <button type="button" data-scroll-to="statement" class="hero-scroll" data-hero-scroll>
    <span class="scroll-mouse" aria-hidden="true">
      <span class="scroll-wheel"></span>
    </span>
    <span class="scroll-label">{ui.hero.scroll}</span>
  </button>
</section>

<style>
  .hero {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--midnight);
    border-radius: clamp(20px, 2vw, 36px);
    /* Equal inset on all four sides, whatever the viewport. */
    margin: var(--hero-inset);
    min-height: calc(100svh - var(--hero-inset) * 2);
    padding: calc(var(--nav-space) + clamp(6px, 2svh, 44px)) var(--gutter) clamp(18px, 7svh, 110px);
    overflow: hidden;
  }

  .hero-shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }
  /* cqw (% of .hero's own width), not plain % (of .hero's height for top)
     and not fixed px. Unlike the other sections' brand-shape, .hero's
     height is set by 100svh — independent of its width — so a plain
     top:% (relative to height) grew or shrank against the shape's
     width-based size whenever the window's aspect ratio changed, not
     only on resize/zoom: short windows swallowed the headline under the
     gold shape, wide-short ones shrank the periwinkle to nearly nothing.
     Driving every value off cqw keeps position and size locked to the
     same axis, so the shape can't warp independently of its own width. */
  .hero-shape-gold {
    width: 62.64cqw;
    height: auto;
    left: -26.15cqw;
    top: -27.14cqw;
    transform: rotate(-60deg);
  }
  .hero-shape-periwinkle {
    width: 92.97cqw;
    height: auto;
    left: 85.88cqw;
    top: -15.16cqw;
    transform: rotate(-22.64deg);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: var(--shell);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(6px, 1.7svh, 24px);
  }

  /* One dot shape for the eyebrow and the scroll cue, no stock glyphs. */
  .hero-dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--teal);
  }

  .hero-eyebrow {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 10px 22px;
    background: rgba(244, 246, 255, .92);
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background .2s, transform .2s;
  }
  .hero-eyebrow-row {
    display: flex;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .hero-eyebrow:hover { background: #FFFFFF; transform: translateY(-1px); }
  .hero-eyebrow-status {
    flex: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }
  .hero-eyebrow-text { font-size: 14px; color: var(--ink-body); min-width: 0; }

  .hero-title { margin: 0; display: flex; flex-direction: column; align-items: center; color: var(--canvas); }
  .hero-line {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.94;
    font-size: clamp(40px, 9.6vw, 150px);
  }
  /* The middle line keeps the reading face at the same size. */
  /* Four pixels shy of the display lines so it reads as a step down. */
  .hero-line-mid {
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: -0.02em;
    font-size: clamp(36px, calc(9.6vw - 4px), 146px);
  }
  .hero-line-last { color: #F4F6FF; }

  .hero-animated-word { white-space: nowrap; }

  /* The verb is typed in and out rather than cross-faded. */
  .hero-caret {
    display: inline-block;
    width: .06em;
    height: .72em;
    margin-left: .04em;
    vertical-align: baseline;
    background: currentColor;
    color: var(--teal);
    animation: caret 1s steps(1, end) infinite;
  }
  @keyframes caret { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .hero-subtitle {
    margin: 0;
    max-width: 52ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: #B7BCD0;
    text-wrap: pretty;
  }

  .hero-animation-toggle {
    display: inline-flex;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(244, 246, 255, .28);
    border-radius: 50%;
    background: rgba(244, 246, 255, .08);
    color: var(--canvas);
    cursor: pointer;
  }
  .hero-animation-toggle:hover { background: rgba(244, 246, 255, .1); }
  .hero-animation-toggle:focus-visible { outline: 3px solid var(--periwinkle); outline-offset: 3px; }
  .hero-animation-icon { display: block; }
  .hero-animation-icon-play { display: none; }
  .hero-animation-toggle[aria-pressed="true"] .hero-animation-icon-pause { display: none; }
  .hero-animation-toggle[aria-pressed="true"] .hero-animation-icon-play { display: block; }
  .hero.animation-paused .hero-caret { animation-play-state: paused; }

  .hero-actions { display: flex; gap: 14px; align-items: stretch; justify-content: center; flex-wrap: wrap; }

  .hero-scroll {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: clamp(12px, 2.2svh, 24px);
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 118px;
    min-height: 76px;
    padding: 8px 16px 7px;
    border: 0;
    background: transparent;
    color: var(--canvas);
    font-family: var(--font-body);
    cursor: pointer;
    transition: transform .2s;
  }
  .hero-scroll:hover {
    transform: translateX(-50%) translateY(3px);
    background: transparent;
    color: var(--canvas);
  }
  .hero-scroll:hover .scroll-wheel { background: var(--gold); }
  .hero-scroll:hover .scroll-label { color: var(--canvas); }
  .hero-scroll { transition: transform .2s, opacity .3s, visibility .3s; }
  .hero-scroll.is-hidden { opacity: 0; visibility: hidden; }

  .scroll-mouse {
    position: relative;
    display: block;
    width: 26px;
    height: 42px;
    border: 2px solid rgba(244, 246, 255, .72);
    border-radius: 999px;
    animation: scrollMouseNudge 2.8s ease-out infinite, scrollMouseColor 5.6s linear infinite;
  }
  .scroll-wheel {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 4px;
    height: 8px;
    border-radius: 999px;
    background: var(--teal);
    transform: translateX(-50%);
    animation: scrollWheel 2.8s ease-out infinite;
  }
  .scroll-label {
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(244, 246, 255, .82);
    animation: scrollLabelNudge 2.8s ease-out infinite;
  }

  @keyframes scrollWheel {
    0%, 12% { opacity: 1; transform: translate(-50%, 0) scale(1); }
    42% { opacity: 0; transform: translate(-50%, 17px) scale(.55); }
    43%, 58% { opacity: 0; transform: translate(-50%, 0) scale(.55); }
    72%, 100% { opacity: 1; transform: translate(-50%, 0) scale(1); }
  }
  @keyframes scrollMouseNudge {
    0%, 12%, 55%, 100% { transform: translateY(0); }
    35% { transform: translateY(4px); }
  }
  @keyframes scrollLabelNudge {
    0%, 12%, 55%, 100% { transform: translateY(0); }
    35% { transform: translateY(2px); }
  }
  @keyframes scrollMouseColor {
    0%, 100% { border-color: rgba(244, 246, 255, .72); }
    33% { border-color: var(--teal); }
    66% { border-color: var(--periwinkle); }
  }

  /* The cue needs room of its own; on short screens it goes. */
  @media (max-height: 720px) {
    .hero-scroll { display: none; }
    .hero-subtitle { max-width: 42ch; }
  }

  /* Responsive (tablet and phone): a smaller eyebrow, a bigger headline, and
     the duration/format pills are dropped — the subtitle already says it. */
  @media (max-width: 1023px) {
    .hero-eyebrow { padding: 8px 18px; gap: 10px; }
    .hero-eyebrow-status, .hero-eyebrow-text { font-size: 13px; }
    .hero-line { font-size: clamp(46px, 11.5vw, 96px); }
    .hero-line-mid { font-size: clamp(42px, calc(11.5vw - 4px), 92px); }
  }

  @media (max-width: 640px) {
    .hero { --nav-space: 84px; }
    /* Lift the headline further so it outweighs the actions under it. */
    .hero-line { font-size: clamp(50px, 16vw, 78px); }
    .hero-line-mid { font-size: clamp(46px, calc(16vw - 4px), 74px); }
    .hero-eyebrow { flex-wrap: wrap; justify-content: center; gap: 6px 10px; padding: 8px 16px; }
    .hero-scroll { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-mouse,
    .scroll-wheel,
    .scroll-label { animation: none; }
  }
</style>

<script>
  import type { HeroClientCopy } from '../lib/content';
  const heroCopy: HeroClientCopy = JSON.parse(document.querySelector<HTMLElement>('[data-hero-copy]')!.dataset.heroCopy!);
  const heroVerbs = heroCopy.verbs;

  const verb = document.querySelector<HTMLElement>('[data-hero-verb]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-animation-toggle]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (verb && heroVerbs.length > 1) {
    if (reduced) {
      document.querySelector('[data-hero-caret]')?.remove();
      if (toggle) toggle.hidden = true;
    } else {
      const TYPE = 70;
      const ERASE = 45;
      const HOLD = 2200;
      let index = 0;
      let paused = false;

      toggle?.addEventListener('click', () => {
        paused = !paused;
        toggle.setAttribute('aria-pressed', String(paused));
        const label = paused ? heroCopy.resume : heroCopy.pause;
        toggle.setAttribute('aria-label', label);
        toggle.title = label;
        hero?.classList.toggle('animation-paused', paused);
      });

      const wait = (ms: number) =>
        new Promise<void>((done) => {
          let remaining = ms;
          let previous = performance.now();
          const step = (now: number) => {
            if (!paused) remaining -= now - previous;
            previous = now;
            if (remaining <= 0) done();
            else requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });

      const run = async () => {
        // Keep the longest word reserved so the line never reflows mid-type.
        for (;;) {
          await wait(HOLD);
          const current = heroVerbs[index].word;
          for (let i = current.length; i >= 0; i--) {
            verb.textContent = current.slice(0, i);
            await wait(ERASE);
          }
          index = (index + 1) % heroVerbs.length;
          const next = heroVerbs[index];
          verb.style.color = next.color;
          for (let i = 1; i <= next.word.length; i++) {
            verb.textContent = next.word.slice(0, i);
            await wait(TYPE);
          }
        }
      };

      run();
    }
  }
</script>
