---
import Button from './Button.astro';
import { cohort, cohortMeta, heroLines, heroSubtitle, heroVerbs } from '../data/landing';
---

<!--
  Night hero. Always the same inset on every side until the visitor scrolls,
  so it reads as one full panel on any device. No imagery (Brand Book §14.6).
-->
<section class="hero" data-hero>
  <div class="hero-inner">
    <a href="/servicios/squai-one" class="hero-eyebrow">
      <span class="hero-dot" aria-hidden="true"></span>
      <span class="hero-eyebrow-status">{cohort.status}</span>
      <span class="hero-eyebrow-text">{cohort.name}</span>
    </a>

    <h1 class="hero-title">
      <span class="hero-line">
        <span class="hero-verb" data-hero-verb style={`color:${heroVerbs[0].color}`}>{heroVerbs[0].word}</span><span
          class="hero-caret"
          data-hero-caret
          aria-hidden="true"></span>
        {' '}{heroLines.object}
      </span>
      <span class="hero-line hero-line-mid">{heroLines.middle}</span>
      <span class="hero-line hero-line-last">{heroLines.last}</span>
    </h1>

    <p class="hero-subtitle">{heroSubtitle}</p>

    <div class="hero-actions">
      <Button variant="gold" href="/servicios/squai-one#lista">Reservar mi lugar</Button>
      <Button variant="white" href="/#servicios" data-scroll-to="servicios">Ver servicios</Button>
    </div>

    <p class="hero-meta">
      {
        cohortMeta.map((m, i) => (
          <>
            {i > 0 && <span class="hero-meta-sep" aria-hidden="true"> / </span>}
            <span style={`color:${m.color}`}>{m.text}</span>
          </>
        ))
      }
    </p>
  </div>

  <button type="button" data-scroll-to="statement" class="hero-scroll" data-hero-scroll>
    <span class="hero-dot" aria-hidden="true"></span>
    Seguir bajando
  </button>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--midnight);
    border-radius: clamp(20px, 2vw, 36px);
    /* Equal inset on all four sides, whatever the viewport. */
    margin: var(--hero-inset);
    min-height: calc(100svh - var(--hero-inset) * 2);
    padding: calc(var(--nav-space) + clamp(6px, 2svh, 44px)) var(--gutter) clamp(18px, 7svh, 110px);
  }

  .hero-inner {
    max-width: var(--shell);
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(6px, 1.7svh, 24px);
  }

  /* One dot shape for the eyebrow and the scroll cue, no stock glyphs. */
  .hero-dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--teal);
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 10px 22px;
    background: rgba(244, 246, 255, .92);
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background .2s, transform .2s;
  }
  .hero-eyebrow:hover { background: #FFFFFF; transform: translateY(-1px); }
  .hero-eyebrow-status {
    flex: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }
  .hero-eyebrow-text { font-size: 14px; color: var(--ink-body); min-width: 0; }

  .hero-title { margin: 0; display: flex; flex-direction: column; align-items: center; color: var(--canvas); }
  .hero-line {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.94;
    font-size: clamp(40px, 9.6vw, 150px);
  }
  /* The middle line keeps the reading face at the same size. */
  /* Four pixels shy of the display lines so it reads as a step down. */
  .hero-line-mid {
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: -0.02em;
    font-size: clamp(36px, calc(9.6vw - 4px), 146px);
  }
  .hero-line-last { color: var(--periwinkle); }

  /* The verb is typed in and out rather than cross-faded. */
  .hero-caret {
    display: inline-block;
    width: .06em;
    height: .72em;
    margin-left: .04em;
    vertical-align: baseline;
    background: currentColor;
    color: var(--teal);
    animation: caret 1s steps(1, end) infinite;
  }
  @keyframes caret { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0; } }

  .hero-subtitle {
    margin: 0;
    max-width: 52ch;
    font-size: var(--t-lead);
    line-height: 1.5;
    color: #B7BCD0;
    text-wrap: pretty;
  }

  .hero-actions { display: flex; gap: 14px; align-items: stretch; justify-content: center; flex-wrap: wrap; }

  .hero-meta {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.25vw, 20px);
    letter-spacing: -0.01em;
    line-height: 1.7;
  }
  .hero-meta-sep { color: #3A4058; }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: calc(var(--gutter) * 0.6);
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
    background: rgba(244, 246, 255, .92);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    transition: transform .2s, background-color .2s;
  }
  .hero-scroll:hover { transform: translateX(-50%) translateY(2px); background-color: #FFFFFF; }
  .hero-scroll { transition: transform .2s, background-color .2s, opacity .3s, visibility .3s; }
  .hero-scroll.is-hidden { opacity: 0; visibility: hidden; }

  /* The cue needs room of its own; on short screens it goes. */
  @media (max-height: 720px) {
    .hero-scroll { display: none; }
    .hero-subtitle { max-width: 42ch; }
  }

  @media (max-width: 640px) {
    .hero { --nav-space: 84px; }
    /* Lift the headline so it outweighs the actions under it. */
    .hero-line { font-size: clamp(42px, 13vw, 66px); }
    .hero-line-mid { font-size: clamp(38px, calc(13vw - 4px), 62px); }
    .hero-eyebrow { flex-wrap: wrap; justify-content: center; gap: 6px 10px; padding: 10px 16px; }
    .hero-meta-sep { display: none; }
    /* Wrapped row rather than a stacked column: same legibility, less height. */
    .hero-meta { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; }
    .hero-scroll { display: none; }
  }
</style>

<script>
  import { heroVerbs } from '../data/landing';

  const verb = document.querySelector<HTMLElement>('[data-hero-verb]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (verb && heroVerbs.length > 1) {
    if (reduced) {
      document.querySelector('[data-hero-caret]')?.remove();
    } else {
      const TYPE = 70;
      const ERASE = 45;
      const HOLD = 2200;
      let index = 0;

      const wait = (ms: number) => new Promise((done) => window.setTimeout(done, ms));

      const run = async () => {
        // Keep the longest word reserved so the line never reflows mid-type.
        for (;;) {
          await wait(HOLD);
          const current = heroVerbs[index].word;
          for (let i = current.length; i >= 0; i--) {
            verb.textContent = current.slice(0, i);
            await wait(ERASE);
          }
          index = (index + 1) % heroVerbs.length;
          const next = heroVerbs[index];
          verb.style.color = next.color;
          for (let i = 1; i <= next.word.length; i++) {
            verb.textContent = next.word.slice(0, i);
            await wait(TYPE);
          }
        }
      };

      run();
    }
  }
</script>
