---
import Outcomes from './Outcomes.astro';
import Program from './Program.astro';
import Includes from './Includes.astro';
import { cohort } from '../data/landing';

const facts = [
  { k: 'Ecosistema', v: cohort.ecosystem },
  { k: 'Duración', v: cohort.duration },
  { k: 'Clases en vivo', v: cohort.schedule },
  { k: 'Modalidad', v: cohort.modality },
  { k: 'Cupos', v: cohort.seats },
];
---

<div id="cohorte" style="display:flex;flex-direction:column">
  <!-- Cohort header: the one thing on this page with a date-shaped urgency. -->
  <div class="section-pad" style="background:#0A0C1A;border-radius:40px;padding:72px 64px">
    <div class="cohort-head" style="max-width:1152px;margin:0 auto;display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:start">
      <div>
        <div style="display:inline-flex;align-items:center;gap:9px;padding:8px 16px;border:1px solid rgba(68,212,200,.35);border-radius:100px;margin-bottom:22px">
          <span style="width:8px;height:8px;border-radius:50%;background:#44D4C8"></span>
          <span class="eyebrow eyebrow-night">{cohort.status}</span>
        </div>
        <h2
          class="h2-title-lg"
          style="margin:0;font-family:var(--font-display);font-weight:700;font-size:52px;line-height:1;letter-spacing:-0.05em;color:#F4F6FF;text-wrap:balance"
        >
          {cohort.name}
        </h2>
        <p style="margin:20px 0 0;font-size:18px;line-height:1.7;color:#B7BCD0;max-width:58ch;text-wrap:pretty">
          El punto de entrada de Squai One. Cinco semanas para dejar de adivinar cómo funciona la IA y empezar a usarla
          con criterio propio en lo que ya haces todos los días.
        </p>
        <a
          href="/#lista"
          data-scroll-to="lista"
          class="btn-gold-lift"
          style="display:inline-block;margin-top:32px;font-family:var(--font-display);font-size:17px;font-weight:700;letter-spacing:-0.01em;color:#0A0C1A;background:#F9C24D;border:0;border-radius:100px;padding:18px 34px;cursor:pointer"
        >
          Reservar mi lugar
        </a>
      </div>
      <div style="background:#12162A;border:1px solid #2C314D;border-radius:28px;padding:12px 26px">
        {
          facts.map((f, i) => (
            <div style={`display:flex;flex-direction:column;gap:4px;padding:18px 0;${i > 0 ? 'border-top:1px solid #2C314D' : ''}`}>
              <span style="font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#8E94AC">{f.k}</span>
              <span style="font-size:15px;line-height:1.5;color:#F4F6FF">{f.v}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <Outcomes />
  <Program />
  <Includes />
</div>
