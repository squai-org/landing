---
import { outcomes } from '../data/landing';
---

<div class="section-pad" style="padding:80px 64px 0">
  <div class="grid-sidebar" style="max-width:1152px;margin:0 auto;display:grid;grid-template-columns:0.85fr 1.15fr;gap:72px;align-items:start">
    <div class="sidebar-sticky" style="position:sticky;top:120px">
      <div class="eyebrow" style="margin-bottom:18px">Al terminar</div>
      <h2
        class="h2-title"
        style="margin:0;font-family:var(--font-display);font-weight:700;font-size:44px;line-height:1.02;letter-spacing:-0.045em;color:#0A0C1A;text-wrap:balance"
      >
        Qué vas a lograr
      </h2>
      <p style="margin:18px 0 0;font-size:17px;line-height:1.7;color:#4B5167;max-width:44ch;text-wrap:pretty">
        No promesas de que la IA lo hará todo por ti. Cinco capacidades concretas que vas a poder usar el lunes
        siguiente.
      </p>
    </div>
    <div style="display:flex;flex-direction:column">
      {
        outcomes.map((o, i) => (
          <div
            class="grid-outcome-row"
            style={`display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:start;padding:26px 0;${i > 0 ? 'border-top:1px solid #DCE1F0' : ''}`}
          >
            <span
              style={`flex:none;width:44px;height:44px;border-radius:14px;background:${o.bg};color:${o.fg};display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:700;font-size:18px`}
            >
              {o.n}
            </span>
            <div>
              <h3
                class="h3-title"
                style="margin:0 0 8px;font-family:var(--font-display);font-weight:700;font-size:22px;line-height:1.2;letter-spacing:-0.025em;color:#0A0C1A"
              >
                {o.t}
              </h3>
              <p style="margin:0;font-size:16px;line-height:1.65;color:#4B5167;max-width:60ch">{o.d}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
