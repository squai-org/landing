---
import Badge from './Badge.astro';
import { includes, programIncludes } from '../data/landing';
---

<div class="section-pad" style="padding:80px 64px 0">
  <div style="max-width:1152px;margin:0 auto">
    <div class="grid-sidebar" style="display:grid;grid-template-columns:1.25fr 0.75fr;gap:56px;align-items:start">
      <div>
        <h2
          class="h2-title"
          style="margin:0 0 12px;font-family:'Urbanist',sans-serif;font-weight:900;font-size:44px;line-height:1.05;letter-spacing:-0.03em;color:#0D1B2A"
        >
          Qué incluye el programa
        </h2>
        <p style="margin:0 0 32px;font-size:17px;font-weight:300;line-height:1.6;color:#333;max-width:560px">
          Todo lo que necesitas para aprender de forma práctica, con interacción directa y recursos listos para aplicar.
        </p>
        <div class="grid-6" style="display:grid;grid-template-columns:repeat(6,1fr);gap:16px">
          {
            programIncludes.map((pi) => (
              <div
                class="span-item"
                style={`grid-column: ${pi.span}; border-radius: 24px; padding: 26px 26px 28px; display: flex; flex-direction: column; gap: 12px; background-color: #FFFFFF`}
              >
                <span style="width:30px;height:30px;border-radius:10px;background:#44D4C8;color:#0D1B2A;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px">
                  ✓
                </span>
                <div style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:18px;letter-spacing:-0.01em;color:#0D1B2A">
                  {pi.t}
                </div>
                <div style="font-size:14px;font-weight:300;line-height:1.6;color:#333">{pi.d}</div>
              </div>
            ))
          }
        </div>
      </div>
      <div
        id="precio"
        class="sidebar-sticky card-pad-lg"
        style="position:sticky;top:120px;background:#FFFFFF;border:1px solid rgba(13,27,42,.07);border-radius:32px;padding:34px;box-shadow:0 1px 2px rgba(13,27,42,.03), 0 30px 70px -40px rgba(13,27,42,.45)"
      >
        <Badge audience="personas">Inversión</Badge>
        <div
          class="price-amount"
          style="font-family:'Urbanist',sans-serif;font-weight:900;font-size:44px;letter-spacing:-0.035em;color:#0D1B2A;margin-top:16px;line-height:1"
        >
          $399.000 COP
        </div>
        <div style="font-size:15px;font-weight:400;color:#666;margin:6px 0 18px">/ $129 USD</div>
        <div
          style="font-size:13px;font-weight:400;line-height:1.55;color:#3D50CC;background:#F4F6FF;border-radius:12px;padding:12px 14px;margin-bottom:26px"
        >
          Los cupos de cada cohorte se asignan desde la lista de espera. Reserva tu lugar y te escribimos cuando se abra
          la inscripción.
        </div>
        <div
          style="font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#666;margin-bottom:14px"
        >
          Incluye:
        </div>
        <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:28px">
          {
            includes.map((inc) => (
              <div style="display:flex;gap:10px;align-items:flex-start;font-size:14px;font-weight:400;line-height:1.55;color:#333">
                <span style="color:#127B74;font-weight:700">✓</span>
                {inc}
              </div>
            ))
          }
        </div>
        <button
          data-scroll-to="lista"
          class="btn-dark"
          style="width:100%;font-family:'Outfit',sans-serif;font-size:17px;font-weight:700;color:#FFFFFF;background:#0D0D0D;border:0;border-radius:100px;padding:18px 24px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.75), inset 0 0 0 1px rgba(255,255,255,.35), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(196,144,24,.6)"
        >
          Reservar mi lugar
        </button>
      </div>
    </div>
    <div
      class="cert-banner"
      style="margin-top:24px;background:#C8F4F0;border-radius:32px;padding:34px 40px;display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center"
    >
      <div
        style="width:58px;height:58px;border-radius:18px;background:#F2C94C;display:flex;align-items:center;justify-content:center;color:#8A6A10;flex:none"
      >
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="8" r="6"></circle>
          <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
        </svg>
      </div>
      <div>
        <div
          style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:21px;line-height:1.25;letter-spacing:-0.01em;color:#0D1B2A;margin-bottom:8px"
        >
          Certificado que respalda lo que aprendiste
        </div>
        <div style="font-size:16px;font-weight:300;line-height:1.6;color:#333;max-width:820px">
          Al terminar el programa recibes un certificado que valida tu aprendizaje. Puedes compartirlo en tu LinkedIn
          para que tu red vea que ya dominas los fundamentos de IA generativa.
        </div>
      </div>
    </div>
  </div>
</div>
