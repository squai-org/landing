---
import { faqs } from '../data/landing';
---

<div id="faq" style="padding:80px 64px">
  <div style="max-width:880px;margin:0 auto">
    <h2
      style="margin:0 0 44px;font-family:'Urbanist',sans-serif;font-weight:900;font-size:46px;line-height:1.05;letter-spacing:-0.03em;color:#0D1B2A;text-align:center"
    >
      Preguntas frecuentes
    </h2>
    <div style="border-top:1px solid rgba(13,27,42,.1)">
      {
        faqs.map((f, i) => (
          <div style="border-bottom:1px solid rgba(13,27,42,.1)">
            <div
              data-faq-toggle={i}
              style="display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center;padding:26px 4px;cursor:pointer"
            >
              <div style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:20px;letter-spacing:-0.01em;color:#0D1B2A">
                {f.q}
              </div>
              <span
                data-faq-sign={i}
                style="width:32px;height:32px;border-radius:50%;background:#F4F6FF;color:#3D50CC;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:600;flex:none"
              >
                +
              </span>
            </div>
            <div
              data-faq-panel={i}
              hidden
              style="padding:0 60px 28px 4px;font-size:16px;font-weight:300;line-height:1.7;color:#333"
            >
              {f.a}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
