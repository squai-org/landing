---
/**
 * Inscripcion a Squai One: formulario de registro y, al enviarlo, el Boton de
 * pagos de Bold en modo embebido (data-render-mode="embedded"), que abre el
 * pago en un modal sobre la misma pagina.
 *
 * El orden importa y no es cosmetico. Primero el formulario: al enviarlo, el
 * Worker guarda la inscripcion en estado pendiente y devuelve el data-order-id
 * ya firmado. Ese identificador es lo unico que liga el pago de Bold con la
 * persona; sin el, una venta solo se podria cruzar por el correo que el
 * comprador escriba dentro de Bold.
 *
 * El monto no se decide aqui: viene de la sesion que firma el Worker, que a su
 * vez lo lee de la base. Lo que se muestra y lo que se cobra son el mismo dato.
 * https://developers.bold.co/pagos-en-linea/boton-de-pagos/integracion-manual/integracion-manual
 */
import Button from './Button.astro';
import CountryCodeSelect from './CountryCodeSelect.astro';
import CustomSelect from './CustomSelect.astro';
import Turnstile from './Turnstile.astro';
import { checkout } from '../config/checkout';
import { endpoints } from '../config/endpoints';
import { getSiteContent } from '../lib/content';

const { program, ui, labels } = await getSiteContent();
---

<section class="section tint">
  <div id="lista" class="shell">
    <div class="bento checkout-grid">
      <div class="checkout-column span-4 row-5">
        <div class="checkout-sticky">
          <h2 class="display d-h2 checkout-title">{ui.checkout.title}</h2>
          <div class="checkout-copy">
            {
              ui.checkout.copy.map((paragraph, index) => (
                <p class={`lead${index === ui.checkout.copy.length - 1 ? ' checkout-promise' : ''}`}>{paragraph}</p>
              ))
            }
          </div>

          <div
            class="checkout-card card-pad-lg"
            data-bold-checkout
            data-plan={checkout.plan}
            data-plan-endpoint={endpoints.checkoutPlan}
            data-library-url={checkout.libraryUrl}
            data-return-path={checkout.returnPath}
            data-button-style={checkout.buttonStyle}
          >
            <div class="checkout-card-heading">
              <h3 class="display checkout-card-title">{ui.checkout.formTitle}</h3>
              <p class="body checkout-card-subtitle">{ui.checkout.formSubtitle}</p>
            </div>

            <form data-form="checkout" data-endpoint={endpoints.checkoutSession} novalidate>
              <input type="hidden" name="plan" value={checkout.plan} />
              <p class="form-instructions"><span aria-hidden="true">*</span> {ui.forms.required}</p>

              <div class="field-grid-2">
                <label class="field-group" for="checkout-full-name">
                  <span class="field-label">{ui.forms.fullName} <span aria-hidden="true">*</span></span>
                  <input id="checkout-full-name" type="text" name="full_name" required autocomplete="name" class="field" aria-describedby="checkout-full-name-error" />
                  <span id="checkout-full-name-error" class="field-error" data-field-error="full_name"></span>
                </label>
                <label class="field-group" for="checkout-email">
                  <span class="field-label">{ui.forms.email} <span aria-hidden="true">*</span></span>
                  <input id="checkout-email" type="email" name="email" required autocomplete="email" class="field" aria-describedby="checkout-email-error" />
                  <span id="checkout-email-error" class="field-error" data-field-error="email"></span>
                </label>
              </div>

              <div class="field-grid-phone">
                <CountryCodeSelect idPrefix="checkout" label={ui.forms.countryCode} />
                <label class="field-group" for="checkout-phone">
                  <span class="field-label">{ui.forms.phone} <span aria-hidden="true">*</span></span>
                  <input id="checkout-phone" type="tel" name="phone" required autocomplete="tel-national" inputmode="tel" class="field" aria-describedby="checkout-phone-error" />
                  <span id="checkout-phone-error" class="field-error" data-field-error="phone"></span>
                </label>
              </div>

              <div class="field-group-spaced">
                <CustomSelect
                  idPrefix="checkout"
                  name="referral_source"
                  label={ui.forms.referralSourceProgram}
                  placeholder={ui.forms.select}
                  options={ui.forms.referralSources}
                />
              </div>

              <Turnstile action="checkout" />

              <label class="field-group consent-field" for="checkout-privacy-consent">
                <span class="consent-row">
                  <input id="checkout-privacy-consent" type="checkbox" name="privacy_consent" required class="consent-checkbox" aria-describedby="checkout-privacy-consent-error" />
                  <span class="consent-label">
                    {ui.forms.privacyConsentPrefix}<a href="/politica-de-privacidad" target="_blank" rel="noopener">{ui.forms.privacyConsentLink}</a>{ui.forms.privacyConsentSuffix}
                  </span>
                </span>
                <span id="checkout-privacy-consent-error" class="field-error" data-field-error="privacy_consent"></span>
              </label>

              <div class="form-submit">
                <Button variant="primary" type="submit" block>{labels.reserve}</Button>
              </div>

              <div class="form-status" data-form-status role="status" aria-live="polite"></div>
            </form>

            <!-- Bold pinta su boton aqui cuando la inscripcion queda guardada. -->
            <div class="checkout-button" data-bold-mount hidden></div>
          </div>
        </div>
      </div>

      <div class="bento-card span-2 row-2 investment-card">
        <span class="service-eyebrow investment-eyebrow">
          <span class="service-eyebrow-dot" aria-hidden="true"></span>
          <span class="service-eyebrow-text">{ui.checkout.investment.eyebrow}</span>
        </span>
        {ui.checkout.investment.copy.map((paragraph) => <p class="body investment-copy">{paragraph}</p>)}
        <div class="investment-price">
          <h3 class="display">
            <span data-bold-price>&nbsp;</span> <span data-bold-currency>&nbsp;</span>
          </h3>
          <p class="body">{ui.checkout.investment.referencePrice}</p>
        </div>
      </div>
      <div class="bento-card span-2 peri program-detail-card">
        <h3 class="display d-h3">{ui.program.duration}</h3>
        <p class="body">{program.duration}</p>
      </div>
      <div class="bento-card span-2 teal program-detail-card">
        <h3 class="display d-h3">{ui.program.schedule}</h3>
        <p class="body">{program.schedule}</p>
      </div>
      <div class="bento-card span-2 gold program-detail-card">
        <h3 class="display d-h3">{ui.program.modality}</h3>
        <p class="body">{program.modality}</p>
      </div>
    </div>
  </div>
</section>

<script>
  interface CheckoutSession {
    apiKey: string;
    orderId: string;
    amount: number;
    currency: string;
    description: string;
    integritySignature: string;
  }

  const root = document.querySelector<HTMLElement>('[data-bold-checkout]');

  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-form="checkout"]');
    const mount = root.querySelector<HTMLElement>('[data-bold-mount]');
    const priceSlot = document.querySelector<HTMLElement>('[data-bold-price]');
    const currencySlot = document.querySelector<HTMLElement>('[data-bold-currency]');

    /** Bold cobra enteros sin decimales, asi que no se formatean centavos. */
    const showPrice = (amount: number, currency: string) => {
      if (priceSlot) priceSlot.textContent = `$${new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 }).format(amount)}`;
      if (currencySlot) currencySlot.textContent = currency;
    };

    const loadPrice = async () => {
      try {
        const res = await fetch(`${root.dataset.planEndpoint}/${root.dataset.plan}`, {
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) return;
        const { plan } = (await res.json()) as { plan: { amount: number; currency: string } };
        showPrice(plan.amount, plan.currency);
      } catch {
        // El precio tambien viaja en la sesion: si esto falla, se pinta al pagar.
      }
    };

    /**
     * El orden importa: primero se inserta el <script data-bold-button>, y solo
     * despues la libreria. La libreria busca ese tag cuando carga, asi que si
     * llegara antes no encontraria nada que pintar.
     */
    const renderButton = (session: CheckoutSession) => {
      if (!mount || mount.dataset.rendered) return;

      const button = document.createElement('script');
      button.setAttribute('data-bold-button', root.dataset.buttonStyle ?? 'dark-L');
      button.setAttribute('data-render-mode', 'embedded');
      button.setAttribute('data-api-key', session.apiKey);
      button.setAttribute('data-order-id', session.orderId);
      button.setAttribute('data-amount', String(session.amount));
      button.setAttribute('data-currency', session.currency);
      button.setAttribute('data-integrity-signature', session.integritySignature);
      button.setAttribute('data-description', session.description);
      button.setAttribute('data-redirection-url', `${window.location.origin}${root.dataset.returnPath ?? '/'}`);

      // Prellena el formulario de Bold con lo que la persona ya escribio.
      const data = new FormData(form!);
      button.setAttribute(
        'data-customer-data',
        JSON.stringify({
          fullName: String(data.get('full_name') ?? ''),
          email: String(data.get('email') ?? ''),
          phone: String(data.get('phone') ?? '').replace(/\D/g, ''),
          dialCode: String(data.get('country_code') ?? ''),
        })
      );

      mount.appendChild(button);
      mount.hidden = false;
      mount.dataset.rendered = 'true';

      const library = document.createElement('script');
      library.src = root.dataset.libraryUrl ?? '';
      library.async = true;
      document.head.appendChild(library);

      mount.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    // El Layout envia este evento cuando /api/checkout/session responde bien.
    document.addEventListener('squai:checkout-session', (event) => {
      const session = (event as CustomEvent<CheckoutSession>).detail;
      showPrice(session.amount, session.currency);
      renderButton(session);
    });

    void loadPrice();
  }
</script>

<style>
  .checkout-grid { align-items: stretch; }
  .row-5 { grid-row: span 5; }
  .checkout-column { display: flex; flex-direction: column; min-width: 0; }
  .checkout-sticky { position: sticky; top: calc(var(--nav-space) + 24px); }
  .checkout-title { color: var(--ink); }
  .checkout-copy {
    max-width: 60ch;
    margin: clamp(16px, 1.6vw, 24px) 0 clamp(28px, 3vw, 44px);
    color: var(--ink-body);
  }
  .checkout-copy p + p { margin-top: 12px; }
  /* --periwinkle (#8A8EF9) sobre --canvas da 2.66:1; WCAG 2.2 AA exige 4.5:1
     para texto normal. --periwinkle-ink da 5.65:1. */
  .checkout-promise { font-family: var(--font-hand); font-weight: 100; color: var(--periwinkle-ink); }
  .program-detail-card { gap: 8px; padding: clamp(20px, 1.8vw, 30px); }
  .program-detail-card h3 { font-size: clamp(19px, 1.55vw, 27px); }
  .program-detail-card p { font-size: clamp(16px, .95vw, 18px); }
  .investment-card {
    justify-content: space-between;
    min-height: clamp(320px, 30vw, 460px);
    background: var(--midnight);
    border-color: transparent;
  }
  .investment-eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 12px;
    padding: 10px 22px;
    background: var(--canvas);
    border: 1px solid var(--canvas);
    border-radius: var(--radius-pill);
  }
  .service-eyebrow-dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--periwinkle);
  }
  .service-eyebrow-text {
    color: var(--midnight);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .investment-price { display: flex; flex-direction: column; gap: 8px; }
  .investment-price h3 {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .18em;
    width: 100%;
    font-size: clamp(30px, 2.65vw, 50px);
    white-space: nowrap;
  }
  .investment-card .investment-price h3,
  .investment-card .investment-price p,
  .investment-copy { color: var(--canvas); }
  .investment-copy { max-width: 32ch; }
  .checkout-card {
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 32px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(10, 12, 26, .03), 0 30px 70px -44px rgba(10, 12, 26, .45);
    text-align: left;
  }
  .checkout-card-heading { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .checkout-card-title { color: var(--midnight); font-size: clamp(19px, 1.55vw, 27px); }
  .checkout-card-subtitle { color: var(--midnight); }
  .consent-field { gap: 7px; margin: 4px 0 18px; }
  .consent-row { display: flex; align-items: flex-start; gap: 10px; }
  .consent-checkbox {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--periwinkle);
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .consent-label { font-size: 14px; line-height: 1.4; color: var(--ink-body); }
  .consent-label a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .consent-label a:hover { color: var(--periwinkle-ink); }
  .checkout-button {
    display: flex;
    align-items: center;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 1100px) {
    .checkout-column { order: -1; }
    .row-5, .investment-card { grid-row: auto; }
    .checkout-sticky { position: static; }
  }
  @media (max-width: 640px) {
    .checkout-card { padding: 22px; border-radius: 22px; }
  }
  @media (max-width: 400px) {
    .field { padding-inline: 14px; }
  }
</style>
