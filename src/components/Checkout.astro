---
/**
 * Inscripcion a Squai One: formulario de registro y, al enviarlo, un boton del
 * sitio que abre el pago de Bold en un modal sobre la misma pagina
 * (integracion personalizada, renderMode "embedded").
 *
 * El orden importa y no es cosmetico. Primero el formulario: al enviarlo, el
 * Worker guarda la inscripcion en estado pendiente y devuelve el data-order-id
 * ya firmado. Ese identificador es lo unico que liga el pago de Bold con la
 * persona; sin el, una venta solo se podria cruzar por el correo que el
 * comprador escriba dentro de Bold.
 *
 * El monto no se decide aqui: viene de la sesion que firma el Worker, que a su
 * vez lo lee de la base. Lo que se muestra y lo que se cobra son el mismo dato.
 * https://developers.bold.co/pagos-en-linea/boton-de-pagos/integracion-manual/integracion-personalizada
 */
import OneBackdrop from './OneBackdrop.astro';
import Button from './Button.astro';
import CountryCodeSelect from './CountryCodeSelect.astro';
import CustomSelect from './CustomSelect.astro';
import Turnstile from './Turnstile.astro';
import { checkout, CURRENCIES, type Currency } from '../config/checkout';
import { endpoints } from '../config/endpoints';
import { legalPaths } from '../config/legal';
import { getSiteContent } from '../lib/content';
import { fillTemplate } from '../lib/template';
import '../styles/one-sections.css';

interface Props {
  investment?: { referencePrice: Partial<Record<Currency, number>>; discountPercent?: number; discountDeadline?: string };
}

const { investment } = Astro.props;
const { ui, labels } = await getSiteContent();
const referencePrices = investment?.referencePrice ?? {};
const hasReference = Object.values(referencePrices).some((amount) => amount !== undefined);
const discountText = investment?.discountPercent ? fillTemplate(ui.checkout.investment.discountLabel, { percent: String(investment.discountPercent) }) : '';
const deadlineText = investment?.discountDeadline ? fillTemplate(ui.checkout.investment.deadlineLabel, { date: investment.discountDeadline }) : '';
const currencyLabels: Record<Currency, string> = { COP: ui.checkout.currency.cop, USD: ui.checkout.currency.usd };
---

<section id="inscripcion" class="one-signup one-u" aria-labelledby="one-signup-title">
  <OneBackdrop shape="signup" colors={['#fdebc9']} opacities={[0.68]} align="xMidYMid" />
  <div class="one-signup-grid">
    <div class="checkout-column" data-signup-enter="intro">
      <h2 id="one-signup-title" class="one-h2">{ui.checkout.title}</h2>
      <div class="checkout-copy">
        {ui.checkout.copy.map((paragraph) => <p class="one-lead">{paragraph}</p>)}
      </div>

      <fieldset class="currency-picker" data-currency-picker>
        <legend class="one-signup-label">{ui.checkout.currency.label}</legend>
        <div class="currency-options">
          {
            CURRENCIES.map((currency, index) => (
              <label class="currency-option" data-currency-option={currency}>
                <input type="radio" name="currency" value={currency} form="checkout-form" checked={index === 0} />
                <span>{currencyLabels[currency]}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="investment-price">
        <div class="price-row">
          <span class="one-small price-label">{ui.checkout.investment.eyebrow}</span>
          <p class="one-h3 price-line">
            <span class="price-amount" data-bold-price data-state="loading"></span> <span class="price-currency" data-bold-currency></span>
          </p>
        </div>
        {
          hasReference && (
            <div class="reference-offer" data-reference-offer data-reference-prices={JSON.stringify(referencePrices)} hidden>
              <s class="reference-price">
                <span class="sr-only">{ui.checkout.investment.referenceLabel}: </span>
                <span data-reference-amount />
              </s>
              {discountText && <span class="discount-badge">{discountText}</span>}
              {deadlineText && <span class="one-small discount-deadline">{deadlineText}</span>}
            </div>
          )
        }
        {
          ui.checkout.investment.copy.map((paragraph, index) => (
            <p class={index === 0 ? 'price-note' : 'one-small price-detail'}>{paragraph}</p>
          ))
        }
        <div class="payment-methods">
          <p class="one-small price-detail" id="payment-methods-label">{ui.checkout.paymentMethods.label}</p>
          <ul class="payment-list" aria-labelledby="payment-methods-label">
            {ui.checkout.paymentMethods.items.map((method) => <li class="one-small">{method}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="checkout-form-column" data-signup-enter="form">
      <div
        class="checkout-card"
        data-bold-checkout
        data-program={checkout.program}
        data-program-endpoint={endpoints.checkoutProgram}
        data-library-url={checkout.libraryUrl}
        data-return-path={checkout.returnPath}
        data-status-endpoint={endpoints.checkoutStatus}
        data-paying-label={ui.checkout.button.paying}
        data-retry-label={ui.checkout.button.retry}
      >
        <div class="checkout-card-heading">
          <h3 class="one-h3">{ui.checkout.formTitle}</h3>
          <p class="one-small checkout-card-subtitle">{ui.checkout.formSubtitle}</p>
        </div>

        <form id="checkout-form" data-form="checkout" data-endpoint={endpoints.checkoutSession} novalidate>
          <input type="hidden" name="program" value={checkout.program} />
          <p class="form-instructions"><span aria-hidden="true">*</span> {ui.forms.required}</p>

          <label class="field-group" for="checkout-full-name">
            <span class="field-label">{ui.forms.fullName} <span aria-hidden="true">*</span></span>
            <input id="checkout-full-name" type="text" name="full_name" required autocomplete="name" class="field" aria-describedby="checkout-full-name-error" />
            <span id="checkout-full-name-error" role="alert" class="field-error" data-field-error="full_name"></span>
          </label>

          <div class="one-signup-row">
            <label class="field-group" for="checkout-email">
              <span class="field-label">{ui.forms.email} <span aria-hidden="true">*</span></span>
              <input id="checkout-email" type="email" name="email" required autocomplete="email" class="field" aria-describedby="checkout-email-error" />
              <span id="checkout-email-error" role="alert" class="field-error" data-field-error="email"></span>
            </label>
            <div class="one-signup-phone">
              <CountryCodeSelect idPrefix="checkout" label={ui.forms.countryCode} />
              <label class="field-group" for="checkout-phone">
                <span class="field-label">{ui.forms.phone} <span aria-hidden="true">*</span></span>
                <input id="checkout-phone" type="tel" name="phone" required autocomplete="tel-national" inputmode="tel" class="field" aria-describedby="checkout-phone-error" />
                <span id="checkout-phone-error" role="alert" class="field-error" data-field-error="phone"></span>
              </label>
            </div>
          </div>

          <CustomSelect
            idPrefix="checkout"
            name="referral_source"
            label={ui.forms.referralSourceProgram}
            placeholder={ui.forms.select}
            options={ui.forms.referralSources}
          />

          <Turnstile action="checkout" />

          <label class="field-group consent-field" for="checkout-terms-consent">
            <span class="consent-row">
              <input id="checkout-terms-consent" type="checkbox" name="terms_consent" required class="consent-checkbox" aria-describedby="checkout-terms-consent-error" />
              <span class="consent-label">
                {ui.forms.termsConsentPrefix}<a href={legalPaths.terms} target="_blank" rel="noopener">{ui.forms.termsConsentLink}</a>{ui.forms.termsConsentSuffix}
              </span>
            </span>
            <span id="checkout-terms-consent-error" role="alert" class="field-error" data-field-error="terms_consent"></span>
          </label>

          <label class="field-group consent-field" for="checkout-privacy-consent">
            <span class="consent-row">
              <input id="checkout-privacy-consent" type="checkbox" name="privacy_consent" required class="consent-checkbox" aria-describedby="checkout-privacy-consent-error" />
              <span class="consent-label">
                {ui.forms.privacyConsentPrefix}<a href={legalPaths.privacy} target="_blank" rel="noopener">{ui.forms.privacyConsentLink}</a>{ui.forms.privacyConsentSuffix}
              </span>
            </span>
            <span id="checkout-privacy-consent-error" role="alert" class="field-error" data-field-error="privacy_consent"></span>
          </label>

          <div class="form-submit" data-sales-panel="form">
            <Button variant="primary" type="submit" block arrow>{labels.reserve}</Button>
          </div>

          <div class="sales-notice" data-sales-panel="upcoming" hidden>
            <p class="sales-notice-title">{ui.checkout.status.upcomingTitle}</p>
            <p class="one-small">{ui.checkout.status.upcomingBody}</p>
          </div>
          <div class="sales-notice" data-sales-panel="closed" hidden>
            <p class="sales-notice-title">{ui.checkout.status.closedTitle}</p>
            <p class="one-small">{ui.checkout.status.closedBody}</p>
          </div>

          <div class="form-status" data-form-status role="status" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { revealOnView, tweens } from '../lib/motion';

  const intro = document.querySelector<HTMLElement>('[data-signup-enter="intro"]');
  const formColumn = document.querySelector<HTMLElement>('[data-signup-enter="form"]');
  if (intro) revealOnView(intro, { opacity: 0, y: 24 }, { opacity: 1, y: 0 }, tweens.formReveal, 0.25);
  if (formColumn) revealOnView(formColumn, { opacity: 0, y: 28 }, { opacity: 1, y: 0 }, tweens.formCardReveal, 0.2);
</script>

<script>
  import { openBoldCheckout } from '../lib/bold-library';
  import { fetchProgram } from '../lib/program-client';
  import { type CheckoutSession, type CustomerData } from '../lib/bold-checkout';
  import { discountedReference } from '../lib/reference-price';
  import {
    buttonView,
    canReopen,
    enrolledUrl,
    nextPhase,
    rejectionAction,
    salesPanel,
    type FlowEvent,
    type Phase,
    type SalesPanel,
  } from '../lib/checkout-flow';
  import type { ClientCopy } from '../lib/content';

  // Las cadenas llegan por data-client-copy, como el resto del JS de cliente.
  const { feedback } = JSON.parse(document.body.dataset.clientCopy!) as ClientCopy;

  const root = document.querySelector<HTMLElement>('[data-bold-checkout]');

  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-form="checkout"]');
    const priceSlot = document.querySelector<HTMLElement>('[data-bold-price]');
    const currencySlot = document.querySelector<HTMLElement>('[data-bold-currency]');

    /** Bold cobra enteros sin decimales, asi que no se formatean centavos. */
    const formatAmount = (amount: number) => `$${new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 }).format(amount)}`;

    const showPrice = (amount: number, currency: string) => {
      if (priceSlot) {
        priceSlot.textContent = formatAmount(amount);
        priceSlot.dataset.state = 'ready';
      }
      if (currencySlot) currencySlot.textContent = currency;
    };

    const markPriceUnavailable = () => {
      if (!priceSlot || priceSlot.dataset.state === 'ready') return;
      priceSlot.textContent = '—';
      priceSlot.dataset.state = 'error';
    };

    const referenceOffer = document.querySelector<HTMLElement>('[data-reference-offer]');
    const referenceAmountSlot = referenceOffer?.querySelector<HTMLElement>('[data-reference-amount]') ?? null;
    const referencePrices: Partial<Record<string, number>> = JSON.parse(referenceOffer?.dataset.referencePrices ?? '{}');

    const currencyInputs = Array.from(
      document.querySelectorAll<HTMLInputElement>('[data-currency-picker] input[name="currency"]')
    );
    let prices: Partial<Record<string, number>> = {};

    const selectedCurrency = () => currencyInputs.find((input) => input.checked)?.value ?? '';

    const showReference = (currency: string) => {
      if (!referenceOffer) return;
      const listed = discountedReference(referencePrices, prices, currency);
      referenceOffer.hidden = listed === undefined;
      if (listed !== undefined && referenceAmountSlot) referenceAmountSlot.textContent = formatAmount(listed);
    };

    const showSelectedPrice = () => {
      const currency = selectedCurrency();
      const amount = prices[currency];
      if (amount !== undefined) showPrice(amount, currency);
      showReference(currency);
    };

    const loadPrice = async () => {
      try {
        const program = await fetchProgram(`${root.dataset.programEndpoint}/${root.dataset.program}`);
        if (!program) {
          markPriceUnavailable();
          return;
        }
        showSalesPanel(salesPanel(program.status));
        prices = program.prices ?? {};
        currencyInputs.forEach((input) => {
          const available = prices[input.value] !== undefined;
          input.disabled = !available;
          input.closest<HTMLElement>('[data-currency-option]')!.hidden = !available;
          input.checked = input.value === program.defaultCurrency;
        });
        showSelectedPrice();
      } catch {
        markPriceUnavailable();
      }
    };

    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;
    const labelNode = submit?.querySelector<HTMLElement>('.btn-label') ?? null;
    const statusNode = root.querySelector<HTMLElement>('[data-form-status]');
    const boldOrigin = new URL(root.dataset.libraryUrl ?? '', window.location.origin).origin;

    // Un solo boton conduce todo el flujo: cambia de estilo y de texto segun la
    // fase (src/lib/checkout-flow.ts) en vez de aparecer un segundo boton.
    const labels = {
      reserve: labelNode?.textContent ?? '',
      paying: root.dataset.payingLabel ?? '',
      retry: root.dataset.retryLabel ?? '',
    };
    let phase: Phase = 'idle';
    let current: { session: CheckoutSession; customer: CustomerData } | null = null;
    let panel: SalesPanel = 'form';

    const consentBox = (name: string) => form?.querySelector<HTMLInputElement>(`input[name="${name}"]`) ?? null;
    const termsBox = consentBox('terms_consent');
    const privacyBox = consentBox('privacy_consent');
    const isConsentBox = (target: EventTarget | null) => target === termsBox || target === privacyBox;

    const render = () => {
      if (!submit || !form) return;
      if (panel !== 'form') {
        form.dataset.checkoutPhase = panel;
        submit.disabled = true;
        return;
      }
      const view = buttonView(phase, { terms: Boolean(termsBox?.checked), privacy: Boolean(privacyBox?.checked) });
      submit.classList.toggle('btn-primary', view.variant === 'primary');
      submit.classList.toggle('btn-dark', view.variant === 'dark');
      if (labelNode) labelNode.textContent = labels[view.text];
      // El Layout lee esta marca para no pisar el boton mientras el flujo lo gobierna.
      form.dataset.checkoutPhase = phase;
      if (view.locked) submit.disabled = view.disabled;
      else document.dispatchEvent(new Event('squai:form-sync'));
    };

    const showSalesPanel = (next: SalesPanel) => {
      panel = next;
      document.querySelectorAll<HTMLElement>('[data-sales-panel]').forEach((block) => {
        block.hidden = block.dataset.salesPanel !== panel;
      });
      render();
    };

    const step = (event: FlowEvent) => {
      phase = nextPhase(phase, event);
      render();
    };

    const showError = (message: string) => {
      if (statusNode) {
        statusNode.textContent = message;
        statusNode.dataset.state = message ? 'error' : '';
      }
    };

    /**
     * Integracion personalizada de Bold: la libreria (window.BoldCheckout) solo
     * abre el modal embebido. Se reabre siempre con la MISMA sesion firmada, asi
     * un reintento no crea otra inscripcion.
     */
    const openPayment = async () => {
      if (!current) return;
      try {
        const redirectionUrl = `${window.location.origin}${root.dataset.returnPath ?? '/'}`;
        await openBoldCheckout(root.dataset.libraryUrl ?? '', current.session, redirectionUrl, current.customer);
        showError('');
      } catch {
        showError(feedback.checkoutError);
        step('closed');
      }
    };

    const returnUrl = (orderId: string) => `${root.dataset.returnPath ?? '/'}?bold-order-id=${encodeURIComponent(orderId)}`;

    const retryPayment = async () => {
      if (!current) return;
      step('retry');
      try {
        const res = await fetch(`${root.dataset.statusEndpoint}?order_id=${encodeURIComponent(current.session.orderId)}`, {
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          const { order } = (await res.json()) as { order: { status: string } };
          if (!canReopen(order.status)) {
            window.location.assign(returnUrl(current.session.orderId));
            return;
          }
        }
      } catch {
        // Sin poder consultar, se deja reintentar: Bold rechaza un orderId ya pagado.
      }
      await openPayment();
    };

    // En reintento el click no debe reenviar el formulario (crearia otra inscripcion).
    submit?.addEventListener('click', (event) => {
      if (phase === 'idle') return;
      event.preventDefault();
      if (phase === 'retry') void retryPayment();
    });

    // Bold avisa por postMessage cuando el comprador cierra el modal.
    window.addEventListener('message', (event) => {
      if (event.origin !== boldOrigin || event.data?.type !== 'BOLD_CHECKOUT_EVENT') return;
      step('closed');
    });

    // Si cambia sus datos, la inscripcion ya firmada deja de corresponderle: se
    // vuelve a "Reservar" y el siguiente envio creara una nueva.
    const edited = (event: Event) => {
      if (isConsentBox(event.target)) {
        render();
        return;
      }
      if (phase !== 'retry') return;
      current = null;
      showError('');
      step('edited');
    };
    form?.addEventListener('input', edited);
    form?.addEventListener('change', edited);
    currencyInputs.forEach((input) =>
      input.addEventListener('change', (event) => {
        showSelectedPrice();
        edited(event);
      })
    );

    document.addEventListener('squai:checkout-rejected', (event) => {
      const action = rejectionAction((event as CustomEvent<string | undefined>).detail);
      if (action === 'enrolled') {
        window.location.assign(enrolledUrl(root.dataset.returnPath ?? '/'));
      } else if (action === 'closed') {
        showError('');
        showSalesPanel('closed');
      }
    });

    // El Layout envia este evento cuando /api/checkout/session responde bien.
    document.addEventListener('squai:checkout-session', (event) => {
      const session = (event as CustomEvent<CheckoutSession>).detail;
      showPrice(session.amount, session.currency);

      // Prellena el formulario de Bold con lo que la persona ya escribio.
      const data = new FormData(form!);
      current = {
        session,
        customer: {
          fullName: String(data.get('full_name') ?? ''),
          email: String(data.get('email') ?? ''),
          phone: String(data.get('phone') ?? '').replace(/\D/g, ''),
          dialCode: String(data.get('country_code') ?? ''),
        },
      };
      step('session');
      void openPayment();
    });

    void loadPrice();
  }
</script>

<style>
  .one-signup {
    position: relative;
    z-index: 10;
    width: 100%;
    overflow: hidden;
    padding: var(--section-py) var(--gutter);
    background: #fff;
    color: var(--midnight);
  }
  .one-signup-grid {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: calc(var(--u) * 56);
    max-width: calc(var(--u) * 1560);
    margin: 0 auto;
  }
  .checkout-column,
  .checkout-form-column { min-width: 0; }
  .checkout-column { display: flex; flex-direction: column; gap: calc(var(--u) * 24); }
  .checkout-column h2 { color: var(--midnight); }
  .checkout-copy { display: flex; flex-direction: column; gap: 0.75rem; max-width: calc(var(--u) * 620); color: var(--neutral-11); }

  .one-signup-label {
    display: block;
    margin-bottom: 0.75rem;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--periwinkle-12);
  }
  .currency-picker { margin: 0; padding: 0.25rem 0 0; border: 0; min-width: 0; }
  .currency-options { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .currency-option { position: relative; display: inline-flex; cursor: pointer; }
  .currency-option span {
    padding: 0.625rem 1.5rem;
    border: 2px solid var(--periwinkle-12);
    border-radius: 9999px;
    background: transparent;
    color: var(--periwinkle-12);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.43;
    white-space: nowrap;
    transition: background-color 0.15s cubic-bezier(0.4, 0, 0.2, 1), color 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .currency-option:hover span { background: var(--periwinkle-3); }
  .currency-option input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .currency-option input:checked + span { background: var(--periwinkle-12); color: var(--canvas); }
  .currency-option input:focus-visible + span { outline: 2px solid var(--periwinkle-11); outline-offset: 3px; }

  .investment-price { display: flex; flex-direction: column; gap: calc(var(--u) * 12); padding-top: 0.5rem; }
  .price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 1rem; }
  .price-label { font-weight: 500; color: var(--neutral-11); }
  .price-line { display: flex; align-items: baseline; gap: 0.22em; color: var(--midnight); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .price-currency { font-size: 0.6em; }
  .price-amount[data-state='loading'] {
    display: inline-block;
    min-width: 4.2em;
    height: 0.9em;
    border-radius: 8px;
    background: var(--periwinkle-4);
    animation: price-pulse 1.4s ease-in-out infinite;
  }
  @keyframes price-pulse { 50% { opacity: 0.4; } }
  .reference-offer { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .reference-price { color: var(--neutral-11); font-family: var(--font-display); font-size: var(--fs-small); font-weight: 700; }
  .discount-badge {
    padding: 4px 12px;
    border-radius: 9999px;
    background: var(--gold-9);
    color: var(--midnight);
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
  }
  .discount-deadline { color: var(--neutral-11); }
  .price-note { margin: 0; font-family: var(--font-display); font-size: 16px; font-weight: 700; line-height: 1.5; color: var(--midnight); }
  .price-detail { color: var(--neutral-11); }
  .payment-methods { display: flex; flex-direction: column; gap: 0.25rem; }
  .payment-list { display: flex; flex-wrap: wrap; gap: 0 0.5rem; margin: 0; padding: 0; list-style: none; color: var(--neutral-11); }
  .payment-list li:not(:last-child)::after { content: ' ·'; }

  .checkout-card { display: flex; flex-direction: column; gap: 1.5rem; text-align: left; }
  .checkout-card-heading { display: flex; flex-direction: column; gap: calc(var(--u) * 10); }
  .checkout-card-heading h3 { color: var(--midnight); }
  .checkout-card-subtitle { color: var(--neutral-11); }
  .checkout-card form { display: flex; flex-direction: column; gap: 1.5rem; }
  .checkout-card form > .form-instructions { margin: 0; font-size: 14px; color: var(--neutral-11); }
  .one-signup-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .one-signup-phone { display: grid; grid-template-columns: minmax(96px, auto) minmax(0, 1fr); gap: 0.5rem; }

  .one-signup :global(.field-group) { gap: calc(var(--u) * 10); }
  .one-signup :global(.field-label) {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: 1.35;
    color: var(--midnight);
  }
  .one-signup :global(.field) {
    height: var(--input-h);
    min-height: var(--input-h);
    padding: 0 var(--input-px);
    border: 0;
