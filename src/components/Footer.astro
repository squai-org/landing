---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { legalPaths } from '../config/legal';
import { getSiteContent } from '../lib/content';
const { footerCols, heroSubtitle, tagline, company, ui, labels } = await getSiteContent();
---

<footer class="site-footer" data-surface="deep">
  <div class="footer-main">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo-link footer-logo" aria-label={ui.navigation.home}>
          <Logo size={38} />
        </a>
        <p class="footer-description">{heroSubtitle}</p>
        <p class="footer-tagline">{tagline}</p>
        <address class="footer-company">
          <span class="footer-company-name">{company.legalName}</span>
          <span>NIT {company.nit}</span>
          <a href={`mailto:${company.contact}`} class="footer-link">{company.contact}</a>
        </address>
        <div class="footer-follow">
          <span class="footer-heading">{ui.follow.title}</span>
          <SocialLinks />
        </div>
      </div>
      {
        footerCols.map((col) => (
          <nav class="footer-column" aria-label={col.h}>
            <h2 class="footer-heading">{col.h}</h2>
            <ul class="footer-list">
              {col.links.map((lnk) => (
                <li>
                  {lnk.target ? (
                    <a href={`/#${lnk.target}`} data-scroll-to={lnk.target} class="footer-link footer-primary-link">
                      {lnk.t}
                    </a>
                  ) : (
                    <a
                      href={lnk.href}
                      target={lnk.href?.startsWith('http') ? '_blank' : undefined}
                      rel={lnk.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="footer-link footer-primary-link"
                    >
                      {lnk.t}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span class="footer-copyright">{ui.footer.copyright}</span>
      <ul class="footer-legal-links">
        <li><a href={legalPaths.terms} class="footer-link">{labels.terms}</a></li>
        <li><a href={legalPaths.privacy} class="footer-link">{labels.privacy}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(24px, 3vw, 48px);
    border-radius: var(--radius-block) var(--radius-block) 0 0;
    background: var(--accent-deep);
    color: var(--on-deep);
    overflow: hidden;
  }
  .footer-main {
    padding: clamp(56px, 6vw, 104px) var(--gutter) clamp(48px, 5vw, 88px);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 72px);
    max-width: 1390px;
    margin: 0 auto;
  }
  .footer-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .footer-logo { --wordmark-color: var(--on-deep); }
  .footer-description { max-width: 36ch; margin: 0; color: var(--on-deep); font-size: var(--t-body); line-height: 1.7; }
  .footer-tagline { margin: 0; color: var(--gold-9); font-family: var(--font-hand); font-size: var(--t-body); line-height: 1.5; }
  .footer-company { display: flex; flex-direction: column; gap: 2px; color: var(--on-deep-muted); font-size: 16px; font-style: normal; line-height: 1.6; }
  .footer-company-name { color: var(--on-deep); font-family: var(--font-display); font-weight: 700; }
  .footer-follow { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .footer-column { display: flex; flex-direction: column; gap: 14px; }
  .footer-heading {
    margin: 0;
    color: var(--on-deep-muted);
    font-family: var(--font-display);
    font-size: var(--t-label);
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .footer-list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .footer-link {
    color: var(--on-deep);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    transition: color var(--duration-fast) ease, text-decoration-color var(--duration-fast) ease;
  }
  .footer-link:hover { color: var(--gold-9); text-decoration-color: currentColor; }
  .footer-primary-link { font-size: var(--t-body); }
  .footer-bottom { background: var(--midnight); color: var(--on-deep-muted); }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    max-width: 1390px;
    margin: 0 auto;
    padding: 22px var(--gutter);
    font-size: 15px;
  }
  .footer-bottom .footer-link { color: var(--on-deep-muted); text-decoration-color: currentColor; }
  .footer-bottom .footer-link:hover { color: var(--gold-9); }
  .footer-legal-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; padding: 0; list-style: none; }
  @media (prefers-reduced-motion: reduce) {
    .footer-link { transition: none; }
  }
  @media (max-width: 1023px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .site-footer { border-radius: var(--radius-xl) var(--radius-xl) 0 0; }
    .footer-grid { grid-template-columns: minmax(0, 1fr); gap: 36px; }
    .footer-bottom-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
