---
import Logo from './Logo.astro';
import { footerCols, tagline } from '../data/landing';
---

<footer style="background:#12162A">
  <div class="shell" style="padding-block:clamp(56px,6vw,96px) 40px">
    <div class="footer-grid" style="display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:clamp(32px,4vw,64px);padding-bottom:clamp(48px,6vw,88px)">
      <div style="display:flex;flex-direction:column;gap:16px;align-items:flex-start">
        <a href="/" class="logo-link" aria-label="Squai — inicio" style="--wordmark-color:#F4F6FF">
          <Logo height={26} />
        </a>
        <p class="body" style="color:#B7BCD0;max-width:300px">
          Formación en inteligencia artificial para personas, equipos y comunidades educativas.
        </p>
        <span style="font-family:var(--font-hand);font-size:16px;line-height:1.4;color:#8A8EF9">{tagline}</span>
      </div>
      {
        footerCols.map((col) => (
          <div style="display:flex;flex-direction:column;gap:12px">
            <div style="font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#8E94AC">
              {col.h}
            </div>
            {col.links.map((lnk) =>
              lnk.target ? (
                <a href={`/#${lnk.target}`} data-scroll-to={lnk.target} class="footer-link" style="font-size:14px;color:#F0F2FF">
                  {lnk.t}
                </a>
              ) : (
                <a
                  href={lnk.href}
                  target={lnk.href?.startsWith('http') ? '_blank' : undefined}
                  rel={lnk.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="footer-link"
                  style="font-size:14px;color:#F0F2FF"
                >
                  {lnk.t}
                </a>
              )
            )}
          </div>
        ))
      }
    </div>
    <div
      class="footer-bottom"
      style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:24px;border-top:1px solid #2C314D"
    >
      <span style="font-size:12px;color:#8E94AC">© 2026 Squai · Todos los derechos reservados</span>
      <div style="display:flex;gap:20px">
        <a href="/terminos-de-servicio" class="footer-link" style="font-size:12px;font-weight:700;color:#8E94AC">Términos de Servicio</a>
        <a href="/politica-de-privacidad" class="footer-link" style="font-size:12px;font-weight:700;color:#8E94AC">Política de Privacidad</a>
      </div>
    </div>
  </div>
</footer>
