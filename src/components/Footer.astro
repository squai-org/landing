---
import Logo from './Logo.astro';
import { getSiteContent } from '../lib/content';
const { footerCols, heroSubtitle, tagline, ui, labels } = await getSiteContent();
---

<footer class="footer-pad">
  <div class="footer-shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo-link footer-logo" aria-label={ui.navigation.home}>
          <Logo size={34} />
        </a>
        <p class="footer-description">
          {heroSubtitle}
        </p>
        <span class="footer-tagline">{tagline}</span>
      </div>
      {
        footerCols.map((col) => (
          <div class="footer-column">
            <div class="footer-heading">
              {col.h}
            </div>
            {col.links.map((lnk) =>
              lnk.target ? (
                <a href={`/#${lnk.target}`} data-scroll-to={lnk.target} class="footer-link footer-primary-link">
                  {lnk.t}
                </a>
              ) : (
                <a
                  href={lnk.href}
                  target={lnk.href?.startsWith('http') ? '_blank' : undefined}
                  rel={lnk.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="footer-link footer-secondary-link"
                >
                  {lnk.t}
                </a>
              )
            )}
          </div>
        ))
      }
    </div>
    <div class="footer-bottom">
      <span class="footer-copyright">{ui.footer.copyright}</span>
      <div class="footer-legal-links">
        <a href="/terminos-de-servicio" class="footer-link footer-legal-link">{labels.terms}</a>
        <a href="/politica-de-privacidad" class="footer-link footer-legal-link">{labels.privacy}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-pad { margin: 28px 12px 12px; padding: clamp(56px, 6vw, 104px) clamp(24px, 5vw, 88px) 40px; border-radius: 28px; background: var(--midnight); }
  .footer-shell { max-width: 1240px; margin: 0 auto; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: clamp(32px, 4vw, 64px); padding-bottom: clamp(56px, 6vw, 96px); }
  .footer-brand, .footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .footer-column { gap: 12px; }
  .footer-logo { --wordmark-color: #F0F2FF; }
  .footer-description { max-width: 34ch; margin: 0; color: #F0F2FF; font-size: var(--t-body); line-height: 1.7; }
  .footer-tagline { color: var(--gold); font-family: var(--font-hand); font-size: var(--t-body); line-height: 1.5; }
  .footer-heading { color: var(--periwinkle); font-family: var(--font-display); font-size: var(--t-label); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .footer-primary-link { color: #F0F2FF; font-size: var(--t-body); }
  .footer-secondary-link { color: #F0F2FF; font-size: 14px; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, .08); }
  .footer-copyright, .footer-legal-link { color: #A9B2CC; font-size: 13px; }
  .footer-legal-link { font-weight: 700; }
  .footer-legal-links { display: flex; gap: 20px; }
  @media (max-width: 1023px) {
    .footer-pad { margin: 20px 10px 10px; padding: 64px 40px 32px; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .footer-pad { margin: 16px 8px 8px; padding: 48px 22px 28px; border-radius: 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
