---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { legalPaths } from '../config/legal';
import { getSiteContent } from '../lib/content';
import { whatsappUrl } from '../lib/whatsapp';

interface Props {
  overlap?: boolean;
  whatsappMessage?: string;
}

const { overlap = false, whatsappMessage } = Astro.props;
const { footerCols, footerServices, heroSubtitle, tagline, company, ui, labels } = await getSiteContent();
const whatsappHref = whatsappUrl(company.phone, whatsappMessage ?? ui.whatsapp.message);
const serviceHrefs = new Set(footerServices.links.map((link) => link.href));
const siteLinks = footerCols.flatMap((col) => col.links).filter((link) => !link.href || !serviceHrefs.has(link.href));
const isExternal = (href?: string) => Boolean(href?.startsWith('http'));
---

<footer class:list={['site-footer', { 'site-footer--overlap': overlap }]} data-surface="deep" data-header-tone="dark">
  <div class="footer-main">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-intro">
          <a href="/" class="logo-link footer-logo" aria-label={ui.navigation.home}>
            <Logo size={38} />
          </a>
          <p class="footer-blurb">{heroSubtitle}</p>
        </div>

        <address class="footer-company">
          <span class="footer-company-name">{company.legalName}</span>
          <span>NIT {company.nit}</span>
          <a href={`mailto:${company.contact}`} class="footer-mail">{company.contact}</a>
        </address>

        <div class="footer-follow">
          <SocialLinks />
          {
            whatsappHref && (
              <a href={whatsappHref} class="footer-whatsapp" target="_blank" rel="noopener noreferrer">
                {ui.footer.whatsapp}
              </a>
            )
          }
        </div>

        <nav aria-label={labels.brand}>
          <ul class="footer-nav">
            {
              siteLinks.map((link) =>
                link.target ? (
                  <li>
                    <a href={`/#${link.target}`} data-scroll-to={link.target} class="footer-nav-link">{link.t}</a>
                  </li>
                ) : (
                  <li>
                    <a
                      href={link.href}
                      target={isExternal(link.href) ? '_blank' : undefined}
                      rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                      class="footer-nav-link"
                    >
                      {link.t}
                    </a>
                  </li>
                )
              )
            }
          </ul>
        </nav>
      </div>

      <div class="footer-aside">
        <div class="footer-aside-head">
          <h2 class="footer-aside-title">{footerServices.title}</h2>
          <p class="footer-aside-copy">{tagline}</p>
        </div>
        <nav aria-label={footerServices.title}>
          <ul class="footer-nav footer-services">
            {
              footerServices.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-nav-link">{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>{ui.footer.copyright}</span>
      <ul class="footer-legal-links">
        <li><a href={legalPaths.terms} class="footer-legal-link">{labels.terms}</a></li>
        <li><a href={legalPaths.privacy} class="footer-legal-link">{labels.privacy}</a></li>
      </ul>
      <span class="footer-company-mark">{company.legalName}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 0;
    width: 100%;
    margin-top: clamp(24px, 3vw, 48px);
    padding-top: var(--section-py);
    overflow: hidden;
    background: var(--footer-bg);
    color: var(--on-footer);
  }
  .site-footer--overlap {
    margin-top: calc(var(--edge-r) * -1);
    padding-top: calc(var(--edge-r) + var(--section-py));
  }
  .footer-main { padding: 0 var(--gutter); }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 48px;
    margin: 0 auto;
    padding-bottom: 64px;
  }
  .footer-brand { display: flex; flex-direction: column; gap: 32px; }
  .footer-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .footer-logo { --wordmark-color: var(--on-footer); color: var(--on-footer); }
  .footer-blurb {
    max-width: 28rem;
    margin: 0;
    color: var(--on-footer-muted);
    font-size: 16px;
    line-height: 1.625;
  }
  .footer-company {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--on-footer-muted);
    font-size: 16px;
    font-style: normal;
    line-height: 1.625;
  }
  .footer-company-name { color: var(--on-footer); font-family: var(--font-display); font-weight: 700; }
  .footer-mail,
  .footer-legal-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color .15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-mail:hover,
  .footer-legal-link:hover { color: var(--gold-9); }
  .footer-follow { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .footer-whatsapp {
    padding: 4px 8px;
    color: var(--gold-9);
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    transition: color .15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .footer-whatsapp:hover { color: var(--on-footer); }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
  }
  .footer-nav-link { color: var(--on-footer); transition: color .15s cubic-bezier(0.4, 0, 0.2, 1); }
  .footer-nav-link:hover { color: var(--gold-9); }
  .footer-aside { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .footer-aside-head { display: flex; flex-direction: column; gap: 12px; }
  .footer-aside-title {
    margin: 0;
    color: var(--on-footer);
    font-family: var(--font-display);
    font-size: calc(var(--u) * 30);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.02em;
    -webkit-text-stroke: 0.012em currentColor;
    paint-order: stroke fill;
    text-wrap: balance;
  }
  .footer-aside-copy {
    max-width: 32rem;
    margin: 0;
    color: var(--on-footer-muted);
    font-size: 16px;
    line-height: 1.625;
  }
  .footer-bottom { width: 100%; padding: 20px var(--gutter); background: var(--footer-bar); color: var(--on-footer); }
  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 20px;
  }
  .footer-company-mark { white-space: nowrap; }
  .footer-legal-links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; padding: 0; list-style: none; }

  @media (min-width: 640px) {
    .footer-blurb { font-size: 18px; line-height: 1.625; }
    .footer-bottom { padding: 24px 96px; }
    .footer-bottom-inner { flex-direction: row; align-items: center; }
  }

  @media (min-width: 992px) {
    .footer-aside-title { font-size: calc(var(--u) * 40); }
  }

  @media (min-width: 1024px) {
    .footer-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 64px; }
    .footer-brand { grid-column: span 6 / span 6; }
    .footer-aside { grid-column: span 6 / span 6; padding-left: 48px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-mail, .footer-legal-link, .footer-whatsapp, .footer-nav-link { transition: none; }
  }
</style>
