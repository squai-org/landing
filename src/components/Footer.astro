---
import Logo from './Logo.astro';
import { getSiteContent } from '../lib/content';
const { footerCols, heroSubtitle, tagline, socials, ui, labels } = await getSiteContent();

const ACCENTS: Record<string, string> = {
  LinkedIn: 'var(--gold)',
  YouTube: 'var(--canvas)',
};
/* YouTube's chip is light (--canvas) to stand out against the dark
   footer, so its glyph needs a dark color instead of the default
   canvas-on-midnight used by every other .social-button. */
const ICON_COLORS: Record<string, string> = {
  YouTube: 'var(--midnight)',
};

const ICONS: Record<string, string> = {
  LinkedIn:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4V9Z',
  YouTube:
    'M23.5 6.2a2.9 2.9 0 0 0-2-2C19.7 3.7 12 3.7 12 3.7s-7.7 0-9.5.5a2.9 2.9 0 0 0-2 2A30 30 0 0 0 0 12a30 30 0 0 0 .5 5.8 2.9 2.9 0 0 0 2 2c1.8.5 9.5.5 9.5.5s7.7 0 9.5-.5a2.9 2.9 0 0 0 2-2A30 30 0 0 0 24 12a30 30 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z',
};
---

<footer class="footer-pad">
  <div class="footer-shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo-link footer-logo" aria-label={ui.navigation.home}>
          <Logo size={34} />
        </a>
        <p class="footer-description">
          {heroSubtitle}
        </p>
        <span class="footer-tagline">{tagline}</span>
      </div>
      {
        footerCols.map((col) => (
          <div class="footer-column">
            <div class="footer-heading">
              {col.h}
            </div>
            {col.links.map((lnk) =>
              lnk.target ? (
                <a href={`/#${lnk.target}`} data-scroll-to={lnk.target} class="footer-link footer-primary-link">
                  {lnk.t}
                </a>
              ) : (
                <a
                  href={lnk.href}
                  target={lnk.href?.startsWith('http') ? '_blank' : undefined}
                  rel={lnk.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="footer-link footer-primary-link"
                >
                  {lnk.t}
                </a>
              )
            )}
          </div>
        ))
      }
      <div class="footer-column footer-socials">
        <span class="footer-heading">{ui.follow.title}</span>
        <div class="footer-social-row">
          {
            socials.map((s) =>
              s.href ? (
                <a href={s.href} aria-label={s.name} class="social-button footer-social-button" style={`background:${ACCENTS[s.name]};color:${ICON_COLORS[s.name] ?? 'var(--canvas)'}`} target="_blank" rel="noopener noreferrer">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={ICONS[s.name]} />
                  </svg>
                </a>
              ) : (
                <span class="social-button footer-social-button social-button-static" aria-hidden="true" style={`--social-accent:${ACCENTS[s.name]};background:${ACCENTS[s.name]};color:${ICON_COLORS[s.name] ?? 'var(--canvas)'}`}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={ICONS[s.name]} />
                  </svg>
                </span>
              )
            )
          }
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="footer-copyright">{ui.footer.copyright}</span>
      <div class="footer-legal-links">
        <a href="/terminos-de-servicio" class="footer-link footer-legal-link">{labels.terms}</a>
        <a href="/politica-de-privacidad" class="footer-link footer-legal-link">{labels.privacy}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-pad { margin: 28px 12px 12px; padding: clamp(56px, 6vw, 104px) clamp(24px, 5vw, 88px) 40px; border-radius: 28px; background: var(--midnight); }
  .footer-shell { max-width: 1240px; margin: 0 auto; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 0.9fr; gap: clamp(32px, 4vw, 64px); padding-bottom: clamp(56px, 6vw, 96px); }
  .footer-brand, .footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .footer-column { gap: 12px; }
  .footer-logo { --wordmark-color: #F0F2FF; }
  .footer-description { max-width: 34ch; margin: 0; color: #F0F2FF; font-size: var(--t-body); line-height: 1.7; }
  .footer-tagline { color: var(--gold); font-family: var(--font-hand); font-size: var(--t-body); line-height: 1.5; }
  .footer-social-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .footer-social-button { width: 40px; height: 40px; border-color: transparent; }
  .footer-social-button.social-button-static { pointer-events: none; cursor: default; }
  .footer-social-button.social-button-static:hover { background: var(--social-accent); transform: none; filter: none; }
  .footer-heading { color: var(--periwinkle); font-family: var(--font-display); font-size: var(--t-label); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .footer-primary-link { color: #F0F2FF; font-size: var(--t-body); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, .08); }
  .footer-copyright, .footer-legal-link { color: #A9B2CC; font-size: 13px; }
  .footer-legal-link { font-weight: 700; }
  .footer-legal-links { display: flex; gap: 20px; }
  @media (max-width: 1023px) {
    .footer-pad { margin: 20px 10px 10px; padding: 64px 40px 32px; }
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .footer-pad { margin: 16px 8px 8px; padding: 48px 22px 28px; border-radius: 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
