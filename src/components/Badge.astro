---
type Audience = 'personas' | 'equipos' | 'instituciones';

interface Props {
  audience?: Audience;
}

const AUDIENCE: Record<Audience, { background: string; color: string }> = {
  personas: { background: 'var(--periwinkle-tint)', color: 'var(--periwinkle-ink)' },
  equipos: { background: 'var(--teal-tint)', color: 'var(--teal-ink)' },
  instituciones: { background: 'var(--gold)', color: '#0A0C1A' },
};

const { audience } = Astro.props;
const v = audience ? AUDIENCE[audience] : { background: 'var(--canvas)', color: 'var(--ink-body)' };
---

<span
  style={`display:inline-block;padding:4px 14px;border-radius:var(--radius-pill);font-family:var(--font-display);font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;background:${v.background};color:${v.color}`}
>
  <slot />
</span>
