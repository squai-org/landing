---
/**
 * Widget de Turnstile en modo implícito: el script api.js (cargado en Layout)
 * busca los elementos con clase `cf-turnstile` y añade al formulario el input
 * oculto `cf-turnstile-response`, que el backend valida contra siteverify.
 * https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/
 *
 * Sin PUBLIC_TURNSTILE_SITE_KEY no se renderiza nada y el formulario funciona
 * igual: el Worker omite la verificación cuando falta el secret.
 *
 * `appearance="interaction-only"` deja el widget fuera de la vista mientras no
 * haga falta interacción: el visitante normal no ve la caja de «Success!» bajo
 * el botón, y solo aparece a quien Cloudflare decide retar. El tipo de widget
 * (Managed, Non-Interactive o Invisible) no se decide aquí, sino en el panel de
 * Cloudflare junto a la sitekey, y en un widget Invisible esta opción no pinta
 * nada porque nunca se muestra.
 * https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/widget-configurations/
 */
interface Props {
  action: string;
}

const { action } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

{
  siteKey && (
    <div class="turnstile-wrap">
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action={action}
        data-theme="light"
        data-appearance="interaction-only"
        data-callback="squaiTurnstileSync"
        data-expired-callback="squaiTurnstileSync"
        data-error-callback="squaiTurnstileSync"
        data-timeout-callback="squaiTurnstileSync"
      />
    </div>
  )
}

<style>
  /* El hueco solo se reserva cuando el widget llega a pintarse: con
     interaction-only el contenedor suele quedar vacio, y un margen fijo dejaria
     un salto bajo el boton sin nada que lo ocupe. */
  .turnstile-wrap {
    display: flex;
    justify-content: center;
  }
  .turnstile-wrap:has(iframe) { margin-top: 18px; }
</style>
