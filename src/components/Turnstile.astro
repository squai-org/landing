---
/**
 * Widget de Turnstile en modo implícito: el script api.js (cargado en Layout)
 * busca los elementos con clase `cf-turnstile` y añade al formulario el input
 * oculto `cf-turnstile-response`, que el backend valida contra siteverify.
 * https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/
 *
 * Sin PUBLIC_TURNSTILE_SITE_KEY no se renderiza nada y el formulario funciona
 * igual: el Worker omite la verificación cuando falta el secret.
 *
 * El widget se deja visible (appearance por defecto, `always`) y colocado
 * dentro del formulario, justo encima del botón de envío. El motivo no es
 * estético: el botón arranca deshabilitado y no se habilita hasta que Turnstile
 * entrega un token, así que si el widget no se ve, quien espera no tiene forma
 * de saber por qué el botón no responde. Enseñarlo es lo que explica la espera.
 *
 * El tipo de widget (Managed, Non-Interactive o Invisible) no se decide aquí,
 * sino en el panel de Cloudflare junto a la sitekey.
 * https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/widget-configurations/
 */
interface Props {
  action: string;
}

const { action } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

{
  siteKey && (
    <div class="turnstile-wrap">
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-action={action}
        data-theme="light"
        data-callback="squaiTurnstileSync"
        data-expired-callback="squaiTurnstileSync"
        data-error-callback="squaiTurnstileSync"
        data-timeout-callback="squaiTurnstileSync"
      />
    </div>
  )
}

<style>
  /* Se alinea al borde de los campos y toma la misma separacion que hay entre
     grupos de campos (14px), no la del boton (18px): asi el widget se lee como
     un paso mas del formulario y no como algo pegado debajo. */
  .turnstile-wrap {
    display: flex;
    justify-content: flex-start;
    margin-top: 14px;
  }
</style>
