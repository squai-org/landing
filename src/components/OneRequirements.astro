---
import { Image } from 'astro:assets';
import OneBackdrop from './OneBackdrop.astro';
import type { Service } from '../lib/content';
import shrug from '../assets/one/requisitos/pexels-8638716.jpeg';
import '../styles/one-sections.css';

interface Props {
  beforeSignup: NonNullable<Service['beforeSignup']>;
}

const { notForYou, needs } = Astro.props.beforeSignup;
const logos = [
  { name: 'claude', icon: '/illustrations/logos/claude-color.svg', text: '/illustrations/logos/claude-text.svg' },
  { name: 'gemini', icon: '/illustrations/logos/gemini-color.svg', text: '/illustrations/logos/gemini-text.svg' },
];
---

<section id="requisitos" class="one-needs one-u" aria-labelledby="needs-title" data-header-tone="light">
  <OneBackdrop shape="faq" colors={['#eef0fd']} opacities={[0.9]} align="xMinYMin" />

  <div class="one-needs-shell">
    <div class="one-needs-row" data-needs-row>
      <div class="one-needs-copy" data-needs-copy>
        <h2 id="needs-title" class="one-h2">{notForYou.title}</h2>
        <p class="one-lead one-needs-body">{notForYou.body}</p>
        <p class="one-hand one-needs-note">{notForYou.handwritten}</p>
      </div>
      <div class="one-needs-photo" data-needs-media>
        <Image src={shrug} alt={notForYou.photoAlt} widths={[480, 800, 1200]} sizes="(min-width: 992px) 45vw, 100vw" loading="lazy" />
      </div>
    </div>

    <div class="one-needs-row one-needs-row-reverse" data-needs-row>
      <div class="one-needs-copy" data-needs-copy>
        <h2 class="one-h2">{needs.title}</h2>
        <ul class="one-lead one-needs-list">
          {needs.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="one-needs-logos" data-needs-logos role="img" aria-label={needs.logosAlt} data-needs-media>
        <div class="one-needs-logo one-needs-chatgpt" aria-hidden="true">
          <img src="/illustrations/logos/openai.svg" alt="" loading="lazy" />
          <span>ChatGPT</span>
        </div>
        {logos.map((logo) => (
          <div class={`one-needs-logo one-needs-${logo.name}`} aria-hidden="true">
            <img src={logo.icon} alt="" loading="lazy" />
            <img class="one-needs-wordmark" src={logo.text} alt="" loading="lazy" />
          </div>
        ))}
      </div>
    </div>

    <p class="one-lead one-needs-footnote"><strong>Nota:</strong> {needs.note}</p>
  </div>
</section>

<script>
  import { revealOnView, springs } from '../lib/motion';

  document.querySelectorAll<HTMLElement>('[data-needs-row]').forEach((row) => {
    const copy = row.querySelector<HTMLElement>('[data-needs-copy]');
    const media = row.querySelector<HTMLElement>('[data-needs-media]');
    if (copy) revealOnView(copy, { opacity: 0, y: 48 }, { opacity: 1, y: 0 }, springs.flowCard);
    if (media) revealOnView(media, { opacity: 0, y: 72 }, { opacity: 1, y: 0 }, { ...springs.flowCard, delay: 0.08 });
  });
</script>

<style>
  .one-needs {
    position: relative;
    z-index: 15;
    width: 100%;
    overflow-x: clip;
    margin-top: calc(var(--edge-r) * -1);
    padding: var(--section-py) var(--gutter) calc(var(--section-py) + var(--edge-r));
    border-radius: var(--edge-r);
    background: #fff;
    color: var(--midnight);
  }
  .one-needs-shell { position: relative; z-index: 1; display: flex; flex-direction: column; gap: calc(var(--u) * 96); }
  .one-needs-row {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: calc(var(--u) * 48);
  }
  .one-needs-copy { display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--u) * 24); }
  .one-needs-body { max-width: calc(var(--u) * 760); }
  .one-needs-note { display: inline-block; color: var(--periwinkle-11); rotate: -2deg; }
  .one-needs-list { display: flex; flex-direction: column; gap: calc(var(--u) * 16); margin: 0; padding-left: 1.25em; max-width: calc(var(--u) * 760); }
  .one-needs-logos { display: flex; flex-direction: column; align-items: center; gap: calc(var(--u) * 56); }
  .one-needs-logo { display: flex; align-items: center; gap: calc(var(--u) * 16); }
  .one-needs-logo img { display: block; height: calc(var(--u) * 72); width: auto; }
  .one-needs-logo .one-needs-wordmark { height: calc(var(--u) * 48); }
  .one-needs-logo span { font-family: var(--font-display); font-weight: 700; font-size: calc(var(--u) * 48); line-height: 1; }
  .one-needs-chatgpt { rotate: -3deg; }
  .one-needs-claude { rotate: 2deg; }
  .one-needs-gemini { rotate: -2deg; }
  .one-needs-footnote { align-self: center; max-width: calc(var(--u) * 800); margin: 0; text-align: center; color: var(--periwinkle-11); font-family: var(--font-body); }
  .one-needs-footnote strong { font-family: var(--font-display); font-weight: 700; }
  .one-needs-photo { overflow: hidden; border-radius: var(--card-r); }
  .one-needs-photo :global(img) { display: block; width: 100%; height: 100%; aspect-ratio: 4 / 5; object-fit: cover; transform: scaleX(-1); }
  @media (min-width: 992px) {
    .one-needs-row { grid-template-columns: 1fr 1fr; gap: calc(var(--u) * 80); }
    .one-needs-photo :global(img) { aspect-ratio: 1 / 1; }
    .one-needs-row-reverse .one-needs-logos { order: -1; }
    .one-needs-logo { gap: calc(var(--u) * 24); }
    .one-needs-logo img { height: calc(var(--u) * 112); }
    .one-needs-logo .one-needs-wordmark { height: calc(var(--u) * 72); }
    .one-needs-logo span { font-size: calc(var(--u) * 72); }
  }
</style>
