---
import BackdropShape from './BackdropShape.astro';
import presentation from '../assets/illustrations/presentacion-video.svg';
import { youtubeEmbedUrl, youtubeVideoId } from '../lib/youtube';
import type { Service } from '../lib/content';

interface Props {
  video: NonNullable<Service['video']>;
}

const { video } = Astro.props;
const videoId = video.url ? youtubeVideoId(video.url) : undefined;
const embedUrl = videoId ? youtubeEmbedUrl(videoId) : undefined;
---

<section class="section video-section" aria-labelledby="video-title">
  <BackdropShape shape="faq" flip="x" align="xMaxYMin" />
  <div class="shell video-shell">
    <h2 id="video-title" class="display d-h2 video-title" data-reveal="heading">{video.title}</h2>
    <figure class="video-card" data-reveal="tilt">
      <div class="video-frame" data-video-frame>
        <img
          class="video-poster"
          src={presentation.src}
          width={presentation.width}
          height={presentation.height}
          alt={video.posterAlt}
          loading="lazy"
          decoding="async"
        />
        {
          embedUrl && (
            <button
              type="button"
              class="video-play"
              data-video-play
              data-embed-url={embedUrl}
              data-video-title={video.iframeTitle}
              aria-label={`${video.playLabel}: ${video.iframeTitle}`}
            >
              <span class="video-play-pill" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
                {video.playLabel}
              </span>
            </button>
          )
        }
      </div>
      <figcaption class="video-caption">{video.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-video-play]').forEach((button) => {
    button.addEventListener('click', () => {
      const frame = button.closest('[data-video-frame]');
      const { embedUrl, videoTitle } = button.dataset;
      if (!frame || !embedUrl || !videoTitle) return;

      const player = document.createElement('iframe');
      player.src = embedUrl;
      player.title = videoTitle;
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      player.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.replaceChildren(player);
      player.focus();
    });
  });
</script>

<style>
  .video-section {
    position: relative;
    overflow: hidden;
    background: var(--accent-soft);
    --shape-1: var(--surface);
    --shape-2: var(--surface);
    --shape-1-opacity: 0.7;
    --shape-2-opacity: 0.5;
  }
  .video-shell {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: clamp(32px, 4vw, 56px);
  }
  .video-title { max-width: 22ch; color: var(--ink); text-align: center; }
  .video-card {
    width: 100%;
    max-width: 880px;
    margin: 0;
    padding: clamp(10px, 1.4vw, 20px);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-float);
  }
  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--accent-soft);
  }
  .video-poster {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(4px, 1vw, 12px);
  }
  .video-frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .video-play:focus-visible { outline-offset: -6px; }
  .video-play-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--control-height);
    padding: 0 22px 0 18px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: var(--shadow-float);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    transition: transform var(--duration-base) var(--ease-overshoot), background-color var(--duration-fast) var(--ease-out);
  }
  .video-play:hover .video-play-pill { background: var(--accent-hover); transform: scale(1.06); }
  .video-caption {
    padding: clamp(14px, 1.6vw, 22px) clamp(8px, 1vw, 14px) clamp(6px, 0.8vw, 10px);
    color: var(--accent-ink);
    font-family: var(--font-hand);
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.3;
    text-align: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-play-pill { transition: none; }
    .video-play:hover .video-play-pill { transform: none; }
  }
</style>
