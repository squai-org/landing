---
import BackdropShape from './BackdropShape.astro';
import type { Service } from '../lib/content';

interface Props {
  flow: NonNullable<Service['howItWorks']>;
}

const { flow } = Astro.props;
const restingAngles = [1.6, -1.2, 1.1, -1.6];
---

<section id="como-funciona" class="section flow" aria-labelledby="flow-title">
  <BackdropShape shape="flow" class="flow-backdrop" />
  <div class="shell flow-shell">
    <header class="flow-header">
      <h2 id="flow-title" class="display d-h1 flow-title" data-reveal="heading">{flow.title}</h2>
      <p class="flow-handwritten" data-reveal="copy">{flow.handwritten}</p>
    </header>

    <ol class="flow-steps">
      {
        flow.steps.map((step, index) => (
          <li
            class:list={['flow-step', index % 2 === 0 ? 'is-accent' : 'is-plain']}
            style={`--tilt: ${restingAngles[index % restingAngles.length]}deg`}
            data-reveal="tilt"
            data-reveal-delay={index * 90}
          >
            <p class="flow-step-number">{flow.stepLabel} {index + 1}</p>
            <img src={step.illustration} alt={step.alt} width="1400" height="1365" loading="lazy" decoding="async" />
            <h3 class="display d-h3">{step.t}</h3>
            <p class="body">{step.d}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .flow {
    position: relative;
    overflow: hidden;
    background: var(--accent-soft);
    --shape-1: var(--accent-soft-strong);
    --shape-2: var(--accent-line);
    --shape-1-opacity: 0.9;
    --shape-2-opacity: 0.35;
  }
  .flow-shell { position: relative; z-index: 1; display: grid; gap: clamp(32px, 4vw, 64px); }
  .flow-header { display: grid; gap: 14px; }
  .flow-title { color: var(--ink); }
  .flow-handwritten {
    margin: 0;
    color: var(--accent-ink);
    font-family: var(--font-hand);
    font-size: clamp(20px, 2vw, 30px);
    line-height: 1.3;
    rotate: 1.4deg;
    transform-origin: left center;
  }
  .flow-steps {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: 1fr;
    gap: clamp(16px, 1.8vw, 24px);
    list-style: none;
  }
  .flow-step {
    display: flex;
    min-width: 0;
    padding: clamp(24px, 2.2vw, 36px);
    flex-direction: column;
    gap: 14px;
    border-radius: var(--radius-xl);
    color: var(--ink);
    box-shadow: var(--shadow-card);
    transition: rotate var(--duration-slow) var(--ease-overshoot), translate var(--duration-slow) var(--ease-out);
  }
  .flow-step.is-accent { background: var(--accent); }
  .flow-step.is-plain { background: var(--canvas); }
  .flow-step .body { color: var(--ink); }
  .flow-step.is-plain .body { color: var(--ink-body); }
  .flow-step img { display: block; width: 100%; height: auto; aspect-ratio: 1400 / 1365; }
  .flow-step-number {
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(20px, 1.6vw, 26px);
    line-height: 1.2;
    text-align: center;
  }

  @media (min-width: 768px) {
    .flow-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .flow-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .flow-step { rotate: var(--tilt); }
    .flow-step:hover, .flow-step:focus-within { rotate: 0deg; translate: 0 -8px; }
  }
</style>
