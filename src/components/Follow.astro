---
import { socials } from '../data/landing';

const ACCENTS: Record<string, string> = {
  LinkedIn: 'var(--gold)',
  Instagram: 'var(--teal)',
  X: 'var(--periwinkle)',
};

const ICONS: Record<string, string> = {
  LinkedIn:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4V9Z',
  Instagram:
    'M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.8 3.8 0 0 1-1.38-.9 3.8 3.8 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2Zm0 1.8c-3.14 0-3.5.01-4.74.07-.9.04-1.38.19-1.7.31-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.12.32-.27.8-.31 1.7C3.44 8.5 3.43 8.86 3.43 12s.01 3.5.07 4.74c.4.9.19 1.38.31 1.7.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.12.8.27 1.7.31 1.24.06 1.6.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.38-.19 1.7-.31.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.12-.32.27-.8.31-1.7.06-1.24.07-1.6.07-4.74s-.01-3.5-.07-4.74c-.04-.9-.19-1.38-.31-1.7a2.9 2.9 0 0 0-.69-1.06 2.9 2.9 0 0 0-1.06-.69c-.32-.12-.8-.27-1.7-.31-1.24-.06-1.6-.07-4.74-.07Zm0 3.06a4.94 4.94 0 1 1 0 9.88 4.94 4.94 0 0 1 0-9.88Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.1-2.98a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z',
  X: 'M17.53 3h3.02l-6.6 7.54L21.75 21h-5.9l-4.62-6.04L5.94 21H2.92l7.06-8.07L2.4 3h6.05l4.18 5.52L17.53 3Zm-1.06 16.2h1.67L7.6 4.71H5.8l10.67 14.49Z',
};
---

<section class="section night follow-section">
  <div class="shell follow-card">
      <h2 class="display d-h1 follow-title">Síguenos</h2>
      <div class="follow-content">
        <p class="lead follow-copy">
          Seguimos en LinkedIn, Instagram y X. Ahí publicamos lo que vamos aprendiendo y las fechas de cada cohorte.
        </p>
        <div class="social-row">
          {
            socials.map((s) =>
              s.href ? (
                <a href={s.href} aria-label={s.name} class="social-button" style={`background:${ACCENTS[s.name]}`} target="_blank" rel="noopener noreferrer">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={ICONS[s.name]} />
                  </svg>
                </a>
              ) : (
                <span class="social-button social-button-static" aria-hidden="true" style={`--social-accent:${ACCENTS[s.name]};background:${ACCENTS[s.name]}`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={ICONS[s.name]} />
                  </svg>
                </span>
              )
            )
          }
        </div>
      </div>
  </div>
</section>

<style>
  .section.follow-section {
    padding-block: clamp(56px, 6vw, 96px);
  }
  .follow-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.9fr);
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }
  .follow-content {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: clamp(20px, 2.4vw, 36px);
  }
  .follow-title { min-width: 0; flex: 1 1 280px; color: var(--canvas); }
  .social-row { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14px; }
  .social-button-static {
    pointer-events: none;
    cursor: default;
  }
  .social-button-static:hover {
    background: var(--social-accent);
    color: var(--canvas);
    transform: none;
    filter: none;
  }
  .follow-copy {
    max-width: 46ch;
    margin-left: auto;
    color: #F4F6FF;
    text-align: right;
  }
  @media (max-width: 760px) {
    .follow-card {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .follow-content { align-items: flex-start; }
    .follow-copy {
      margin-left: 0;
      max-width: none;
      text-align: left;
    }
    .follow-card .social-row {
      justify-content: flex-start;
    }
  }
</style>
