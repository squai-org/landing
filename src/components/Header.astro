---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { navLinks } from '../data/landing';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const serviceLinks = [
  { name: 'Squai One', subtitle: 'Personas', href: '/servicios/squai-one' },
  { name: 'Squai Grow', subtitle: 'Empresas', href: '/servicios/squai-grow' },
  { name: 'Squai Learn', subtitle: 'Instituciones educativas', href: '/servicios/squai-learn' },
];
---

<header class="header-wrap over-hero" data-header>
  <div class="nav-bar">
    <a href="/" class="logo-link" aria-label="Squai — inicio">
      <Logo size={34} />
    </a>
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <nav id="site-nav" class="nav-links-row" data-nav-menu aria-label="Principal">
      <ul class="nav-list">
        {
          navLinks.map((link) =>
            link.target === 'servicios' ? (
              <li class="nav-services" data-services-menu>
              <button
                type="button"
                class="nav-link nav-services-trigger"
                data-services-toggle
                aria-expanded="false"
                aria-controls="services-submenu"
              >
                <span>{link.label}</span>
                <svg class="nav-services-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </button>
              <ul id="services-submenu" class="services-submenu" data-services-submenu>
                {serviceLinks.map((service) => (
                  <li>
                    <a href={service.href} class="service-menu-link" aria-current={currentPath === service.href ? 'page' : undefined}>
                      <span class="service-menu-title">{service.name}</span>
                      <span class="service-menu-subtitle">{service.subtitle}</span>
                    </a>
                  </li>
                ))}
              </ul>
              </li>
            ) : (
              <li>
                <a
                  href={`/#${link.target}`}
                  data-scroll-to={link.target}
                  data-nav-section={link.target}
                  class="nav-link"
                >
                  {link.label}
                </a>
              </li>
            )
          )
        }
        <li class="nav-cta-wrap">
          <Button variant="primary" href="/servicios/squai-one#lista" compact class="nav-cta" aria-current={currentPath === '/servicios/squai-one' ? 'page' : undefined}>Lista de espera</Button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header-wrap { position: fixed; inset: 0 0 auto; z-index: 60; padding: 30px 24px 0; }
  .nav-bar {
    display: flex;
    max-width: 1120px;
    margin: 0 auto;
    padding: 9px 10px 9px 24px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 2px rgba(13, 27, 42, .04), 0 14px 34px -22px rgba(13, 27, 42, .28);
  }
  .nav-links-row { display: block; }
  .nav-list {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: 4px;
    list-style: none;
  }
  .nav-link {
    padding: 9px 14px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    cursor: pointer;
    font-size: 17px;
    font-weight: 600;
  }
  .nav-services { position: relative; }
  .nav-services-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 0;
    background: transparent;
    font-family: inherit;
  }
  .nav-services-chevron { flex: none; transition: transform .18s ease; }
  .nav-services.is-open .nav-services-chevron { transform: rotate(180deg); }
  .services-submenu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    display: grid;
    z-index: 2;
    width: min(296px, calc(100vw - 32px));
    margin: 0;
    padding: 10px;
    border: 1px solid var(--line-soft);
    border-radius: 18px;
    background: var(--surface);
    list-style: none;
    box-shadow: 0 18px 40px -18px rgba(10, 12, 26, .36);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
  }
  .nav-services.is-open .services-submenu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .service-menu-link {
    display: grid;
    gap: 3px;
    min-height: 58px;
    padding: 12px 14px;
    align-content: center;
    border-radius: 12px;
    color: var(--ink);
  }
  .service-menu-link:hover,
  .service-menu-link:focus-visible { background: var(--canvas); }
  .service-menu-title { font-size: 17px; font-weight: 700; }
  .service-menu-subtitle { color: var(--ink-muted); font-size: 15px; line-height: 1.35; }
  .nav-cta-wrap { margin-left: 8px; }
  .nav-toggle { display: none; border: 0; background: transparent; color: var(--ink); cursor: pointer; flex: none; }

  @media (max-width: 1023px) {
    .header-wrap { padding: 18px 16px 0; }
    .nav-bar { position: relative; padding: 9px 9px 9px 18px; }
    .nav-toggle { display: flex; width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: var(--radius-md); }
    .nav-toggle:hover { background: rgba(244, 246, 255, .12); }
    .nav-links-row {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: none;
      padding: 12px;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      border: 1px solid var(--line-soft);
      border-radius: 24px;
      background: var(--surface);
      box-shadow: 0 1px 2px rgba(10, 12, 26, .04), 0 20px 40px -16px rgba(10, 12, 26, .3);
    }
    .nav-links-row.nav-open { display: block; }
    .nav-list { flex-direction: column; align-items: stretch; }
    .nav-link { width: 100%; padding: 14px; text-align: center; }
    .nav-services { width: 100%; }
    .nav-services-trigger { justify-content: center; }
    .services-submenu {
      position: static;
      display: none;
      width: 100%;
      margin-top: 2px;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav-services.is-open .services-submenu { display: grid; transform: none; }
    .service-menu-link { text-align: left; }
    .nav-cta-wrap { width: 100%; margin-top: 6px; margin-left: 0; }
    .nav-cta-wrap :global(.btn) { width: 100%; }
  }
</style>

<script>
  const servicesMenu = document.querySelector<HTMLElement>('[data-services-menu]');
  const servicesToggle = servicesMenu?.querySelector<HTMLButtonElement>('[data-services-toggle]');

  const setServicesMenu = (open: boolean) => {
    if (!servicesMenu || !servicesToggle) return;
    servicesMenu.classList.toggle('is-open', open);
    servicesToggle.setAttribute('aria-expanded', String(open));
  };

  servicesToggle?.addEventListener('click', () => {
    setServicesMenu(servicesToggle.getAttribute('aria-expanded') !== 'true');
  });

  servicesMenu?.querySelectorAll<HTMLAnchorElement>('.service-menu-link').forEach((link) => {
    link.addEventListener('click', () => setServicesMenu(false));
  });

  servicesMenu?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!servicesMenu.contains(document.activeElement)) setServicesMenu(false);
    });
  });

  document.addEventListener('click', (event) => {
    if (!servicesMenu?.classList.contains('is-open')) return;
    if (!servicesMenu.contains(event.target as Node)) setServicesMenu(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !servicesMenu?.classList.contains('is-open')) return;
    setServicesMenu(false);
    servicesToggle?.focus();
  });
</script>
