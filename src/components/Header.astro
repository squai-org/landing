---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { navLinks } from '../data/landing';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header-wrap over-hero" data-header>
  <div class="nav-bar">
    <a href="/" class="logo-link" aria-label="Squai — inicio">
      <Logo size={34} />
    </a>
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <nav id="site-nav" class="nav-links-row" data-nav-menu aria-label="Principal">
      {
        navLinks.map((link) => (
          <a
            href={`/#${link.target}`}
            data-scroll-to={link.target}
            data-nav-section={link.target}
            class="nav-link"
          >
            {link.label}
          </a>
        ))
      }
      <div class="nav-cta-wrap">
        <Button variant="primary" href="/servicios/squai-one#lista" compact class="nav-cta" aria-current={currentPath === '/servicios/squai-one' ? 'page' : undefined}>Lista de espera</Button>
      </div>
    </nav>
  </div>
</header>

<style>
  .header-wrap { position: fixed; inset: 0 0 auto; z-index: 60; padding: 30px 24px 0; }
  .nav-bar {
    display: flex;
    max-width: 1120px;
    margin: 0 auto;
    padding: 9px 10px 9px 24px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 2px rgba(13, 27, 42, .04), 0 14px 34px -22px rgba(13, 27, 42, .28);
  }
  .nav-links-row { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    padding: 9px 14px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    cursor: pointer;
    font-size: 17px;
    font-weight: 600;
  }
  .nav-cta-wrap { margin-left: 8px; }
  .nav-toggle { display: none; border: 0; background: transparent; color: var(--ink); cursor: pointer; flex: none; }

  @media (max-width: 1023px) {
    .header-wrap { padding: 18px 16px 0; }
    .nav-bar { position: relative; padding: 9px 9px 9px 18px; }
    .nav-toggle { display: flex; width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: var(--radius-md); }
    .nav-toggle:hover { background: rgba(244, 246, 255, .12); }
    .nav-links-row {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: none;
      padding: 12px;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      border: 1px solid var(--line-soft);
      border-radius: 24px;
      background: var(--surface);
      box-shadow: 0 1px 2px rgba(10, 12, 26, .04), 0 20px 40px -16px rgba(10, 12, 26, .3);
    }
    .nav-links-row.nav-open { display: flex; }
    .nav-link { width: 100%; padding: 14px; text-align: center; }
    .nav-cta-wrap { width: 100%; margin-top: 6px; margin-left: 0; }
    .nav-cta-wrap :global(.btn) { width: 100%; }
  }
</style>
