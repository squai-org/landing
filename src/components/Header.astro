---
import Logo from './Logo.astro';
import Block from './Block.astro';
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
import { getSiteContent } from '../lib/content';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const { navLinks, services, ui } = await getSiteContent();

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const serviceLinks = services.map((service) => ({ name: service.name, subtitle: service.menuAudience, href: `/servicios/${service.slug}` }));
const navModal = currentPath === '/servicios/squai-grow' ? 'grow' : currentPath === '/servicios/squai-learn' ? 'learn' : undefined;
const isSquaiOne = currentPath === '/servicios/squai-one';
const ctaVariant = tone === 'dark' ? 'white' : 'dark';
const toggleVariant = tone === 'dark' ? 'white' : 'dark';
---

<header class="site-header" data-header data-tone={tone} data-scrolled="false">
  <div class="site-header-row" data-header-row>
    <a href="/" class="logo-link" aria-label={ui.navigation.home}>
      <Logo size={34} />
    </a>

    <button
      type="button"
      class={`btn btn-${toggleVariant} btn-split btn-compact nav-toggle`}
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-label={ui.navigation.menuLabel}
      data-close-label={ui.navigation.closeLabel}
    >
      <span class="btn-text"><span class="btn-label" data-nav-toggle-label>{ui.navigation.menuLabel}</span></span>
      <span class="btn-arrow" aria-hidden="true">
        <svg class="nav-toggle-icon nav-toggle-icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="nav-toggle-icon nav-toggle-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav-menu aria-label={ui.navigation.main}>
      <div class="site-nav-panel">
        <ul class="site-nav-list">
          {
            navLinks.map((link) =>
              link.target === 'servicios' ? (
                <li class="nav-services" data-services-menu>
                  <div class="nav-services-group">
                    <a
                      href="/#servicios"
                      data-scroll-to={link.target}
                      data-nav-section={link.target}
                      class="nav-pill nav-services-link"
                      aria-current={currentPath.startsWith('/servicios') ? 'page' : undefined}
                    >
                      <span class="nav-pill-label">{link.label}</span>
                    </a>
                    <span class="nav-pill-blocks" aria-hidden="true">
                      <span class="nav-pill-block nav-pill-block-a"><Block /></span>
                      <span class="nav-pill-block nav-pill-block-b"><Block /></span>
                    </span>
                    <button
                      type="button"
                      class="nav-services-toggle"
                      data-services-toggle
                      aria-expanded="false"
                      aria-controls="services-submenu"
                      aria-label={ui.navigation.servicesSubmenu}
                    >
                      <svg class="nav-services-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </button>
                  </div>
                  <ul id="services-submenu" class="services-submenu" data-services-submenu>
                    {serviceLinks.map((service) => (
                      <li>
                        <a href={service.href} class="service-menu-link" aria-current={currentPath === service.href ? 'page' : undefined}>
                          <span class="service-menu-title">{service.name}</span>
                          <span class="service-menu-subtitle">{service.subtitle}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="nav-item">
                  <a href={`/#${link.target}`} data-scroll-to={link.target} data-nav-section={link.target} class="nav-pill">
                    <span class="nav-pill-label">{link.label}</span>
                  </a>
                  <span class="nav-pill-blocks" aria-hidden="true">
                    <span class="nav-pill-block nav-pill-block-a"><Block /></span>
                    <span class="nav-pill-block nav-pill-block-b"><Block /></span>
                  </span>
                </li>
              )
            )
          }
          <li class="nav-cta-wrap">
            {
              navModal ? (
                <Button variant={ctaVariant} arrow compact data-open-modal={navModal} class="nav-cta">
                  {ui.navigation.contactCta}
                </Button>
              ) : isSquaiOne ? (
                <Button variant={ctaVariant} arrow compact href="#inscripcion" data-scroll-to="inscripcion" class="nav-cta">
                  {ui.navigation.oneCta}
                </Button>
              ) : (
                <Button
                  variant={ctaVariant}
                  arrow
                  compact
                  href="/#servicios"
                  data-scroll-to="servicios"
                  class="nav-cta"
                  aria-current={currentPath.startsWith('/servicios') ? 'page' : undefined}
                >
                  {ui.navigation.program}
                </Button>
              )
            }
          </li>
        </ul>
        <div class="site-nav-social"><SocialLinks /></div>
      </div>
    </nav>

    <div class="site-header-social"><SocialLinks /></div>
  </div>
</header>

<style>
  .site-header {
    --header-ink: var(--midnight);
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding: max(16px, 1.6vw) var(--gutter) 0;
    pointer-events: none;
  }
  .site-header-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .site-header-row > * { pointer-events: auto; }

  .logo-link {
    --wordmark-color: var(--header-ink);
    --logo-mark: currentColor;
    --logo-block: currentColor;
    color: var(--header-ink);
    padding: 6px 0;
    border-radius: var(--radius-pill);
    transition: background-color var(--duration-base) var(--ease-out), padding var(--duration-base) var(--ease-out);
  }
  .site-header[data-scrolled='true'] .logo-link,
  .site-header[data-tone='dark'] .logo-link {
    --wordmark-color: var(--midnight);
    --logo-mark: initial;
    --logo-block: initial;
    padding: 8px 18px;
    background: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--line-soft), 0 8px 20px -12px rgba(10, 12, 26, .35);
  }
  .logo-link:focus-visible { border-radius: var(--radius-pill); }

  .nav-toggle { display: none; position: relative; z-index: 2; flex: none; }
  .nav-toggle-icon { display: block; width: 20px; height: 20px; }
  .nav-toggle-icon-close { display: none; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-icon-menu { display: none; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-icon-close { display: block; }

  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav-social { display: none; }

  .nav-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-height-compact);
    padding: 0 18px;
    border-radius: var(--radius-pill);
    background: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--line-soft), 0 8px 20px -14px rgba(10, 12, 26, .4);
    color: var(--midnight);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    white-space: nowrap;
    transition: background-color var(--duration-fast) ease, transform var(--duration-slow) var(--ease-overshoot);
  }
  .nav-pill:hover { background: var(--surface); color: var(--midnight); }
  .nav-pill-label { position: relative; z-index: 1; }
  .nav-item, .nav-services-group { position: relative; }
  .nav-pill-block {
    position: absolute;
    z-index: -1;
    display: none;
    color: var(--accent-soft-strong);
  }
  .nav-pill-block-a { top: -12px; left: -10px; width: 30px; height: 30px; rotate: -22deg; }
  .nav-pill-block-b { right: -9px; bottom: -11px; width: 26px; height: 26px; rotate: 18deg; }
  .nav-pill[aria-current] ~ .nav-pill-blocks .nav-pill-block { display: block; }

  .nav-services { position: relative; display: inline-flex; align-items: center; }
  .nav-services-group { display: inline-flex; align-items: center; }
  .nav-services-link { padding-right: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; }
  .nav-services-toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    min-height: var(--control-height-compact);
    margin-left: 1px;
    padding: 0;
    border: 0;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    background: var(--canvas);
    box-shadow: inset 0 0 0 1px var(--line-soft), 0 8px 20px -14px rgba(10, 12, 26, .4);
    color: var(--midnight);
    cursor: pointer;
    transition: background-color var(--duration-fast) ease;
  }
  .nav-services-toggle:hover { background: var(--surface); }
  .nav-services-chevron { flex: none; transition: transform .18s ease; }
  .nav-services.is-open .nav-services-chevron { transform: rotate(180deg); }
  .services-submenu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 2;
    display: grid;
    width: 232px;
    margin: 0;
    padding: 10px;
    border-radius: 24px;
    background: var(--canvas);
    list-style: none;
    box-shadow: var(--shadow-float);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
  }
  .nav-services.is-open .services-submenu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .service-menu-link {
    display: grid;
    gap: 3px;
    min-height: 58px;
    padding: 12px 14px;
    align-content: center;
    border-radius: 16px;
    color: var(--midnight);
  }
  .service-menu-link:hover { background: var(--surface); color: var(--midnight); }
  .service-menu-link[aria-current] { background: var(--accent-soft); }
  .service-menu-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -0.015em; }
  .service-menu-subtitle { color: var(--ink-muted); font-size: 15px; line-height: 1.35; }

  .site-header-social {
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out), visibility var(--duration-base);
  }
  .site-header[data-scrolled='true'] .site-header-social {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-24px);
  }

  @keyframes pill-block-in {
    from { scale: .3; opacity: 0; }
    to { scale: 1; opacity: 1; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .nav-pill:hover { transform: scale(1.04, 1.08); }
    .nav-pill[aria-current] ~ .nav-pill-blocks .nav-pill-block { animation: pill-block-in var(--duration-slow) var(--ease-overshoot) both; }
    .nav-pill[aria-current] ~ .nav-pill-blocks .nav-pill-block-b { animation-delay: .08s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-link, .nav-pill, .nav-services-chevron, .services-submenu, .site-header-social { transition: none; }
  }

  .nav-cta-wrap :global(.btn-label) { white-space: nowrap; }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .site-nav-list { gap: 8px; }
    .nav-pill { padding: 0 13px; font-size: 16px; }
    .nav-services-link { padding-right: 8px; }
    .nav-services-toggle { width: 32px; }
    .site-header-social { display: none; }
  }

  @media (max-width: 1023px) {
    .nav-toggle { display: inline-flex; }
    .site-header-social { display: none; }
    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: none;
      padding: 84px 12px 12px;
      overflow-y: auto;
      background: rgba(10, 12, 26, .45);
      backdrop-filter: blur(6px);
      pointer-events: auto;
    }
    .site-nav.nav-open { display: block; }
    .site-nav-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
      max-width: 560px;
      margin: 0 auto;
      padding: 20px;
      border-radius: var(--radius-xl);
      background: var(--accent-soft);
      box-shadow: var(--shadow-float);
    }
    .site-nav-list { flex-direction: column; align-items: stretch; gap: 10px; }
    .nav-pill {
      display: flex;
      justify-content: flex-start;
      min-height: 56px;
      padding: 0 22px;
      border-radius: 18px;
      background: var(--surface);
      box-shadow: none;
      font-size: 20px;
    }
    .nav-pill:hover { transform: none; }
    .nav-pill-blocks { display: none; }
    .nav-pill[aria-current] { box-shadow: inset 0 0 0 2px var(--accent-ink); }
    .nav-services { flex-direction: column; align-items: stretch; }
    .nav-services-group { display: block; }
    .nav-services-link { display: flex; border-radius: 18px; padding-right: 22px; }
    .nav-services-toggle { display: none; }
    .services-submenu {
      position: static;
      width: 100%;
      margin-top: 6px;
      padding: 0 0 0 12px;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      gap: 6px;
    }
    .service-menu-link { min-height: 52px; background: rgba(255, 255, 255, .6); }
    .nav-cta-wrap :global(.btn) { width: 100%; }
    .nav-cta-wrap :global(.btn-text) { flex: 1; }
    .site-nav-social { display: flex; justify-content: center; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const navMenu = document.querySelector<HTMLElement>('[data-nav-menu]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-nav-toggle-label]');
  const servicesMenu = document.querySelector<HTMLElement>('[data-services-menu]');
  const servicesToggle = servicesMenu?.querySelector<HTMLButtonElement>('[data-services-toggle]');

  const SCROLLED_AFTER = 70;
  let scrollTicking = false;
  const syncScrolled = () => {
    header?.setAttribute('data-scrolled', String(window.scrollY > SCROLLED_AFTER));
    scrollTicking = false;
  };
  syncScrolled();
  window.addEventListener(
    'scroll',
    () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(syncScrolled);
    },
    { passive: true }
  );

  const setServicesMenu = (open: boolean) => {
    if (!servicesMenu || !servicesToggle) return;
    servicesMenu.classList.toggle('is-open', open);
    servicesToggle.setAttribute('aria-expanded', String(open));
  };

  servicesToggle?.addEventListener('click', () => {
    setServicesMenu(servicesToggle.getAttribute('aria-expanded') !== 'true');
  });
  servicesMenu?.querySelectorAll<HTMLAnchorElement>('.service-menu-link').forEach((link) => {
    link.addEventListener('click', () => setServicesMenu(false));
  });
  servicesMenu?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!servicesMenu.contains(document.activeElement)) setServicesMenu(false);
    });
  });
  document.addEventListener('click', (event) => {
    if (!servicesMenu?.classList.contains('is-open')) return;
    if (!servicesMenu.contains(event.target as Node)) setServicesMenu(false);
  });

  const isNavOpen = () => navMenu?.classList.contains('nav-open') ?? false;

  const setNavOpen = (open: boolean) => {
    if (!navMenu || !navToggle) return;
    navMenu.classList.toggle('nav-open', open);
    navToggle.setAttribute('aria-expanded', String(open));
    if (toggleLabel) toggleLabel.textContent = open ? navToggle.dataset.closeLabel! : navToggle.dataset.menuLabel!;
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  navToggle?.addEventListener('click', () => setNavOpen(!isNavOpen()));
  navMenu?.querySelectorAll('a, button').forEach((el) => {
    el.addEventListener('click', () => {
      if (el instanceof HTMLButtonElement && el.hasAttribute('data-services-toggle')) return;
      setNavOpen(false);
    });
  });
  navMenu?.addEventListener('click', (event) => {
    if (event.target === navMenu) setNavOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (servicesMenu?.classList.contains('is-open')) {
        setServicesMenu(false);
        servicesToggle?.focus();
        return;
      }
      if (isNavOpen()) {
        setNavOpen(false);
        navToggle?.focus();
      }
      return;
    }
    if (event.key !== 'Tab' || !isNavOpen() || !navMenu || !navToggle) return;
    const stops = [navToggle, ...Array.from(navMenu.querySelectorAll<HTMLElement>('a[href], button'))].filter(
      (el) => el.offsetParent !== null
    );
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setNavOpen(false);
  });
</script>
