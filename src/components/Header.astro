---
import Logo from './Logo.astro';
import { navLinks } from '../data/landing';
---

<div class="header-wrap" style="position:sticky;top:0;z-index:60;padding:26px 24px 0;margin-bottom:-80px">
  <div
    class="nav-bar"
    style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:9px 10px 9px 24px;backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.12);border-radius:100px;box-shadow:0 1px 2px rgba(10,12,26,.16), 0 18px 40px -24px rgba(10,12,26,.6);background-color:rgba(18,22,42,.72)"
  >
    <a href="/" class="logo-link" aria-label="Squai — inicio" style="--wordmark-color:#F4F6FF">
      <Logo height={34} />
    </a>
    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="site-nav"
      style="color:#F4F6FF"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
    <div id="site-nav" class="nav-links-row" data-nav-menu style="display:flex;align-items:center;gap:2px">
      {
        navLinks.map((link) => (
          <a
            href={`/#${link.target}`}
            data-scroll-to={link.target}
            class="nav-link"
            style="font-size:14px;font-weight:600;color:#D7DBEC;cursor:pointer;padding:9px 14px;border-radius:100px"
          >
            {link.label}
          </a>
        ))
      }
      <div class="nav-cta-wrap" style="margin-left:8px">
        <a
          href="/#lista"
          data-scroll-to="lista"
          class="btn-gold"
          style="display:inline-block;font-family:var(--font-display);font-size:14px;font-weight:700;letter-spacing:-0.01em;color:#0A0C1A;background:#F9C24D;border:0;border-radius:100px;padding:12px 22px;cursor:pointer"
        >
          Reservar mi lugar
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* On small screens the menu drops onto a light panel, so its links flip to ink. */
  @media (max-width: 1023px) {
    .nav-links-row .nav-link { color: var(--ink-body) !important; }
  }
</style>
