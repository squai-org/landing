---
import Logo from './Logo.astro';
import { navLinks } from '../data/landing';
---

<div style="position:sticky;top:0;z-index:60;padding:26px 24px 0;margin-bottom:-76px">
  <div
    style="max-width: 1120px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 9px 10px 9px 24px; backdrop-filter: blur(16px); border: 1px solid rgba(13,27,42,.07); border-radius: 100px; box-shadow: 0 1px 2px rgba(13,27,42,.04), 0 14px 34px -22px rgba(13,27,42,.28); background-color: #FFFFFF77"
  >
    <Logo height={30} />
    <div style="display:flex;align-items:center;gap:4px">
      {
        navLinks.map((link) => (
          <a
            href={`#${link.target}`}
            data-scroll-to={link.target}
            class="nav-link"
            style="font-size:14px;font-weight:600;color:#333;cursor:pointer;padding:9px 14px;border-radius:100px"
          >
            {link.label}
          </a>
        ))
      }
      <div style="margin-left:8px">
        <button
          data-scroll-to="precio"
          class="btn-gold"
          style="font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;color:#3B2B05;background:linear-gradient(180deg, #F7D96A 0%, #EFC13C 100%);border:0;border-radius:100px;padding:12px 22px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.75), inset 0 0 0 1px rgba(255,255,255,.35), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(196,144,24,.6)"
        >
          Inscribirme
        </button>
      </div>
    </div>
  </div>
</div>
