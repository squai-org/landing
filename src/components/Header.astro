---
import Logo from './Logo.astro';
import Button from './Button.astro';
import DriftBlock from './DriftBlock.astro';
import SocialLinks from './SocialLinks.astro';
import { getSiteContent } from '../lib/content';
import { pillBlockPresets } from '../lib/pill-blocks';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const { navLinks, services, ui } = await getSiteContent();

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const serviceLinks = services.map((service) => ({ name: service.name, subtitle: service.menuAudience, href: `/servicios/${service.slug}` }));
const navModal = currentPath === '/servicios/squai-grow' ? 'grow' : currentPath === '/servicios/squai-learn' ? 'learn' : undefined;
const isSquaiOne = currentPath === '/servicios/squai-one';
const serviceNav = services.find((service) => currentPath === `/servicios/${service.slug}`)?.nav;
const ctaVariant = tone === 'dark' ? 'white' : 'dark';
const toggleVariant = tone === 'dark' ? 'white' : 'dark';
const pagePills = serviceNav
  ? serviceNav.items.map((item) => ({ label: item.label, target: item.target, href: `#${item.target}`, services: false }))
  : navLinks.map((link) => ({ label: link.label, target: link.target, href: `/#${link.target}`, services: link.target === 'servicios' }));
---

<header class="site-header" data-header data-tone={tone} data-scrolled="false">
  <div class="site-header-row" data-header-row>
    <div class="header-brand">
      <a href="/" class="logo-link logo-pill" aria-label={ui.navigation.home}>
        <Logo size={46} />
      </a>
    </div>

    <button
      type="button"
      class={`btn btn-${toggleVariant} btn-split nav-toggle`}
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-label={ui.navigation.menuLabel}
      data-close-label={ui.navigation.closeLabel}
    >
      <span class="btn-text">
        <span class="btn-bg" aria-hidden="true"></span>
        <span class="btn-text-outer"><span class="btn-label" data-split-text data-nav-toggle-label>{ui.navigation.menuLabel}</span></span>
      </span>
      <span class="btn-arrow" aria-hidden="true">
        <span class="btn-bg"></span>
        <span class="btn-icon">
          <svg class="nav-toggle-icon nav-toggle-icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 12h16" /><path d="M4 18h16" /><path d="M4 6h16" />
          </svg>
          <svg class="nav-toggle-icon nav-toggle-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" /><path d="m6 6 12 12" />
          </svg>
        </span>
      </span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav-menu aria-label={ui.navigation.main}>
      <div class="site-nav-panel" data-nav-panel>
        <ul class="site-nav-list">
          {
            pagePills.map((pill, index) => {
              const blocks = pillBlockPresets[index % pillBlockPresets.length];
              const link = (
                <a
                  href={pill.services ? '/#servicios' : pill.href}
                  data-scroll-to={pill.target}
                  data-nav-section={pill.target}
                  class:list={['pill-button', 'nav-pill', { 'nav-services-link': pill.services }]}
                  aria-current={pill.services && currentPath.startsWith('/servicios') ? 'page' : undefined}
                >
                  <span class="nav-pill-blocks" aria-hidden="true">
                    {blocks.map((block) => (
                      <DriftBlock {...block} />
                    ))}
                  </span>
                  <span class="pill-button-bg" aria-hidden="true"></span>
                  <span class="pill-button-label"><span data-split-text>{pill.label}</span></span>
                </a>
              );
              return pill.services ? (
                <li class="nav-item nav-services" data-services-menu>
                  <div class="nav-services-group">
                    {link}
                    <button
                      type="button"
                      class="nav-services-toggle"
                      data-services-toggle
                      aria-expanded="false"
                      aria-controls="services-submenu"
                      aria-label={ui.navigation.servicesSubmenu}
                    >
                      <svg class="nav-services-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6"></path>
                      </svg>
                    </button>
                  </div>
                  <ul id="services-submenu" class="services-submenu" data-services-submenu>
                    {serviceLinks.map((service) => (
                      <li>
                        <a href={service.href} class="service-menu-link" aria-current={currentPath === service.href ? 'page' : undefined}>
                          <span class="service-menu-title">{service.name}</span>
                          <span class="service-menu-subtitle">{service.subtitle}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li class="nav-item">{link}</li>
              );
            })
          }
          <li class="nav-cta-wrap">
            {
              navModal ? (
                <Button variant={ctaVariant} arrow data-open-modal={navModal} class="nav-cta">
                  {ui.navigation.contactCta}
                </Button>
              ) : isSquaiOne ? (
                <Button variant={ctaVariant} arrow href="#inscripcion" data-scroll-to="inscripcion" class="nav-cta">
                  {ui.navigation.oneCta}
                </Button>
              ) : (
                <Button
                  variant={ctaVariant}
                  arrow
                  href="/#servicios"
                  data-scroll-to="servicios"
                  class="nav-cta"
                  aria-current={currentPath.startsWith('/servicios') ? 'page' : undefined}
                >
                  {ui.navigation.program}
                </Button>
              )
            }
          </li>
        </ul>
        <div class="site-nav-social">
          {
            serviceNav && (
              <a href="/" class="pill-button company-pill">
                <span class="pill-button-bg" aria-hidden="true"></span>
                <span class="pill-button-label"><span data-split-text>{serviceNav.companyLabel}</span></span>
              </a>
            )
          }
          <SocialLinks surface="white" />
        </div>
      </div>
    </nav>

    <div class="site-header-social">
      <ul class="site-header-list">
        {
          serviceNav && (
            <li>
              <a href="/" class="pill-button company-pill">
                <span class="pill-button-bg" aria-hidden="true"></span>
                <span class="pill-button-label"><span data-split-text>{serviceNav.companyLabel}</span></span>
              </a>
            </li>
          )
        }
        <li class="site-header-socials"><SocialLinks /></li>
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding: var(--header-pt) var(--gutter) 0;
    pointer-events: none;
  }
  .site-header-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .site-header-row > * { pointer-events: auto; }

  .header-brand { position: relative; z-index: 2; display: flex; align-items: center; }
  .logo-pill {
    --wordmark-color: var(--midnight);
    --logo-size: calc(var(--pill-h) * 0.742);
    justify-content: center;
    height: var(--pill-h);
    padding: 0 calc(var(--pill-h) * 0.258);
    border-radius: 9999px;
    background: var(--canvas);
    color: var(--midnight);
    white-space: nowrap;
  }
  .logo-pill:hover { color: var(--midnight); }
  .logo-pill:focus-visible { outline-offset: 4px; }

  .nav-toggle { display: none; position: relative; z-index: 2; }
  .nav-toggle-icon { display: block; width: 16px; height: 16px; }
  .btn-icon .nav-toggle-icon { width: 16px; height: 16px; }
  .nav-toggle-icon-close { display: none; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-icon-menu { display: none; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-icon-close { display: block; }

  .site-nav-list {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav-social { display: none; }
  .nav-item { position: relative; z-index: 0; }
  .nav-item:has(.nav-pill[aria-current]) { z-index: 1; }
  .nav-cta-wrap { position: relative; z-index: 1; padding-left: 6px; }

  .nav-pill-blocks {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: none;
    pointer-events: none;
    user-select: none;
  }
  .nav-pill[aria-current] .nav-pill-blocks { display: block; }
  .nav-pill-blocks :global(.drift-block) { color: var(--accent-soft-strong); }

  .nav-services-group { position: relative; display: inline-flex; align-items: center; gap: 4px; }
  .nav-services-toggle {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--pill-h);
    height: var(--pill-h);
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: var(--canvas);
    color: var(--midnight);
    cursor: pointer;
  }
  .nav-services-chevron { flex: none; transition: transform .18s ease; }
  .nav-services.is-open .nav-services-chevron { transform: rotate(180deg); }
  .services-submenu {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 2;
    display: grid;
    width: 232px;
    margin: 0;
    padding: 10px;
    border-radius: 24px;
    background: var(--canvas);
    list-style: none;
    box-shadow: var(--shadow-float);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -4px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
  }
  .nav-services.is-open .services-submenu { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .service-menu-link {
    display: grid;
    gap: 3px;
    min-height: 58px;
    padding: 12px 14px;
    align-content: center;
    border-radius: 16px;
    color: var(--midnight);
  }
  .service-menu-link:hover { background: var(--surface); color: var(--midnight); }
  .service-menu-link[aria-current] { background: var(--accent-soft); }
  .service-menu-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -0.015em; }
  .service-menu-subtitle { color: var(--ink-muted); font-size: 15px; line-height: 1.35; }

  .site-header-social {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    transition:
      translate .3s var(--ease-smooth),
      opacity .3s var(--ease-smooth),
      visibility .3s;
  }
  .site-header-list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header-socials { display: flex; align-items: center; }
  .site-header-social :global(.social-links > li) { display: flex; }
  .site-header-social :global(.social-button) { width: var(--pill-h); height: var(--pill-h); }
  .site-header[data-scrolled='true'] .site-header-social {
    translate: 0 -96px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .site-nav-list > li,
    .site-header-list > li { display: flex; align-items: center; }
    .header-brand,
    .site-header-social { flex: 0 1 240px; }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .site-nav-list { gap: 8px; }
  }

  @media (min-width: 1280px) {
    .site-header-social { min-width: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-services-chevron, .services-submenu, .site-header-social { transition: none; }
  }

  @media (max-width: 1023px) {
    .nav-toggle { display: inline-flex; }
    .site-header-social { display: none; }
    .site-nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: none;
      flex-direction: column;
      justify-content: flex-start;
      padding: 96px 12px 12px;
      overflow-y: auto;
      background: rgb(10 12 26 / 0.45);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      pointer-events: auto;
    }
    .site-nav.nav-open { display: flex; }
    .site-nav-panel {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 20px;
      border-radius: 32px;
      background: var(--periwinkle-2);
      box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
      transform-origin: center;
    }
    .site-nav-list { flex-direction: column; align-items: stretch; gap: 10px; }
    .nav-item { z-index: auto; }
    .nav-pill {
      display: block;
      height: auto;
      padding: 14px 20px;
      border-radius: 16px;
      background: var(--surface);
      font-size: 20px;
      line-height: 1.4;
      letter-spacing: -0.02em;
    }
    .nav-pill:active { scale: none; }
    .nav-pill .pill-button-bg,
    .nav-pill-blocks,
    .nav-pill[aria-current] .nav-pill-blocks { display: none; }
    .nav-pill .pill-button-label { display: block; padding: 0; }
    .nav-services { display: flex; flex-direction: column; align-items: stretch; }
    .nav-services-group { display: block; }
    .nav-services-toggle { display: none; }
    .services-submenu {
      position: static;
      width: 100%;
      margin-top: 10px;
      padding: 0 0 0 12px;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      gap: 10px;
    }
    .service-menu-link { min-height: 52px; background: rgb(255 255 255 / 0.6); }
    .nav-cta-wrap { padding: 8px 0 0; }
    .nav-cta-wrap :global(.btn) { width: 100%; }
    .nav-cta-wrap :global(.btn-text) { flex: 1; }
    .site-nav-social {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding-top: 12px;
    }
    .site-nav-social .company-pill { --pill-bg: var(--surface); }
  }
</style>

<script>
  import { animateIn, animateOut, tweens } from '../lib/motion';

  const header = document.querySelector<HTMLElement>('[data-header]');
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const navMenu = document.querySelector<HTMLElement>('[data-nav-menu]');
  const navPanel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-nav-toggle-label]');
  const servicesMenu = document.querySelector<HTMLElement>('[data-services-menu]');
  const servicesToggle = servicesMenu?.querySelector<HTMLButtonElement>('[data-services-toggle]');
  const mobileQuery = window.matchMedia('(max-width: 1023px)');

  const SCROLLED_AFTER = 70;
  let scrollTicking = false;
  const syncScrolled = () => {
    header?.setAttribute('data-scrolled', String(window.scrollY > SCROLLED_AFTER));
    scrollTicking = false;
  };
  syncScrolled();
  window.addEventListener(
    'scroll',
    () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(syncScrolled);
    },
    { passive: true }
  );

  const setServicesMenu = (open: boolean) => {
    if (!servicesMenu || !servicesToggle) return;
    servicesMenu.classList.toggle('is-open', open);
    servicesToggle.setAttribute('aria-expanded', String(open));
  };

  servicesToggle?.addEventListener('click', () => {
    setServicesMenu(servicesToggle.getAttribute('aria-expanded') !== 'true');
  });
  servicesMenu?.querySelectorAll<HTMLAnchorElement>('.service-menu-link').forEach((link) => {
    link.addEventListener('click', () => setServicesMenu(false));
  });
  servicesMenu?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!servicesMenu.contains(document.activeElement)) setServicesMenu(false);
    });
  });
  document.addEventListener('click', (event) => {
    if (!servicesMenu?.classList.contains('is-open')) return;
    if (!servicesMenu.contains(event.target as Node)) setServicesMenu(false);
  });

  const isNavOpen = () => navMenu?.classList.contains('nav-open') ?? false;
  let closing: Promise<unknown> | null = null;

  const setNavOpen = (open: boolean) => {
    if (!navMenu || !navToggle) return;
    if (open === isNavOpen() && !closing) return;
    navToggle.setAttribute('aria-expanded', String(open));
    if (toggleLabel) toggleLabel.textContent = open ? navToggle.dataset.closeLabel! : navToggle.dataset.menuLabel!;
    document.documentElement.style.overflow = open ? 'hidden' : '';

    if (open) {
      closing = null;
      navMenu.classList.add('nav-open');
      if (!mobileQuery.matches) return;
      animateIn(navMenu, { opacity: 0 }, { opacity: 1 }, tweens.menuOverlay);
      if (navPanel) animateIn(navPanel, { opacity: 0, scale: 0.92, y: -12 }, { opacity: 1, scale: 1, y: 0 }, tweens.menuPanel);
      return;
    }

    if (!mobileQuery.matches) {
      navMenu.classList.remove('nav-open');
      return;
    }
    const pending = Promise.race([
      Promise.all([
        animateOut(navMenu, { opacity: 0 }, tweens.menuOverlay),
        navPanel ? animateOut(navPanel, { opacity: 0, scale: 0.94, y: -12 }, tweens.menuPanel) : Promise.resolve(),
      ]),
      new Promise((resolve) => setTimeout(resolve, (tweens.menuPanel.duration + 0.05) * 1000)),
    ]);
    closing = pending;
    pending.then(() => {
      if (closing !== pending) return;
      closing = null;
      navMenu.classList.remove('nav-open');
    });
  };

  navToggle?.addEventListener('click', () => setNavOpen(!isNavOpen() || closing !== null));
  navMenu?.querySelectorAll('a, button').forEach((el) => {
    el.addEventListener('click', () => {
      if (el instanceof HTMLButtonElement && el.hasAttribute('data-services-toggle')) return;
      if (isNavOpen()) setNavOpen(false);
    });
  });
  navMenu?.addEventListener('click', (event) => {
    if (event.target === navMenu) setNavOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      if (servicesMenu?.classList.contains('is-open')) {
        setServicesMenu(false);
        servicesToggle?.focus();
        return;
      }
      if (isNavOpen()) {
        setNavOpen(false);
        navToggle?.focus();
      }
      return;
    }
    if (event.key !== 'Tab' || !isNavOpen() || !navMenu || !navToggle) return;
    const stops = [navToggle, ...Array.from(navMenu.querySelectorAll<HTMLElement>('a[href], button'))].filter(
      (el) => el.offsetParent !== null
    );
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (!event.matches || !navMenu) return;
    navToggle?.setAttribute('aria-expanded', 'false');
    if (toggleLabel && navToggle) toggleLabel.textContent = navToggle.dataset.menuLabel!;
    document.documentElement.style.overflow = '';
    navMenu.classList.remove('nav-open');
    navMenu.style.opacity = '';
    if (navPanel) {
      navPanel.style.opacity = '';
      navPanel.style.transform = '';
    }
  });
</script>
