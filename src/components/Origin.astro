---
import { originStory } from '../data/landing';
---

<div style="background:#F2C94C;border-radius:40px;padding:80px 64px">
  <div style="max-width:1080px;margin:0 auto;display:grid;grid-template-columns:0.8fr 1.2fr;gap:72px;align-items:start">
    <div style="position:sticky;top:120px;display:flex;flex-direction:column;gap:28px">
      <h2
        style="margin:0;font-family:'Urbanist',sans-serif;font-weight:900;font-size:46px;line-height:1.05;letter-spacing:-0.03em;color:#0D1B2A"
      >
        Cómo nace este programa
      </h2>
      <div
        style="background:#FFFFFF;border-radius:24px;padding:18px;box-shadow:0 1px 2px rgba(13,27,42,.05), 0 24px 50px -34px rgba(13,27,42,.5);display:flex;flex-direction:column;gap:14px"
      >
        <div style="display:flex;align-items:center;gap:7px">
          <span style="width:9px;height:9px;border-radius:50%;background:#F2C94C"></span>
          <span style="width:9px;height:9px;border-radius:50%;background:#44D4C8"></span>
          <span style="width:9px;height:9px;border-radius:50%;background:#C4CEFF"></span>
        </div>
        <div
          style="height:190px;border-radius:16px;background:#F4F6FF;display:flex;align-items:center;justify-content:center;border:1px dashed rgba(13,27,42,.16)"
        >
          <span style="font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#8892B0"
            >Ilustración / imagen</span
          >
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;padding:0 4px 4px">
          <span style="width:62%;height:9px;border-radius:100px;background:#DDE2F0"></span>
          <span style="width:88%;height:9px;border-radius:100px;background:#EFF1F8"></span>
          <span style="width:40%;height:9px;border-radius:100px;background:#EFF1F8"></span>
        </div>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:22px">
      {
        originStory.map((par) => (
          <p style="margin:0;font-size:17px;font-weight:300;line-height:1.75;color:#333;text-wrap:pretty">{par}</p>
        ))
      }
    </div>
  </div>
</div>
