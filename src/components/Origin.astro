---
import { getSiteContent } from '../lib/content';
const { originStory, labels } = await getSiteContent();
---

<section id="origen" class="section origin-section">
  <img class="brand-shape origin-shape" src="/images/shape-origin-light.svg" alt="" aria-hidden="true" />
  <div class="shell grid-sidebar origin-content">
    <h2 class="display d-h1 sidebar-sticky origin-title">{labels.origin}</h2>
    <div class="origin-copy-list">
      {originStory.map((para) => <p class="lead origin-copy">{para}</p>)}
    </div>
  </div>
</section>

<style>
  .origin-section {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--gold);
  }
  .origin-shape {
    position: absolute;
    z-index: 0;
    width: 61.596%;
    height: auto;
    left: -10.581%;
    top: -8.957%;
    transform: rotate(37.8deg);
    pointer-events: none;
    user-select: none;
  }
  .origin-content { position: relative; z-index: 1; display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: clamp(32px, 5vw, 80px); }
  .origin-title { position: sticky; top: 120px; color: var(--midnight); }
  .origin-copy-list { display: flex; flex-direction: column; gap: 20px; }
  .origin-copy { color: var(--midnight); opacity: .9; }

  @media (max-width: 900px) {
    .origin-content { grid-template-columns: 1fr; gap: clamp(24px, 4vw, 40px); }
    .origin-title { position: static; }
  }

</style>
