---
import { getSiteContent, type Service } from '../lib/content';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { cohort, labels } = await getSiteContent();
---

<!-- No background yet: the reference uses video, we do not have one. -->
<section class="service-hero" data-hero>
  <div class="shell service-hero-inner">
    <p class="service-crumb">
      <a href="/#servicios" class="service-crumb-link">{labels.services}</a>
      <span aria-hidden="true">→</span>
      <span>{service.name}.</span>
    </p>
    <div class="service-hero-heading">
      {
        service.slug === 'squai-one' && (
          <p class="service-hero-eyebrow">
            <span class="service-hero-eyebrow-dot" aria-hidden="true" />
            <span class="service-hero-eyebrow-status">{cohort.status}</span>
            <span class="service-hero-eyebrow-name">{cohort.name}</span>
          </p>
        )
      }
      <h1 class="display d-display service-name" style={`color:${service.accent}`}>{service.name}.</h1>
    </div>
    <p class="display d-h2 service-slogan">{service.slogan}</p>
  </div>
</section>

<style>
  .service-hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--midnight);
    border-radius: clamp(20px, 2vw, 36px);
    margin: var(--hero-inset);
    min-height: calc(100svh - var(--hero-inset) * 2);
    padding-block: calc(var(--nav-space) + var(--gutter) * 0.7) calc(var(--gutter) * 1.3);
  }
  .service-hero-inner {
    width: 100%;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: clamp(40px, 8vw, 120px);
  }
  .service-hero-heading { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 28px); }
  /* Same shape as Hero.astro's own eyebrow — carried over so the cohort
     status reads the same wherever it shows up. */
  .service-hero-eyebrow {
    display: inline-flex;
    align-self: flex-start;
    max-width: 100%;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 10px 22px;
    background: rgba(244, 246, 255, .92);
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
  }
  .service-hero-eyebrow-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--teal); }
  .service-hero-eyebrow-status {
    flex: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }
  .service-hero-eyebrow-name { min-width: 0; color: var(--ink-body); font-size: 14px; }
  .service-crumb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.3vw, 20px);
    letter-spacing: -0.02em;
    color: var(--canvas);
  }
  .service-crumb-link { color: var(--canvas); }
  .service-crumb-link:hover { color: var(--periwinkle); }
  .service-name { color: var(--canvas); font-size: max(40px, min(10.8vw, 19svh)); }
  .service-slogan { margin: 0; color: var(--canvas); max-width: 20ch; }
  /* Below desktop the full-height split leaves a dead middle, so the block
     settles at the bottom of a shorter panel instead. */
  @media (max-width: 900px) {
    .service-hero {
      min-height: min(72svh, calc(100svh - var(--hero-inset) * 2));
      padding-block: calc(var(--nav-space) + clamp(10px, 3svh, 40px)) clamp(28px, 6svh, 72px);
    }
    .service-hero-inner { justify-content: flex-end; gap: clamp(20px, 4svh, 48px); }
    .service-crumb { margin-bottom: auto; }
  }

  @media (max-width: 640px) {
    .service-hero { --nav-space: 84px; min-height: min(66svh, calc(100svh - var(--hero-inset) * 2)); }
    .service-slogan { max-width: 24ch; }
    .service-hero-eyebrow { flex-wrap: wrap; gap: 6px 10px; padding: 8px 16px; }
  }
</style>
