---
import { getSiteContent, type Service } from '../lib/content';
import Button from './Button.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const { program, labels, ui } = await getSiteContent();

const searchHeadings: Record<string, string> = {
  'squai-one': 'Programa en vivo para aprender inteligencia artificial',
  'squai-grow': 'Entrenamiento en inteligencia artificial para empresas y equipos',
  'squai-learn': 'Formación en inteligencia artificial para docentes, estudiantes y comunidades educativas',
};

const searchHeading = searchHeadings[service.slug];
---

<section class="service-hero" data-hero>
  <div class="shell service-hero-inner">
    <p class="service-crumb">
      <a href="/#servicios" class="service-crumb-link">{labels.services}</a>
      <span aria-hidden="true">→</span>
      <span>{service.name}.</span>
    </p>
    <div class="service-hero-heading">
      {
        service.slug === 'squai-one' && (
          <p class="service-hero-eyebrow">
            <span class="service-hero-eyebrow-dot" aria-hidden="true" />
            <span class="service-hero-eyebrow-status">{program.status}</span>
            <span class="service-hero-eyebrow-name">{program.name}</span>
          </p>
        )
      }
      <h1 class="service-name" style={`color:${service.accent}`}>
        <span class="display d-display service-brand">{service.name}.</span>
        {searchHeading && <span class="service-search-heading">{searchHeading}</span>}
      </h1>
    </div>
    <div class="service-hero-action">
      <p class="display d-h2 service-slogan">{service.slogan}</p>
      {
        service.slug === 'squai-one' ? (
          <Button variant="primary" href="#lista" data-scroll-to="lista" class="service-hero-cta">{ui.services.oneCta}</Button>
        ) : (
          <Button variant="primary" data-open-modal={service.cta.modal} class="service-hero-cta">{service.cta.label}</Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .service-hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--midnight);
    border-radius: clamp(20px, 2vw, 36px);
    margin: var(--hero-inset);
    min-height: calc(100svh - var(--hero-inset) * 2);
    padding-block: calc(var(--nav-space) + clamp(6px, 2svh, 44px)) clamp(18px, 7svh, 110px);
    overflow: hidden;
  }
  .service-hero-inner {
    width: 100%;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: clamp(12px, 3svh, 40px);
  }
  .service-hero-heading { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 28px); }
  .service-hero-eyebrow {
    display: inline-flex;
    align-self: flex-start;
    max-width: 100%;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 10px 22px;
    background: rgba(244, 246, 255, .92);
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
  }
  .service-hero-eyebrow-dot { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--teal); }
  .service-hero-eyebrow-status {
    flex: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }
  .service-hero-eyebrow-name { min-width: 0; color: var(--ink-body); font-size: 14px; }
  .service-crumb {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.3vw, 20px);
    letter-spacing: -0.02em;
    color: var(--canvas);
  }
  .service-crumb-link { color: var(--canvas); }
  .service-crumb-link:hover { color: var(--periwinkle); }
  .service-name { display: flex; margin: 0; flex-direction: column; align-items: flex-start; gap: 14px; color: var(--canvas); }
  .service-brand { color: inherit; font-size: max(40px, min(10.8vw, 19svh)); }
  .service-search-heading {
    max-width: 44ch;
    color: var(--canvas);
    font-family: var(--font-body);
    font-size: clamp(17px, 1.5vw, 23px);
    font-weight: 600;
    line-height: 1.35;
  }
  .service-slogan { margin: 0; color: var(--canvas); max-width: 20ch; }
  .service-hero-action { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(24px, 3vw, 40px); }

  @media (max-width: 900px) {
    .service-brand { font-size: max(40px, min(10.8vw, 12svh)); }
    .service-hero-action { gap: clamp(16px, 2.5svh, 24px); }
  }

  @media (max-height: 720px) {
    .service-hero {
      padding-block: calc(var(--nav-space) + 6px) 18px;
    }
    .service-hero-inner { gap: 12px; }
    .service-brand { font-size: max(40px, min(10.8vw, 12svh)); }
    .service-slogan { font-size: clamp(22px, 4svh, 34px); }
    .service-hero-action { gap: 12px; }
  }

  @media (max-width: 1023px) {
    .service-hero-eyebrow { padding: 8px 18px; gap: 10px; }
    .service-hero-eyebrow-status, .service-hero-eyebrow-name { font-size: 13px; }
  }

  @media (max-width: 640px) {
    .service-hero { --nav-space: 84px; }
    .service-slogan { max-width: 24ch; }
    .service-hero-cta { width: 100%; }
    .service-hero-eyebrow {
      flex-wrap: wrap;
      justify-content: center;
      text-align: center;
      gap: 6px 10px;
      padding: 8px 16px;
    }
  }
</style>
