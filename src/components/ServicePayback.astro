---
import Button from './Button.astro';
import { getSiteContent } from '../lib/content';

interface Props {
  headline: string;
  body: string[];
  cta: {
    label: string;
    target: string;
    modal: '' | 'grow' | 'learn';
  };
}

const { headline, body, cta } = Astro.props;
const { ui } = await getSiteContent();
---

<section class="section tint">
  <div class="shell payback-shell">
    <h2 class="display d-h1 payback-title">{ui.services.payback}</h2>
    <h3 class="display d-h2 payback-headline">{headline}</h3>
    <div class="payback-list">
      {body.map((paragraph) => <p class="lead payback-copy">{paragraph}</p>)}
    </div>
    <div class="payback-cta">
      {
        cta.modal ? (
          <Button variant="primary" data-open-modal={cta.modal}>{cta.label}</Button>
        ) : (
          <Button variant="primary" href={`#${cta.target}`}>{cta.label}</Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .payback-shell { display: grid; gap: clamp(28px, 3vw, 52px); }
  .payback-title, .payback-headline { color: var(--ink); }
  .payback-headline { max-width: 22ch; }
  .payback-list { display: flex; max-width: 74ch; flex-direction: column; gap: 20px; }
  .payback-copy { color: var(--ink-body); }
  .payback-cta { display: flex; align-items: center; }
</style>
