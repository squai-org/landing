---
import { cohort, endpoints } from '../data/landing';

const fieldStyle =
  'width:100%;font-family:var(--font-body);font-size:15px;color:#0A0C1A;background:#F4F6FF;border:1px solid #DCE1F0;border-radius:14px;padding:15px 18px;outline:none';
---

<div id="lista" class="section-pad" style="background:#F4F6FF;border-radius:40px;padding:88px 64px">
  <div style="max-width:920px;margin:0 auto;text-align:center">
    <h2
      class="h2-title"
      style="margin:0 0 14px;font-family:var(--font-display);font-weight:700;font-size:46px;line-height:1;letter-spacing:-0.05em;color:#0A0C1A;text-wrap:balance"
    >
      Reserva tu lugar en la próxima cohorte
    </h2>
    <p style="margin:0 auto 34px;font-size:17px;line-height:1.7;color:#4B5167;max-width:60ch;text-wrap:pretty">
      {cohort.seats}. Déjanos tus datos y te avisamos apenas se abra la inscripción, con las fechas confirmadas y la
      información de pago.
    </p>
    <form
      data-form="waitlist"
      data-endpoint={endpoints.waitlist}
      novalidate
      class="card-pad-lg"
      style="background:#FFFFFF;border:1px solid #DCE1F0;border-radius:32px;padding:32px;box-shadow:0 1px 2px rgba(10,12,26,.03), 0 30px 70px -44px rgba(10,12,26,.45);text-align:left"
    >
      <div class="field-grid-2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <label>
          <span class="sr-only">Nombre completo</span>
          <input type="text" name="full_name" required autocomplete="name" placeholder="Nombre completo" class="field" style={fieldStyle} />
        </label>
        <label>
          <span class="sr-only">Correo electrónico</span>
          <input type="email" name="email" required autocomplete="email" placeholder="Correo electrónico" class="field" style={fieldStyle} />
        </label>
      </div>
      <div class="field-grid-phone" style="display:grid;grid-template-columns:110px 1fr;gap:14px;margin-top:14px">
        <label>
          <span class="sr-only">Indicativo</span>
          <input type="text" name="country_code" required value="+57" autocomplete="tel-country-code" placeholder="+57" class="field" style={fieldStyle} />
        </label>
        <label>
          <span class="sr-only">Número de teléfono</span>
          <input type="tel" name="phone" required autocomplete="tel-national" placeholder="Número de teléfono" class="field" style={fieldStyle} />
        </label>
      </div>
      <button
        type="submit"
        class="btn-gold"
        style="width:100%;margin-top:18px;font-family:var(--font-body);font-size:17px;font-weight:700;color:#3B2B05;background:linear-gradient(180deg, #F7D96A 0%, #EFC13C 100%);border:0;border-radius:100px;padding:18px 24px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.75), inset 0 0 0 1px rgba(255,255,255,.35), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(196,144,24,.6)"
      >
        Reservar mi lugar
      </button>
      <div class="form-status" data-form-status role="status" aria-live="polite">
        Te avisaremos cuando se abra la inscripción.
      </div>
    </form>
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
