<div class="section-pad" style="background:#0A0C1A;border-radius:40px;padding:104px 64px">
  <div style="max-width:900px;margin:0 auto;display:flex;flex-direction:column;align-items:center;gap:24px;text-align:center">
    <div class="eyebrow eyebrow-night">Para cerrar</div>
    <h2
      class="h2-title-lg"
