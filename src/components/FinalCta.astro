---
import Button from './Button.astro';
import { getSiteContent } from '../lib/content';

const { ui, labels } = await getSiteContent();
---

<section class="section final-cta">
  <img class="brand-shape final-shape" src="/images/shape-final-dark.svg" alt="" aria-hidden="true" />
  <div class="shell grid-sidebar final-content">
    <h2 class="display d-h2 sidebar-sticky final-title">
      {ui.finalCta.title}
    </h2>
    <div class="final-copy-column">
      {ui.finalCta.body.map((paragraph) => <p class="lead final-copy">{paragraph}</p>)}
      <div class="final-action">
        <Button variant="white" href="/servicios/squai-one#lista">{labels.reserve}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta { position: relative; overflow: hidden; background: var(--teal); }
  .final-shape {
    position: absolute;
    z-index: 0;
    width: 77%;
    height: 162%;
    left: 44%;
    top: -35.5%;
    transform: rotate(-46.74deg);
    pointer-events: none;
    user-select: none;
  }
  .final-content { position: relative; z-index: 1; display: grid; grid-template-columns: .8fr 1.2fr; align-items: start; gap: clamp(32px, 5vw, 80px); }
  .final-title { position: sticky; top: 120px; max-width: 16ch; color: var(--midnight); }
  .final-copy-column { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .final-action { display: flex; align-self: stretch; justify-content: flex-end; margin-top: 12px; }
  .final-copy { color: var(--canvas); opacity: .9; }

  @media (max-width: 1023px) {
    .final-cta { background: var(--periwinkle); }
    .final-copy { color: var(--midnight); opacity: 1; }
    .final-action { justify-content: flex-start; }
  }
  @media (max-width: 900px) {
    .final-content { grid-template-columns: 1fr; gap: clamp(24px, 4vw, 40px); }
    .final-title { position: static; }
  }
</style>
