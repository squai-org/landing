---
import OneCornerBlocks from './OneCornerBlocks.astro';
import type { OneCornerPreset } from '../lib/one-corner-presets';
import '../styles/one-sections.css';

interface Props {
  title: string;
  lead?: string;
  quotes: { text: string; name: string; context: string }[];
}

const { title, lead, quotes } = Astro.props;

const cardStyles: { bg: string; block: string; preset: OneCornerPreset; rest: number; tilt: string }[] = [
  { bg: '#fff', block: 'var(--periwinkle-9)', preset: 'mod-2', rest: -2, tilt: '-1.6deg' },
  { bg: 'var(--periwinkle-2)', block: 'var(--gold-9)', preset: 'mod-3', rest: 1.5, tilt: '1.2deg' },
  { bg: 'var(--periwinkle-4)', block: 'var(--periwinkle-11)', preset: 'mod-4', rest: 2.2, tilt: '1.8deg' },
];
---

<section id="testimonios" class="one-quotes one-u" aria-labelledby="one-quotes-title">
  <div class="one-quotes-content">
    <div class="one-quotes-heading">
      <h2 id="one-quotes-title" class="one-h2">{title}</h2>
      {lead && <p class="one-lead one-quotes-lead">{lead}</p>}
    </div>

    <ul class="one-quotes-list">
      {
        quotes.map((quote, index) => {
          const style = cardStyles[index % cardStyles.length]!;
          return (
            <li class="one-quote-item" data-quote-enter={index} data-enter-rotate={style.rest * 1.8}>
              <div class="one-quote-tilt" style={`--tilt:${style.tilt}`}>
                <OneCornerBlocks preset={style.preset} color={style.block} />
                <figure class="one-quote-card" style={`--card-bg:${style.bg}`}>
                  <blockquote class="one-quote-text">
                    <p>“{quote.text}”</p>
                  </blockquote>
                  <figcaption class="one-quote-author">
                    <span class="one-quote-name">{quote.name}</span>
                    <span class="one-quote-context">{quote.context}</span>
                  </figcaption>
                </figure>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  import { revealOnView, springs } from '../lib/motion';

  document.querySelectorAll<HTMLElement>('[data-quote-enter]').forEach((item) => {
    revealOnView(
      item,
      { opacity: 0, y: 40, rotate: Number(item.dataset.enterRotate) },
      { opacity: 1, y: 0, rotate: 0 },
      { ...springs.testimonialCard, delay: Number(item.dataset.quoteEnter) * 0.08 },
      0.2
    );
  });
</script>

<style>
  .one-quotes {
    position: relative;
    z-index: 20;
    width: 100%;
    overflow: hidden;
    margin-top: calc(var(--edge-r) * -1);
    padding: var(--section-py) var(--gutter);
    border-radius: var(--edge-r);
    background: var(--gold-2);
    color: var(--midnight);
  }
  .one-quotes-content { position: relative; z-index: 10; max-width: calc(var(--u) * 1520); margin-inline: auto; }
  .one-quotes-heading {
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 20);
    max-width: calc(var(--u) * 1160);
    margin: 0 auto calc(var(--u) * 56);
    text-align: center;
  }
  .one-quotes-heading h2 { color: var(--midnight); }
  .one-quotes-lead { max-width: calc(var(--u) * 760); margin-inline: auto; color: var(--neutral-11); }
  .one-quotes-list {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    gap: 2.5rem;
    margin: 0;
    padding: 1rem 0 1.5rem;
    list-style: none;
  }
  .one-quote-item { position: relative; display: flex; }
  .one-quote-tilt {
    position: relative;
    display: flex;
    width: 100%;
    rotate: var(--tilt);
    transition-property: all;
    transition-duration: 0.3s;
    transition-timing-function: var(--ease-bounce);
  }
  .one-quote-item:hover .one-quote-tilt { rotate: 0deg; translate: 0 -0.5rem; }
  .one-quote-card {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: calc(var(--u) * 28);
    width: 100%;
    margin: 0;
    padding: max(28px, calc(var(--u) * 42)) max(24px, calc(var(--u) * 34));
    border-radius: var(--card-r);
    background: var(--card-bg);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    text-align: center;
  }
  .one-quote-text {
    margin: auto 0;
    font-family: var(--font-hand);
    font-size: max(20px, calc(var(--u) * 26));
    line-height: 1.35;
    color: var(--midnight);
  }
  .one-quote-text p { margin: 0; }
  .one-quote-author { display: flex; flex-direction: column; gap: 0.25rem; padding-top: 0.5rem; font-family: var(--font-body); }
  .one-quote-name { font-weight: 700; font-size: max(16px, calc(var(--u) * 20)); line-height: 1.375; color: var(--midnight); }
  .one-quote-context { font-size: max(15px, calc(var(--u) * 17)); line-height: 1.375; color: var(--neutral-11); }

  @media (min-width: 768px) {
    .one-quotes-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--u) * 36); }
  }
  @media (prefers-reduced-motion: reduce) {
    .one-quote-tilt { transition: none; }
  }
</style>
