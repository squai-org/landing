---
import { ecosystems } from '../data/landing';
---

<!--
  Ecosystem switcher. One tablist, one panel: the visitor picks the ecosystem
  instead of scanning three parallel cards.
-->
<div id="ecosistemas" class="section-pad" style="background:#F4F6FF;border-radius:40px;padding:80px 64px">
  <div style="max-width:1152px;margin:0 auto">
    <div style="display:flex;flex-wrap:wrap;gap:28px;align-items:end;justify-content:space-between">
      <h2
        class="h2-title"
        style="margin:0;max-width:640px;font-family:var(--font-display);font-weight:700;font-size:48px;line-height:1;letter-spacing:-0.045em;color:#0A0C1A;text-wrap:balance"
      >
        Una metodología, tres contextos
      </h2>
      <p style="margin:0;max-width:380px;font-size:17px;line-height:1.65;color:#4B5167">
        Elige desde dónde llegas y te mostramos cómo trabajamos ahí.
      </p>
    </div>

    <div
      class="service-tabs"
      role="tablist"
      aria-label="Ecosistemas Squai"
      data-service-tablist
      style="margin-top:36px"
    >
      {
        ecosystems.map((eco, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${eco.id}`}
            class="tab-service"
            data-eco={eco.id}
            data-service-tab
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${eco.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {eco.tab}
          </button>
        ))
      }
    </div>

    {
      ecosystems.map((eco, i) => (
        <div
          class="service-panel"
          role="tabpanel"
          id={`panel-${eco.id}`}
          aria-labelledby={`tab-${eco.id}`}
          data-service-panel={eco.id}
          hidden={i !== 0}
          tabindex="0"
          style="margin-top:22px;background:#FFFFFF;border:1px solid #DCE1F0;border-radius:32px;padding:44px"
        >
          <div style="max-width:760px">
            <div
              class="h2-title"
              style="margin:0;font-family:var(--font-display);font-weight:700;font-size:52px;line-height:1;letter-spacing:-0.05em;color:#0A0C1A"
            >
              {eco.territory}
            </div>
            <div style="margin-top:8px;font-size:14px;color:#5F657A">
              {eco.name} · {eco.audience}
            </div>

            <h3
              class="h3-title"
              style="margin:26px 0 0;font-family:var(--font-display);font-weight:700;font-size:26px;line-height:1.15;letter-spacing:-0.03em;color:#0A0C1A;max-width:26ch"
            >
              {eco.headline}
            </h3>
            <p style="margin:14px 0 0;font-size:17px;line-height:1.7;color:#4B5167;max-width:62ch;text-wrap:pretty">
              {eco.copy}
            </p>

            <ul style="margin:24px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px">
              {eco.points.map((point) => (
                <li style="display:flex;gap:12px;align-items:flex-start;font-size:16px;line-height:1.55;color:#0A0C1A">
                  <span style={`flex:none;color:${eco.accent === '#F9C24D' ? '#7A5A0C' : eco.accent === '#44D4C8' ? '#12796F' : '#4C50D8'};font-weight:700`}>
                    ✓
                  </span>
                  {point}
                </li>
              ))}
            </ul>

            {eco.ctaModal ? (
              <button
                type="button"
                class="btn-dark"
                data-open-modal={eco.ctaModal}
                style="margin-top:30px;font-family:var(--font-body);font-size:16px;font-weight:700;color:#FFFFFF;background:#0D0D0D;border:0;border-radius:100px;padding:16px 32px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(13,27,42,.4)"
              >
                {eco.ctaLabel}
              </button>
            ) : (
              <a
                href={`/#${eco.ctaTarget}`}
                data-scroll-to={eco.ctaTarget}
                class="btn-dark"
                style="display:inline-block;margin-top:30px;font-family:var(--font-body);font-size:16px;font-weight:700;color:#FFFFFF;background:#0D0D0D;border:0;border-radius:100px;padding:16px 32px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.2), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(13,27,42,.4)"
              >
                {eco.ctaLabel}
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</div>
