---
import { getImage } from 'astro:assets';
import Button from './Button.astro';
import OneBackdrop from './OneBackdrop.astro';
import { getSiteContent, type Service } from '../lib/content';
import { teamImages } from '../lib/team-photos';
import '../styles/one-sections.css';

interface Props {
  title: string;
  closing: string;
  cta: Service['cta'];
  profiles?: { name: string; badge: string; quote: string }[];
  stats?: { value: string; label: string }[];
}

const { title, closing, cta, profiles = [], stats = [] } = Astro.props;
const { squadGrid, ui } = await getSiteContent();

const mentors = await Promise.all(
  squadGrid
    .filter((member) => member.founder)
    .map(async (member) => {
      const photo = await getImage({ src: teamImages[member.img], width: 360, height: 360, fit: 'cover', position: 'top', format: 'webp', quality: 90 });
      const profile = profiles.find((item) => item.name === member.name);
      return { ...member, profile, photo, alt: ui.team.memberAlt.replace('{name}', member.name).replace('{role}', member.role) };
    }),
);

const cardStyles = [
  { frame: 'var(--gold-3)', inner: '#fff', tilt: '-1.8deg', enter: -3, crop: false, stamp: 'var(--periwinkle-9)', stampInk: 'var(--midnight)', quoteMark: '#fde4b5' },
  { frame: '#fff', inner: 'var(--periwinkle-2)', tilt: '1.8deg', enter: 3, crop: true, stamp: 'var(--midnight)', stampInk: 'var(--gold-9)', quoteMark: '#d2d7fc' },
];
---

{
  mentors.length > 0 && (
    <section id="equipo-one" class="one-team one-u" aria-labelledby="one-team-title">
      <OneBackdrop shape="hero" colors={['#ffd688', '#fedea0']} opacities={[0.7, 0.8]} flip="x" small />

      <div class="one-team-content">
        <div class="one-team-heading">
          <Button variant="dark" arrow href={`#${cta.target}`} data-scroll-to={cta.target}>{cta.label}</Button>
          <h2 id="one-team-title" class="one-h2">{title}</h2>
          <p class="one-lead one-team-lead">{closing}</p>
        </div>

        <ul class="one-team-list">
          {
            mentors.map((mentor, index) => {
              const style = cardStyles[index % cardStyles.length]!;
              const nameId = `one-team-${index}-name`;
              return (
                <li class="mentor-card" data-mentor-enter={index} data-enter-rotate={style.enter}>
                  <article class="mentor-card-tilt" style={`--tilt:${style.tilt}`} aria-labelledby={nameId}>
                    {mentor.profile && (
                      <div class="mentor-stamp" style={`--stamp-bg:${style.stamp};--stamp-ink:${style.stampInk}`}>
                        {mentor.profile.badge}
                      </div>
                    )}
                    <div class="mentor-avatar">
                      <img
                        class:list={[style.crop && 'is-tight']}
                        src={mentor.photo.src}
                        width={mentor.photo.attributes.width}
                        height={mentor.photo.attributes.height}
                        alt={mentor.alt}
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                    <div class="mentor-frame" style={`--frame-bg:${style.frame}`}>
                      <div class="mentor-inner" style={`--inner-bg:${style.inner}`}>
                        <div class="mentor-head">
                          <h3 id={nameId} class="one-h3" style={`--name-chars:${mentor.name.length}`}>{mentor.name}</h3>
                          <p class="mentor-role">{mentor.role}</p>
                        </div>
                        {mentor.profile ? (
                          <>
                            <div class="mentor-body">
                              <svg class="mentor-quote-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false" style={`color:${style.quoteMark}`}>
                                <path
                                  fill="currentColor"
                                  d="M14 14h14v16c0 10.5-5.2 17.6-14 21l-3.6-6.8c5.2-2.2 7.8-6.2 8.2-11.2H14V14Zm28 0h14v16c0 10.5-5.2 17.6-14 21l-3.6-6.8c5.2-2.2 7.8-6.2 8.2-11.2H42V14Z"
                                />
                              </svg>
                              <blockquote class="mentor-quote">“{mentor.profile.quote}”</blockquote>
                            </div>
                            <p class="one-body mentor-bio">{mentor.d}</p>
                          </>
                        ) : (
                          <div class="mentor-body">
                            <p class="one-body mentor-bio">{mentor.d}</p>
                          </div>
                        )}
                        {mentor.linkedin && (
                          <a class="mentor-link" href={mentor.linkedin} rel="noopener noreferrer" target="_blank">
                            LinkedIn de {mentor.name}
                          </a>
                        )}
                      </div>
                    </div>
                  </article>
                </li>
              );
            })
          }
        </ul>

        {stats.length > 0 && (
          <dl class="mentor-stats">
            {stats.map((stat) => (
              <div class="mentor-stat">
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>
  )
}

<script>
  import { revealOnView, springs } from '../lib/motion';

  document.querySelectorAll<HTMLElement>('[data-mentor-enter]').forEach((card) => {
    revealOnView(
      card,
      { opacity: 0, y: 40, rotate: Number(card.dataset.enterRotate) },
      { opacity: 1, y: 0, rotate: 0 },
      { ...springs.mentorCard, delay: Number(card.dataset.mentorEnter) * 0.1 }
    );
  });
</script>

<style>
  .one-team {
    position: relative;
    z-index: 10;
    width: 100%;
    overflow: hidden;
    padding: var(--section-py) var(--gutter) calc(var(--section-py) + var(--edge-r));
    border-radius: var(--edge-r) var(--edge-r) 0 0;
    background: var(--gold-9);
    color: var(--midnight);
    --mc-w: 421px;
    --mc-min-h: 605px;
    --mc-avatar: 153px;
    --mc-avatar-top: 156px;
    --mc-avatar-left: 57px;
    --mc-frame-pad: 18px;
    --mc-frame-radius: 42px;
    --mc-inner-radius: 29px;
    --mc-inner-pad: 31px;
    --mc-text-scale: 1.3;
  }
  .one-team-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: calc(var(--u) * 72);
    margin-inline: auto;
  }
  .one-team-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--u) * 20);
    max-width: calc(var(--u) * 1100);
    margin-inline: auto;
    text-align: center;
  }
  .one-team-heading h2 { color: var(--midnight); }
  .one-team-lead { max-width: calc(var(--u) * 800); color: var(--neutral-12); }
  .one-team-list {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: stretch;
    gap: 4rem;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 0 1.5rem;
    list-style: none;
  }
  .mentor-card {
    position: relative;
    display: flex;
    justify-content: center;
    width: min(295px, calc(100vw - 96px));
  }
  .mentor-card-tilt {
    position: relative;
    display: flex;
    width: 100%;
    rotate: var(--tilt);
    transition: rotate 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .mentor-card-tilt:hover { rotate: 0deg; }
  .mentor-avatar {
    position: absolute;
    top: 7.5rem;
    left: -2.25rem;
    z-index: 30;
    width: 112px;
    height: 112px;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--periwinkle-2);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  }
  .mentor-avatar img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .mentor-avatar img.is-tight { scale: 1.16; }
  .mentor-frame {
    position: relative;
    z-index: 10;
    display: flex;
    width: 100%;
    min-height: 465px;
    padding: 14px;
    border-radius: 32px;
    background: var(--frame-bg);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  }
  .mentor-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 20px;
    border-radius: 22px;
    background: var(--inner-bg);
  }
  .mentor-head { display: flex; flex-direction: column; gap: 0.25rem; container-type: inline-size; }
  .mentor-head h3 {
    color: var(--midnight);
    white-space: nowrap;
    font-size: min(var(--fs-h3), calc(100cqw / (var(--name-chars, 14) * 0.48)));
  }
  .mentor-role {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--periwinkle-11);
  }
  .mentor-body { position: relative; margin-block: auto; padding: 0.5rem 0 0.5rem 64px; }
  .mentor-bio { line-height: 1.375; color: var(--neutral-12); }
  .mentor-stamp {
    position: absolute;
    top: -1.25rem;
    right: -1.25rem;
    z-index: 30;
    padding: 0.5rem 1rem;
    border-radius: 16px;
    background: var(--stamp-bg);
    color: var(--stamp-ink);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    rotate: 6deg;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25rem;
    letter-spacing: -0.025em;
    pointer-events: none;
  }
  .mentor-quote-mark {
    position: absolute;
    top: -0.5rem;
    left: 48px;
    width: 3.5rem;
    height: 3.5rem;
    pointer-events: none;
    user-select: none;
  }
  .mentor-quote {
    position: relative;
    z-index: 10;
    margin: 0;
    font-family: var(--font-hand);
    font-size: 15px;
    line-height: 1.35;
    color: #303163;
  }
  .mentor-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
  }
  .mentor-stat {
    display: flex;
    flex-direction: column-reverse;
    padding: 20px 24px;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    text-align: center;
  }
  .mentor-stat dt { font-size: 1rem; line-height: 1.5rem; color: var(--midnight); }
  .mentor-stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--midnight);
  }
  .mentor-link {
    align-self: flex-start;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--periwinkle-12);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }
  .mentor-link:hover { color: var(--periwinkle-11); }

  @media (min-width: 380px) {
    .mentor-body { padding-left: 72px; }
    .mentor-quote-mark { left: 56px; }
  }
  @media (max-width: 379px) {
    .mentor-avatar { top: 10rem; }
  }
  @media (min-width: 640px) {
    .mentor-card { width: var(--mc-w); }
    .mentor-avatar {
      top: var(--mc-avatar-top);
      left: calc(var(--mc-avatar-left) * -1);
      width: var(--mc-avatar);
      height: var(--mc-avatar);
    }
    .mentor-frame { min-height: var(--mc-min-h); padding: var(--mc-frame-pad); border-radius: var(--mc-frame-radius); }
    .mentor-inner { padding: var(--mc-inner-pad); border-radius: var(--mc-inner-radius); }
    .mentor-head h3 { font-size: min(calc(clamp(1.7rem, 2.15vw, 2.3rem) * var(--mc-text-scale)), calc(100cqw / (var(--name-chars, 14) * 0.48))); }
    .mentor-role { font-size: 18px; }
    .mentor-body { padding-left: 88px; }
    .mentor-stamp {
      top: -26px;
      right: -26px;
      padding: 10px 21px;
      border-radius: 21px;
      font-size: 21px;
    }
    .mentor-quote-mark { left: 68px; width: 4rem; height: 4rem; }
    .mentor-quote { font-size: 19px; }
    .mentor-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
    .mentor-stat:nth-child(1) { rotate: 1deg; }
    .mentor-stat:nth-child(2) { rotate: -1.5deg; }
    .mentor-stat:nth-child(3) { rotate: 1.8deg; }
    .mentor-stat dt { font-size: 1.125rem; line-height: 1.75rem; }
    .mentor-stat dd { font-size: 3.75rem; }
    .mentor-bio { font-size: calc(clamp(1.02rem, 1.18vw, 1.2rem) * var(--mc-text-scale)); }
  }
  @media (min-width: 768px) {
    .one-team-list { gap: 5rem; }
  }
  @media (min-width: 1280px) {
    .one-team-list { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 1100px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mentor-card-tilt { transition: none; }
  }
</style>
