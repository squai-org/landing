---
import type { CapabilityGroup } from '../lib/content';

interface Props {
  headline: string;
  groups: CapabilityGroup[];
}

const { headline, groups } = Astro.props;
---

<section class="section tint">
  <div class="shell">
    <h2 class="display d-h1 capabilities-title">{headline}</h2>
    <div class="bento capabilities-grid">
      {
        groups.map((g) => (
          <div class={`bento-card span-2 capability-card ${g.tone}`}>
            <h3 class="display d-h2">{g.t}</h3>
            <ul class="capability-list">
              {g.items.map((item) => (
                <li class="body capability-item">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .capabilities-title { color: var(--ink); }
  .capabilities-grid { margin-top: clamp(36px, 4vw, 64px); }
  .capability-card { min-height: clamp(260px, 26vw, 420px); justify-content: space-between; gap: clamp(28px, 3vw, 56px); }
  .capability-list { display: flex; margin: 0; padding: 0; flex-direction: column; gap: 10px; list-style: none; }
  .capability-item { font-weight: 400; }
</style>
