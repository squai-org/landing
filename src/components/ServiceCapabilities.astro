---
import type { CapabilityGroup } from '../data/landing';

interface Props {
  headline: string;
  groups: CapabilityGroup[];
}

const { headline, groups } = Astro.props;
---

<section class="section tint">
  <div class="shell">
    <h2 class="display d-h1" style="color:var(--ink)">{headline}</h2>
    <div class="bento" style="margin-top:clamp(36px,4vw,64px)">
      {
        groups.map((g) => (
          <div class={`bento-card span-2 ${g.tone}`} style="gap:clamp(28px,3vw,56px);justify-content:space-between;min-height:clamp(260px,26vw,420px)">
            <h3 class="display d-h2">{g.t}</h3>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px">
              {g.items.map((item) => (
                <li class="body" style="font-weight:700;opacity:.9">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
