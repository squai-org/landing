---
import Button from './Button.astro';
import { impact } from '../data/landing';
---

<section id="impacto" class="section night">
  <div class="shell impact-row">
    <h2 class="display d-h1" style="color:var(--canvas);flex:1 1 320px;min-width:0">{impact.title}</h2>
    <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:clamp(24px,2.6vw,40px)">
      <p class="lead" style="color:#B7BCD0;max-width:52ch">{impact.copy}</p>
      <!-- Client stories are not organised yet; the button is intentionally inert. -->
      <Button variant="teal" disabled>{impact.ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .impact-row { display: flex; flex-wrap: wrap; gap: clamp(28px, 4vw, 72px); align-items: center; }
</style>
