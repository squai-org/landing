---
import { impact } from '../data/landing';
---

<section id="impacto" class="section-tight">
  <div class="shell">
    <div class="impact-card">
      <h2 class="display d-h1" style="color:var(--canvas);flex:1 1 320px;min-width:0">{impact.title}</h2>
      <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:clamp(24px,2.6vw,40px)">
        <p class="lead" style="color:#B7BCD0;max-width:52ch">{impact.copy}</p>
        <!-- Client stories are not organised yet; the button is intentionally inert. -->
        <button
          type="button"
          class="btn-teal"
          disabled
          style="font-family:var(--font-display);font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#0A0C1A;background:#44D4C8;border:0;border-radius:100px;padding:15px 28px;cursor:not-allowed"
        >
          {impact.ctaLabel}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .impact-card {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
    background: var(--midnight);
    border-radius: clamp(24px, 2.4vw, 40px);
    padding: clamp(36px, 5vw, 88px);
  }
</style>
