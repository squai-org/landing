---
import { getSiteContent } from '../lib/content';
const { impact } = await getSiteContent();
---

<section id="impacto" class="section night impact-section">
  <svg class="brand-shape impact-shape" viewBox="0 0 771.3 781.711" preserveAspectRatio="none" aria-hidden="true">
    <path d="M29.6739 650.872C21.0338 633.864 2.46304 596.309 1.91045 577.569C-1.67346 456.543 0.892095 334.563 0.852625 213.379C0.848677 202.794 4.0458 189.707 7.27053 179.706C28.9121 112.427 76.6001 56.6051 139.689 24.7035C191.585 -1.12238 222.996 0.795001 278.684 0.976485L381.962 1.33552C442.913 1.4736 538.506 -5.35168 593.819 10.5952C680.97 35.7227 756.919 122.87 767.757 212.7C771.258 236.771 770.055 266.116 770.122 290.782L770.201 408.154C770.169 446.045 772.936 514.29 769.81 549.36C767.927 569.134 763.566 588.592 756.836 607.281C732.427 675.041 685.734 728.401 619.968 759.166C564.11 785.3 528.05 781.611 468.02 781.442C399.724 781.248 330.205 781.595 261.791 781.26C224.689 781.442 205.005 777.425 169.9 767.302C100.239 739.487 69.0258 713.602 29.6739 650.872Z" fill="var(--gold)" />
  </svg>
  <div class="shell impact-row">
    <h2 class="display d-h1 impact-title">{impact.title}</h2>
    <div class="impact-copy-column">
      {impact.body.map((paragraph) => <p class="lead impact-copy">{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .impact-section { position: relative; overflow: hidden; }
  .impact-shape {
    position: absolute;
    z-index: 0;
    width: 71%;
    height: 190%;
    left: -28%;
    top: -15%;
    transform: rotate(37.8deg);
    pointer-events: none;
    user-select: none;
  }
  .impact-row {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 4vw, 72px);
    align-items: center;
  }
  .impact-title { min-width: 0; flex: 1 1 320px; color: var(--midnight); }
  .impact-copy { max-width: 52ch; color: var(--canvas); }
  .impact-copy-column {
    display: flex;
    flex: 1 1 420px;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(24px, 2.6vw, 40px);
  }

  @media (max-width: 1023px) {
    .impact-title { color: var(--canvas); }
  }

  @media (max-width: 900px) {
    .impact-row > * { flex-basis: 100%; }
  }

</style>
