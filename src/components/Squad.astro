---
import { squadGrid } from '../data/landing';
---

<div id="equipo" class="section-pad" style="background:#0D1B2A;border-radius:40px;padding:80px 64px">
  <div style="max-width:1000px;margin:0 auto">
    <h2
      class="h2-title"
      style="margin:0 0 8px;font-family:'Urbanist',sans-serif;font-weight:900;font-size:46px;line-height:1.05;letter-spacing:-0.03em;color:#F0F2FF;text-align:center"
    >
      Respaldados por el equipo Squai
    </h2>
    <div
      style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:19px;color:#72DED5;text-align:center;margin-bottom:10px"
    >
      Un programa construido con varias miradas
    </div>
    <p
      style="margin:0 auto 44px;text-align:center;font-size:16px;font-weight:300;line-height:1.6;color:#F0F2FF;max-width:560px"
    >
      El contenido se nutre de un equipo con distintas especialidades que aportan su experiencia a lo que enseñamos.
    </p>
    <div class="grid-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:18px">
      {
        squadGrid.map((m) => (
          <div
            class="card-squad squad-card"
            style="display:flex;align-items:flex-start;gap:20px;background:#FFFFFF;border-radius:26px;padding:22px"
          >
            <img
              src={m.img}
              alt={m.name}
              width="132"
              height="119"
              class="squad-photo"
              style="width: 132px; height: 119px; flex: none; object-fit: cover; border-radius: 18px; background: #E8ECFF"
            />
            <div>
              <div style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:18px;color:#0D1B2A">{m.name}</div>
              <div style="font-size:13px;font-weight:600;color:#3D50CC;margin:3px 0 8px">{m.role}</div>
              <div style="font-size:14px;font-weight:300;line-height:1.6;color:#333">{m.d}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
