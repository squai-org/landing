---
import { squadGrid } from '../data/landing';
---

<div id="equipo" class="section-pad" style="background:#0A0C1A;border-radius:40px;padding:80px 64px;margin-top:28px">
  <div style="max-width:1152px;margin:0 auto">
    <div class="eyebrow eyebrow-night" style="margin-bottom:18px">El resto del equipo</div>
    <h2
      class="h2-title"
      style="margin:0 0 12px;font-family:var(--font-display);font-weight:700;font-size:44px;line-height:1.02;letter-spacing:-0.045em;color:#F4F6FF;text-wrap:balance"
    >
      Detrás de cada programa hay más de dos personas
    </h2>
    <p style="margin:0 0 36px;font-size:17px;line-height:1.7;color:#B7BCD0;max-width:64ch;text-wrap:pretty">
      Procesos, talento, datos y seguridad. Cada quien mira el mismo tema desde su lado, y por eso lo que enseñamos
      aguanta el choque con la realidad de un trabajo de verdad.
    </p>
    <div class="grid-2" style="display:grid;grid-template-columns:repeat(2,1fr);gap:18px">
      {
        squadGrid.map((m) => (
          <div
            class="squad-card card-squad"
            style="display:flex;gap:22px;align-items:center;background:#12162A;border:1px solid #2C314D;border-radius:28px;padding:22px"
          >
            <img
              src={m.img}
              alt={m.name}
              loading="lazy"
              class="squad-photo"
              style="width:132px;height:119px;flex:none;object-fit:cover;border-radius:20px;background:#2C314D"
            />
            <div style="min-width:0">
              <div style="font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:-0.03em;color:#F4F6FF">
                {m.name}
              </div>
              <div style="margin:4px 0 10px;font-size:13px;color:#44D4C8">{m.role}</div>
              <p style="margin:0;font-size:15px;line-height:1.6;color:#B7BCD0">{m.d}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>
