---
import Block from './Block.astro';
import { getSiteContent } from '../lib/content';
import { whatsappUrl } from '../lib/whatsapp';

const { company, ui } = await getSiteContent();
const { label, message, panel } = ui.whatsapp;
const href = whatsappUrl(company.phone, message);
const topics = (panel?.topics ?? []).map((topic) => ({ ...topic, href: whatsappUrl(company.phone, topic.message) }));
const logoPath =
  'M16.01 3.2c-7.06 0-12.8 5.74-12.8 12.8 0 2.26.59 4.46 1.71 6.4L3.1 29.05l6.83-1.79a12.74 12.74 0 0 0 6.08 1.54h.01c7.06 0 12.8-5.74 12.8-12.8 0-3.42-1.33-6.64-3.75-9.05A12.71 12.71 0 0 0 16.01 3.2Zm0 23.43h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.05 1.06 1.08-3.95-.25-.41a10.58 10.58 0 0 1-1.62-5.62c0-5.86 4.77-10.63 10.64-10.63 2.84 0 5.51 1.11 7.51 3.12a10.56 10.56 0 0 1 3.11 7.51c0 5.87-4.77 10.63-10.62 10.63Zm5.83-7.96c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.89-1.78-2.21-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.09 1.31 3.3c.16.21 2.26 3.45 5.47 4.84.76.33 1.36.53 1.82.67.77.24 1.47.21 2.02.13.62-.09 1.89-.77 2.16-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37Z';
const hasPanel = Boolean(panel) && topics.length > 0 && topics.every((topic) => topic.href);
---

{
  href && (
    <div class="whatsapp-float" data-whatsapp>
      {hasPanel && panel && (
        <div class="whatsapp-panel" id="whatsapp-panel" role="dialog" aria-label={panel.dialogLabel} data-whatsapp-panel hidden>
          <div class="whatsapp-panel-head">
            <div class="whatsapp-panel-id">
              <span class="whatsapp-panel-icon">
                <span class="whatsapp-panel-block"><Block /></span>
                <svg class="whatsapp-panel-logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                  <path fill="#FFFFFF" d={logoPath} />
                </svg>
              </span>
              <div>
                <h3 class="whatsapp-panel-title">{panel.title}</h3>
                <p class="whatsapp-panel-subtitle">{panel.subtitle}</p>
              </div>
            </div>
            <button type="button" class="whatsapp-panel-close" aria-label={panel.close} data-whatsapp-close>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>
          <div class="whatsapp-panel-body">
            {topics.map((topic) => (
              <a class="whatsapp-topic" href={topic.href} target="_blank" rel="noopener noreferrer" data-whatsapp-topic>
                <span>{topic.label}</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M7 7h10v10"></path>
                  <path d="M7 17 17 7"></path>
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}
      {hasPanel ? (
        <button type="button" class="whatsapp-button" aria-label={label} aria-expanded="false" aria-controls="whatsapp-panel" data-whatsapp-toggle>
          <span class="whatsapp-shape"><Block /></span>
          <svg class="whatsapp-logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path fill="#FFFFFF" d={logoPath} />
          </svg>
        </button>
      ) : (
        <a class="whatsapp-button" href={href} target="_blank" rel="noopener noreferrer" aria-label={label} data-whatsapp-toggle>
          <span class="whatsapp-shape"><Block /></span>
          <svg class="whatsapp-logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <path fill="#FFFFFF" d={logoPath} />
          </svg>
        </a>
      )}
    </div>
  )
}

<style>
  .whatsapp-float {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      visibility var(--duration-fast);
  }

  .whatsapp-float[data-away] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .whatsapp-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    filter: drop-shadow(0 9px 7px rgb(0 0 0 / 0.1));
  }

  .whatsapp-shape {
    display: block;
    width: 100%;
    height: 100%;
    color: #25D366;
    transition: transform .2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .whatsapp-logo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 32px;
    height: 32px;
    margin: auto;
    pointer-events: none;
  }

  .whatsapp-panel {
    width: 310px;
    overflow: hidden;
    border-radius: 24px;
    background: #FFFFFF;
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
    font-family: var(--font-body);
  }

  .whatsapp-panel[hidden] {
    display: none;
  }

  .whatsapp-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    background: #075E54;
    color: #FFFFFF;
  }

  .whatsapp-panel-id {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .whatsapp-panel-icon {
    position: relative;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }

  .whatsapp-panel-block {
    display: block;
    width: 40px;
    height: 40px;
    color: #25D366;
  }

  .whatsapp-panel-logo {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 20px;
    height: 20px;
    margin: auto;
  }

  .whatsapp-panel-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #FFFFFF;
  }

  .whatsapp-panel-subtitle {
    margin: 2px 0 0;
    font-size: 12px;
    line-height: 16px;
    color: #d9fdd3;
  }

  .whatsapp-panel-close {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgb(255 255 255 / 0.8);
    cursor: pointer;
  }

  .whatsapp-panel-close:hover {
    background: rgb(255 255 255 / 0.15);
    color: #FFFFFF;
  }

  .whatsapp-panel-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    background: #f2f3f6;
  }

  .whatsapp-topic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 16px;
    background: #FFFFFF;
    color: #0A0C1A;
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
    text-align: left;
    text-decoration: none;
    transition: background-color .15s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .whatsapp-topic:hover {
    background: #e7fce9;
  }

  .whatsapp-topic svg {
    flex: none;
    color: #075E54;
  }

  @media (min-width: 640px) {
    .whatsapp-panel {
      width: 340px;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .whatsapp-button:hover .whatsapp-shape {
      transform: scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-shape,
    .whatsapp-topic,
    .whatsapp-float { transition: none; }
  }
</style>

<script>
  import { animateIn, animateOut, gestures, hoverPress, tweens } from '../lib/motion';

  const float = document.querySelector<HTMLElement>('[data-whatsapp]');
  const toggle = float?.querySelector<HTMLElement>('[data-whatsapp-toggle]');
  const panel = float?.querySelector<HTMLElement>('[data-whatsapp-panel]');
  const forms = document.querySelectorAll<HTMLElement>('form');

  if (toggle) hoverPress(toggle, gestures.whatsapp);

  if (float && toggle && panel) {
    const enter = { opacity: 0, y: 12, scale: 0.96 };
    const shown = { opacity: 1, y: 0, scale: 1 };
    const leave = { opacity: 0, y: 8, scale: 0.96 };
    let open = false;

    const setOpen = (next: boolean, restoreFocus = false) => {
      if (next === open) return;
      open = next;
      toggle.setAttribute('aria-expanded', String(next));
      if (next) {
        panel.hidden = false;
        void animateIn(panel, enter, shown, tweens.popover);
        panel.querySelector<HTMLElement>('[data-whatsapp-topic]')?.focus();
      } else {
        void animateOut(panel, leave, tweens.popover).then(() => {
          if (!open) panel.hidden = true;
        });
        if (restoreFocus) toggle.focus();
      }
    };

    toggle.addEventListener('click', () => setOpen(!open));
    float.querySelector('[data-whatsapp-close]')?.addEventListener('click', () => setOpen(false, true));
    float.querySelectorAll('[data-whatsapp-topic]').forEach((topic) => topic.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) setOpen(false, true);
    });
    document.addEventListener('pointerdown', (event) => {
      if (open && event.target instanceof Node && !float.contains(event.target)) setOpen(false);
    });
    new MutationObserver(() => {
      if (float.hasAttribute('data-away')) setOpen(false);
    }).observe(float, { attributes: true, attributeFilter: ['data-away'] });
  }

  if (float && forms.length > 0 && 'IntersectionObserver' in window) {
    const visibleForms = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visibleForms.add(entry.target);
        else visibleForms.delete(entry.target);
      }
      float.toggleAttribute('data-away', visibleForms.size > 0);
    });
    forms.forEach((form) => observer.observe(form));
  }
</script>
