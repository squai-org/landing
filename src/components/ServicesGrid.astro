---
import { getSiteContent } from '../lib/content';
const { services, labels } = await getSiteContent();
---

<section id="servicios" class="section tint">
  <div class="shell">
    <h2 class="display d-h1 services-title">{labels.services}</h2>
  </div>

  <div class="bento services-grid">
    {
      services.map((s) => (
        <div class={`bento-card service-card ${s.span} ${s.tone}`}>
          <div class="service-card-copy">
            <span class="service-eyebrow">
              <span class="service-eyebrow-dot" style={`background:${s.accent}`}></span>
              <span class="service-eyebrow-text">{s.audience}</span>
            </span>
            <p class="body service-summary">{s.cardCopy}</p>
          </div>
          <div class="service-card-footer">
            <h3 class="display d-h1">{s.name}</h3>
            <a href={`/servicios/${s.slug}`} class="btn btn-dark discover">
              <span class="btn-label">{s.discoverLabel}</span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .services-title { color: var(--ink); }
  .services-grid {
    margin-top: clamp(36px, 4vw, 64px);
    margin-inline: calc(-1 * clamp(20px, 4vw, 64px));
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .services-grid .service-card {
    grid-column: span 1;
    grid-row: auto;
  }
  .service-card { justify-content: space-between; gap: clamp(24px, 3vw, 48px); }
  .service-card-copy { display: flex; flex-direction: column; gap: 16px; }
  .service-summary { max-width: 44ch; }
  .service-eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 10px 22px;
    background: rgba(244, 246, 255, .92);
    border: 1px solid rgba(244, 246, 255, .5);
    border-radius: var(--radius-pill);
  }
  .service-eyebrow-dot {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .service-eyebrow-text {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--periwinkle-ink);
  }

  .service-card-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex-wrap: nowrap;
    gap: 20px;
  }
  .service-card-footer h3 {
    min-width: 0;
  }
  .service-card-footer .discover {
    flex: none;
  }
  .discover:hover { background: #26262B; transform: translateY(-1px); }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .services-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
