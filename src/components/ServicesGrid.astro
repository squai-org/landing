---
import { services } from '../data/landing';
---

<section id="servicios" class="section">
  <div class="shell">
    <h2 class="display d-h1" style="color:var(--ink)">Servicios</h2>

    <div class="bento" style="margin-top:clamp(36px,4vw,64px)">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}`} class={`bento-card card-link ${s.span} ${s.tone}`} style="justify-content:space-between;gap:clamp(24px,3vw,48px)">
            <div style="display:flex;flex-direction:column;gap:12px">
              <span class="label" style="opacity:.6">{s.audience}</span>
              <h3 class="display d-h2">{s.name}</h3>
              <p class="body" style="max-width:44ch;opacity:.85">{s.cardCopy}</p>
            </div>
            <span class="discover">
              Descubrir
              <span class="discover-icon" aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .discover {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .discover-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(10, 12, 26, .12);
    font-size: 14px;
    transition: transform .25s;
  }
  .bento-card.dark .discover-icon { background: rgba(244, 246, 255, .14); }
  .card-link:hover .discover-icon { transform: translateX(4px); }
</style>
