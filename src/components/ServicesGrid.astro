---
import { services } from '../data/landing';
---

<section id="servicios" class="section tint">
  <div class="shell">
    <h2 class="display d-h1" style="color:var(--ink)">Servicios</h2>

    <div class="bento" style="margin-top:clamp(36px,4vw,64px)">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}`} class={`bento-card card-link ${s.span} ${s.tone}`} style="justify-content:space-between;gap:clamp(24px,3vw,48px)">
            <div style="display:flex;flex-direction:column;gap:12px">
              <span class="label" style="opacity:.6">{s.audience}</span>
              <h3 class="display d-h2">{s.name}</h3>
              <p class="body" style="max-width:44ch">{s.cardCopy}</p>
            </div>
            <span class="discover">
              Descubrir
              <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Same pill treatment as the LinkedIn button on the team cards. */
  .discover {
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    color: #0D0D0D;
    background: linear-gradient(180deg, #FFFFFF 0%, #F1F3FA 100%);
    border-radius: var(--radius-pill);
    padding: 11px 20px;
    box-shadow:
      inset 0 1px 0 #FFFFFF,
      inset 0 0 0 1px rgba(13, 27, 42, .07),
      0 1px 2px rgba(13, 27, 42, .06),
      0 8px 18px -10px rgba(13, 27, 42, .2);
    transition: transform .2s, box-shadow .2s;
  }
  .card-link:hover .discover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 #FFFFFF,
      inset 0 0 0 1px rgba(10, 12, 26, .1),
      0 2px 4px rgba(10, 12, 26, .06),
      0 14px 26px -12px rgba(10, 12, 26, .26);
  }
</style>
