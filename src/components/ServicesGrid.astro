---
import Button from './Button.astro';
import { services } from '../data/landing';
---

<section id="servicios" class="section tint">
  <div class="shell">
    <h2 class="display d-h1" style="color:var(--ink)">Servicios</h2>

    <div class="bento" style="margin-top:clamp(36px,4vw,64px)">
      {
        services.map((s) => (
          <a href={`/servicios/${s.slug}`} class={`bento-card card-link ${s.span} ${s.tone}`} style="justify-content:space-between;gap:clamp(24px,3vw,48px)">
            <div style="display:flex;flex-direction:column;gap:12px">
              <span class="label" style="font-weight:400">{s.audience}</span>
              <h3 class="display d-h2">{s.name}</h3>
              <p class="body" style="max-width:44ch">{s.cardCopy}</p>
            </div>
            <span class="btn btn-dark discover" aria-hidden="true">
              <span class="btn-lead">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="butt" stroke-linejoin="miter"><path d="M3.5 12h13.2M11.4 5.2 18.5 12l-7.1 6.8" /></svg>
              </span>
              <span class="btn-label">Descubrir</span>
              <span class="btn-tail">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="butt" stroke-linejoin="miter"><path d="M3.5 12h13.2M11.4 5.2 18.5 12l-7.1 6.8" /></svg>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .discover { align-self: flex-end; }
  .card-link:hover .discover { background: #26262B; transform: translateY(-1px); }
  .card-link:hover .discover .btn-lead { width: 19px; margin-right: 14px; opacity: 1; transform: none; }

  /* Responsive only: a light pill reads better against the tinted cards once
     the grid stacks to one column. */
  @media (max-width: 1023px) {
    .discover {
      background: #FFFFFF;
      color: var(--ink);
      box-shadow: inset 0 0 0 1px rgba(10, 12, 26, .08);
    }
    .card-link:hover .discover { background: #F1F3FA; }
  }
</style>
