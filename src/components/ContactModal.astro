---
import Button from './Button.astro';
import { endpoints } from '../config/endpoints';
import { getSiteContent } from '../lib/content';
import Turnstile from './Turnstile.astro';

const { ui, labels } = await getSiteContent();
---

<div
  data-modal
  hidden
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div data-modal-panel class="modal-panel">
    <button
      type="button"
      data-close-modal
      aria-label={ui.contact.close}
      class="modal-close"
      >×</button
    >
    <form
      data-form="contact"
      data-endpoint-grow={endpoints.grow}
      data-endpoint-learn={endpoints.learn}
      novalidate
      class="card-pad-lg modal-panel-form"
    >
      <h2 id="modal-title" data-modal-title class="modal-title">
        {ui.contact.title}
      </h2>
      <p data-modal-copy class="modal-copy">
        {ui.modal.grow.copy}
      </p>
      <p id="contact-required" class="form-instructions"><span aria-hidden="true">*</span> {ui.forms.required}</p>

      <div class="field-grid-2">
        <label class="field-group" for="contact-full-name">
          <span class="field-label">{ui.forms.fullName} <span aria-hidden="true">*</span></span>
          <input id="contact-full-name" type="text" name="full_name" required autocomplete="name" class="field" aria-describedby="contact-full-name-error" />
          <span id="contact-full-name-error" class="field-error" data-field-error="full_name"></span>
        </label>
        <label class="field-group" for="contact-email">
          <span class="field-label">{ui.forms.email} <span aria-hidden="true">*</span></span>
          <input id="contact-email" type="email" name="email" required autocomplete="email" class="field" aria-describedby="contact-email-error" />
          <span id="contact-email-error" class="field-error" data-field-error="email"></span>
        </label>
        <label class="field-group" for="contact-organization">
          <span class="field-label">{ui.forms.organization} <span aria-hidden="true">*</span></span>
          <input id="contact-organization" type="text" name="organization" required autocomplete="organization" class="field" aria-describedby="contact-organization-error" />
          <span id="contact-organization-error" class="field-error" data-field-error="organization"></span>
        </label>
        <label class="field-group" for="contact-role">
          <span class="field-label">{ui.forms.role}</span>
          <input id="contact-role" type="text" name="role" autocomplete="organization-title" class="field" aria-describedby="contact-role-error" />
          <span id="contact-role-error" class="field-error" data-field-error="role"></span>
        </label>
      </div>
      <div class="field-grid-phone">
        <label class="field-group" for="contact-country-code">
          <span class="field-label">{ui.forms.countryCode} <span aria-hidden="true">*</span></span>
          <input id="contact-country-code" type="text" name="country_code" required value="+57" autocomplete="tel-country-code" inputmode="tel" class="field" aria-describedby="contact-country-code-error" />
          <span id="contact-country-code-error" class="field-error" data-field-error="country_code"></span>
        </label>
        <label class="field-group" for="contact-phone">
          <span class="field-label">{ui.forms.whatsapp} <span aria-hidden="true">*</span></span>
          <input id="contact-phone" type="tel" name="phone" required autocomplete="tel-national" inputmode="tel" class="field" aria-describedby="contact-phone-error" />
          <span id="contact-phone-error" class="field-error" data-field-error="phone"></span>
        </label>
      </div>
      <label class="field-group field-group-spaced" for="contact-team-size">
        <span class="field-label">{ui.forms.teamSize} <span aria-hidden="true">*</span></span>
        <select id="contact-team-size" name="team_size" class="field select-field" required aria-describedby="contact-team-size-error">
          <option value="" disabled selected>{ui.forms.select}</option>
          {ui.forms.teamSizes.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <span id="contact-team-size-error" class="field-error" data-field-error="team_size"></span>
      </label>
      <label class="field-group field-group-spaced" for="contact-message">
        <span class="field-label">{ui.forms.message} <span class="field-optional">{ui.forms.optional}</span></span>
        <textarea
          id="contact-message"
          rows="4"
          name="message"
          data-modal-textarea
          placeholder={ui.modal.grow.placeholder}
          class="field"
          aria-describedby="contact-message-error"></textarea>
        <span id="contact-message-error" class="field-error" data-field-error="message"></span>
      </label>
      <div class="form-submit">
        <Button variant="primary" type="submit" block>{labels.call}</Button>
      </div>
      <div class="form-status" data-form-status role="status" aria-live="polite">
        {ui.contact.responseTime}
      </div>
      <Turnstile action="contact" />
    </form>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    overflow-y: auto;
    background: rgba(10, 12, 26, .6);
    backdrop-filter: blur(6px);
  }
  .modal-panel { position: relative; width: 100%; max-width: 620px; margin: auto; }
  .modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 2;
    width: 48px;
    height: 48px;
    border: 2px solid var(--midnight);
    border-radius: 16px;
    background: var(--canvas);
    color: var(--midnight);
    font-size: 22px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 24px -14px rgba(10, 12, 26, .5);
  }
  .modal-panel-form {
    padding: 36px;
    border-radius: 32px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .2), 0 40px 80px -50px rgba(0, 0, 0, .9);
  }
  .modal-title {
    margin: 0 0 6px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -.04em;
    line-height: 1.1;
  }
  .modal-copy { margin: 0 0 12px; color: var(--ink-body); font-size: 17px; line-height: 1.6; }
  .modal-close { transition: background-color .18s ease, transform .18s ease; }
  .modal-close:hover { background: var(--periwinkle); transform: translateY(-2px); }
  .modal-close:active { transform: none; }

  @media (max-width: 640px) {
    .modal-backdrop { padding: 30px 12px 12px; }
    .modal-close {
      top: 10px;
      right: 10px;
      width: 44px;
      height: 44px;
    }
    .modal-panel-form { padding: 26px 20px; border-radius: 22px; }
  }

  @media (max-width: 400px) {
    .field { padding-inline: 14px; }
  }
</style>
