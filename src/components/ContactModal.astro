---
const fieldStyle =
  "width:100%;font-family:'Outfit',sans-serif;font-size:15px;font-weight:400;color:#0D1B2A;background:#F4F6FF;border:1px solid rgba(13,27,42,.07);border-radius:14px;padding:15px 18px;outline:none";
---

<div
  data-modal
  hidden
  style="position:fixed;inset:0;z-index:200;background:rgba(13,27,42,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:32px;overflow-y:auto"
>
  <div data-modal-panel style="position:relative;width:100%;max-width:600px;margin:auto">
    <button
      data-close-modal
      aria-label="Cerrar"
      style="position:absolute;top:-14px;right:-14px;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#FFFFFF;color:#0D1B2A;font-size:20px;font-weight:600;cursor:pointer;box-shadow:0 2px 6px rgba(13,27,42,.2), 0 12px 28px -14px rgba(13,27,42,.5)"
      >×</button
    >
    <div
      style="border-radius: 32px; padding: 36px; box-shadow: 0 1px 2px rgba(0,0,0,.2), 0 40px 80px -50px rgba(0,0,0,.9); background-color: #FFFFFF"
    >
      <div
        style="font-family:'Urbanist',sans-serif;font-weight:800;font-size:24px;letter-spacing:-0.015em;color:#0D1B2A;margin-bottom:22px"
      >
        Agenda una llamada
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <input type="text" placeholder="Nombre completo" class="field" style={fieldStyle} />
        <input type="email" placeholder="Correo corporativo" class="field" style={fieldStyle} />
        <input type="text" placeholder="Organización" class="field" style={fieldStyle} />
        <input type="text" placeholder="Tu rol" class="field" style={fieldStyle} />
      </div>
      <div style="display:grid;grid-template-columns:110px 1fr;gap:14px;margin-top:14px">
        <input type="text" placeholder="+57" class="field" style={fieldStyle} />
        <input type="tel" placeholder="WhatsApp" class="field" style={fieldStyle} />
      </div>
      <div style="margin-top:14px">
        <select class="field" style={`${fieldStyle};appearance:none;cursor:pointer`}>
          <option>¿Cuántas personas se formarían?</option>
          <option>Menos de 10</option>
          <option>Entre 10 y 30</option>
          <option>Entre 30 y 100</option>
          <option>Más de 100</option>
        </select>
      </div>

      <div style="margin-top:14px">
        <textarea
          rows="4"
          placeholder="¿En qué procesos crees que la IA puede ayudar? (opcional)"
          class="field"
          style={`${fieldStyle};resize:vertical`}></textarea>
      </div>
      <button
        class="btn-gold"
        style="width:100%;margin-top:18px;font-family:'Outfit',sans-serif;font-size:17px;font-weight:700;color:#3B2B05;background:linear-gradient(180deg, #F7D96A 0%, #EFC13C 100%);border:0;border-radius:100px;padding:18px 24px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.75), inset 0 0 0 1px rgba(255,255,255,.35), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(196,144,24,.6)"
      >
        Enviar y agendar
      </button>
      <div style="margin-top:14px;text-align:center;font-size:13px;font-weight:400;color:#888">
        Respondemos en menos de 24 horas hábiles
      </div>
    </div>
  </div>
</div>
