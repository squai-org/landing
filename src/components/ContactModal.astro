---
import { endpoints } from '../data/landing';

const fieldStyle =
  'width:100%;font-family:var(--font-body);font-size:15px;color:#0A0C1A;background:#F4F6FF;border:1px solid #DCE1F0;border-radius:14px;padding:15px 18px;outline:none';
---

<div
  data-modal
  hidden
  class="modal-backdrop"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  style="position:fixed;inset:0;z-index:200;background:rgba(10,12,26,.6);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:32px;overflow-y:auto"
>
  <div data-modal-panel style="position:relative;width:100%;max-width:620px;margin:auto">
    <button
      type="button"
      data-close-modal
      aria-label="Cerrar"
      style="position:absolute;top:-14px;right:-14px;z-index:2;width:40px;height:40px;border:0;border-radius:50%;background:#FFFFFF;color:#0A0C1A;font-size:20px;font-weight:600;cursor:pointer;box-shadow:0 2px 6px rgba(10,12,26,.2), 0 12px 28px -14px rgba(10,12,26,.5)"
      >×</button
    >
    <form
      data-form="contact"
      data-endpoint-grow={endpoints.grow}
      data-endpoint-learn={endpoints.learn}
      novalidate
      class="card-pad-lg"
      style="border-radius:32px;padding:36px;box-shadow:0 1px 2px rgba(0,0,0,.2), 0 40px 80px -50px rgba(0,0,0,.9);background-color:#FFFFFF"
    >
      <div
        data-modal-eco
        style="font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#5F657A;margin-bottom:8px"
      >
        Squai Grow
      </div>
      <div
        id="modal-title"
        style="font-family:var(--font-display);font-weight:700;font-size:28px;letter-spacing:-0.04em;color:#0A0C1A;margin-bottom:6px"
      >
        Agenda una llamada
      </div>
      <p data-modal-copy style="margin:0 0 22px;font-size:15px;line-height:1.6;color:#4B5167">
        Cuéntanos dónde están hoy y armamos una propuesta sobre sus procesos reales, no sobre un temario genérico.
      </p>

      <div class="field-grid-2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
        <input type="text" name="full_name" required autocomplete="name" placeholder="Nombre completo" aria-label="Nombre completo" class="field" style={fieldStyle} />
        <input type="email" name="email" required autocomplete="email" placeholder="Correo corporativo" aria-label="Correo corporativo" class="field" style={fieldStyle} />
        <input type="text" name="organization" required placeholder="Organización" aria-label="Organización" class="field" style={fieldStyle} />
        <input type="text" name="role" placeholder="Tu rol" aria-label="Tu rol" class="field" style={fieldStyle} />
      </div>
      <div class="field-grid-phone" style="display:grid;grid-template-columns:110px 1fr;gap:14px;margin-top:14px">
        <input type="text" name="country_code" required value="+57" autocomplete="tel-country-code" placeholder="+57" aria-label="Indicativo" class="field" style={fieldStyle} />
        <input type="tel" name="phone" required autocomplete="tel-national" placeholder="WhatsApp" aria-label="WhatsApp" class="field" style={fieldStyle} />
      </div>
      <div style="margin-top:14px">
        <select name="team_size" class="field select-field" required aria-label="¿Cuántas personas se formarían?" style={fieldStyle}>
          <option value="" disabled selected hidden>¿Cuántas personas se formarían?</option>
          <option value="menos-10">Menos de 10</option>
          <option value="10-30">Entre 10 y 30</option>
          <option value="30-100">Entre 30 y 100</option>
          <option value="mas-100">Más de 100</option>
        </select>
      </div>
      <div style="margin-top:14px">
        <textarea
          rows="4"
          name="message"
          data-modal-textarea
          placeholder="¿En qué procesos crees que la IA puede ayudar? (opcional)"
          aria-label="Mensaje"
          class="field"
          style={`${fieldStyle};resize:vertical`}></textarea>
      </div>
      <button
        type="submit"
        class="btn-gold"
        style="width:100%;margin-top:18px;font-family:var(--font-body);font-size:17px;font-weight:700;color:#3B2B05;background:linear-gradient(180deg, #F7D96A 0%, #EFC13C 100%);border:0;border-radius:100px;padding:18px 24px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.75), inset 0 0 0 1px rgba(255,255,255,.35), 0 1px 2px rgba(13,27,42,.14), 0 8px 18px -10px rgba(196,144,24,.6)"
      >
        Enviar y agendar
      </button>
      <div class="form-status" data-form-status role="status" aria-live="polite">
        Respondemos en menos de 24 horas hábiles.
      </div>
    </form>
  </div>
</div>
