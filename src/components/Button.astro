---
interface Props {
  variant?: 'gold' | 'teal' | 'dark' | 'ghost' | 'white';
  href?: string;
  type?: 'button' | 'submit';
  block?: boolean;
  plain?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'gold',
  href,
  type = 'button',
  block = false,
  plain = false,
  disabled = false,
  class: extraClass = '',
  ...rest
} = Astro.props;

const classes = ['btn', `btn-${variant}`, block ? 'btn-block' : '', plain ? 'btn-plain' : '', extraClass]
  .filter(Boolean)
  .join(' ');

// A blunt, heavy arrow — the thin stock chevron reads as a stock icon.
const ARROW = 'M3.5 12h13.2M11.4 5.2 18.5 12l-7.1 6.8';
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : type} disabled={href ? undefined : disabled} {...rest}>
  {
    !plain && (
      <span class="btn-lead" aria-hidden="true">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="butt" stroke-linejoin="miter">
          <path d={ARROW} />
        </svg>
      </span>
    )
  }
  <span class="btn-label"><slot /></span>
  {
    !plain && (
      <span class="btn-tail" aria-hidden="true">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="butt" stroke-linejoin="miter">
          <path d={ARROW} />
        </svg>
      </span>
    )
  }
</Tag>
