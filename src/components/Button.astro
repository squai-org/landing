---
interface Props {
  variant?: 'gold' | 'teal' | 'dark' | 'ghost';
  href?: string;
  type?: 'button' | 'submit';
  icon?: 'arrow' | 'linkedin';
  block?: boolean;
  compact?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'gold',
  href,
  type = 'button',
  icon = 'arrow',
  block = false,
  compact = false,
  disabled = false,
  class: extraClass = '',
  ...rest
} = Astro.props;

const classes = [
  'btn',
  `btn-${variant}`,
  block ? 'btn-block' : '',
  compact ? 'btn-compact' : '',
  extraClass,
]
  .filter(Boolean)
  .join(' ');

// A blunt, heavy arrow — the thin stock chevron reads as a stock icon.
const ARROW = 'M3.5 12h13.2M11.4 5.2 18.5 12l-7.1 6.8';
const LINKEDIN =
  'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C21.4 8.65 22 11 22 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.57-2.3 3.2V21h-4V9Z';
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : type} disabled={href ? undefined : disabled} {...rest}>
  <slot />
  <span class="btn-icon" aria-hidden="true">
    {
      icon === 'linkedin' ? (
        <Fragment>
          <svg class="ico-a" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d={LINKEDIN} />
          </svg>
          <svg class="ico-b" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d={LINKEDIN} />
          </svg>
        </Fragment>
      ) : (
        <Fragment>
          <svg class="ico-a" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="butt" stroke-linejoin="miter">
            <path d={ARROW} />
          </svg>
          <svg class="ico-b" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.1" stroke-linecap="butt" stroke-linejoin="miter">
            <path d={ARROW} />
          </svg>
        </Fragment>
      )
    }
  </span>
</Tag>
