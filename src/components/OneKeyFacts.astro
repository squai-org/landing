---
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import CornerBlocks from './CornerBlocks.astro';
import type { CornerPreset } from '../lib/corner-presets';
import { durationInHours, sessionLength, totalSessions } from '../lib/course-load';
import type { Service } from '../lib/content';
import live from '../assets/one/incluye/incluye-1.svg';
import recordings from '../assets/one/incluye/incluye-2.svg';
import guides from '../assets/one/incluye/incluye-3.svg';
import certificate from '../assets/one/incluye/incluye-4.svg';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const facts = service.keyFacts!;
const hero = service.hero!;
const { load, labels } = facts;

const tiles = [
  { label: labels.duration, value: `${load.weeks} semanas · ${durationInHours(load)} horas` },
  { label: labels.sessions, value: `${totalSessions(load)} sesiones de ${sessionLength(load.sessionMinutes)}, ${load.sessionsPerWeek} por semana` },
  { label: labels.dates, value: hero.datesPending, cohort: 'dates' },
  { label: labels.schedule, value: hero.schedulePending, cohort: 'schedule' },
  { label: labels.modality, value: facts.modality },
  { label: labels.seats, value: facts.seats },
];

const cards: { image: ImageMetadata; corners: CornerPreset; tilt: string; tone: string }[] = [
  { image: live, corners: 'diagonal-a', tilt: '-2deg', tone: 'one-card-soft' },
  { image: recordings, corners: 'diagonal-b', tilt: '1.8deg', tone: 'one-card-strong' },
  { image: guides, corners: 'left-pair', tilt: '-1.6deg', tone: 'one-card-mid' },
  { image: certificate, corners: 'right-pair', tilt: '2deg', tone: 'one-card-solid' },
];
---

<section class="section one-facts" id="datos-clave" aria-labelledby="one-facts-title">
  <div class="shell">
    <header class="one-facts-heading">
      <h2 id="one-facts-title" class="display d-h2 one-facts-title">{facts.title}</h2>
      <p class="lead one-facts-lead">{facts.lead}</p>
      <p class="one-facts-handwritten">{facts.handwritten}</p>
    </header>

    <dl class="one-facts-strip">
      {
        tiles.map((tile) => (
          <div class="one-facts-tile">
            <dt>{tile.label}</dt>
            <dd data-cohort-dates={tile.cohort === 'dates' ? '' : undefined} data-cohort-schedule={tile.cohort === 'schedule' ? '' : undefined}>{tile.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="one-facts-cards">
      {
        facts.includes.map((item, index) => (
          <li class="one-facts-card-host corner-host" style={`--card-tilt:${cards[index].tilt}`}>
            <CornerBlocks preset={cards[index].corners} hoverOnly />
            <article class={`one-facts-card ${cards[index].tone}`}>
              <img src={cards[index].image.src} alt="" width={cards[index].image.width} height={cards[index].image.height} loading="lazy" decoding="async" />
              <h3 class="display d-h3">{item.t}</h3>
              <p class="body">{item.d}</p>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="one-facts-action">
      <Button variant="dark" arrow href={`#${service.cta.target}`} data-scroll-to={service.cta.target}>{service.cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .one-facts { background: var(--canvas); }
  .one-facts-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2vw, 24px);
    max-width: 760px;
    margin: 0 auto clamp(28px, 4vw, 56px);
    text-align: center;
  }
  .one-facts-title { margin: 0; color: var(--ink); }
  .one-facts-lead { color: var(--ink-body); }
  .one-facts-handwritten {
    margin: 0;
    font-family: var(--font-hand);
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.35;
    color: var(--accent-ink);
    rotate: -1.6deg;
  }
  .one-facts-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 0 0 clamp(36px, 5vw, 72px);
  }
  .one-facts-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 22px;
    background: var(--accent-soft);
    color: var(--midnight);
    border-radius: var(--radius-lg);
  }
  .one-facts-tile dt {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .one-facts-tile dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .one-facts-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 3vw, 44px);
    margin: 0;
    padding: 0 0 8px;
    list-style: none;
  }
  .one-facts-card-host { position: relative; rotate: var(--card-tilt, 0deg); }
  .one-facts-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: clamp(20px, 2vw, 28px);
    border-radius: var(--radius-xl);
    color: var(--midnight);
    box-shadow: var(--shadow-float);
  }
  .one-facts-card img { display: block; width: 100%; height: auto; aspect-ratio: 1400 / 1365; }
  .one-facts-card h3 { margin: 0; color: var(--midnight); }
  .one-facts-card p { color: var(--midnight); }
  .one-card-soft { background: var(--periwinkle-2); }
  .one-card-strong { background: var(--periwinkle-4); }
  .one-card-mid { background: var(--periwinkle-3); }
  .one-card-solid { background: var(--periwinkle-9); }
  .one-facts-action { display: flex; justify-content: center; margin-top: clamp(32px, 4vw, 56px); }

  @media (min-width: 640px) {
    .one-facts-strip { grid-template-columns: repeat(2, 1fr); }
    .one-facts-cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .one-facts-strip { grid-template-columns: repeat(3, 1fr); }
    .one-facts-cards { grid-template-columns: repeat(4, 1fr); }
    .one-facts-card-host:nth-child(2) { translate: 0 24px; }
    .one-facts-card-host:nth-child(4) { translate: 0 28px; }
  }
</style>
