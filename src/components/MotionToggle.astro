---
interface Props {
  pauseLabel: string;
  resumeLabel: string;
}

const { pauseLabel, resumeLabel } = Astro.props;
---

<button
  type="button"
  class="motion-toggle"
  data-motion-toggle
  data-pause-label={pauseLabel}
  data-resume-label={resumeLabel}
  hidden
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <g class="motion-toggle-pause" fill="currentColor">
      <rect x="6" y="5" width="4.5" height="14" rx="1.2"></rect>
      <rect x="13.5" y="5" width="4.5" height="14" rx="1.2"></rect>
    </g>
    <path class="motion-toggle-play" d="M8 5.5v13l11-6.5z" fill="currentColor"></path>
  </svg>
  <span data-motion-toggle-label>{pauseLabel}</span>
</button>
