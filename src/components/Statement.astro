---
import { statement } from '../data/landing';
---

<section id="statement" class="section" style="background:var(--periwinkle)">
  <div class="shell grid-sidebar" style="display:grid;grid-template-columns:0.8fr 1.2fr;gap:clamp(32px,5vw,80px);align-items:start">
    <h2 class="display d-h2 sidebar-sticky" style="position:sticky;top:120px;color:var(--midnight);max-width:16ch">
      {statement.headline}
    </h2>
    <div style="display:flex;flex-direction:column;gap:20px">
      {statement.body.map((para) => <p class="lead" style="color:var(--midnight);opacity:.9">{para}</p>)}
    </div>
  </div>
</section>
