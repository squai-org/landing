---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pageTitle: string;
  updated: string;
}

const { title, description, pageTitle, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <div style="padding: 0 0 40px; background-color: #F4F6FF">
    <Header />

    <main id="contenido" class="content-shell legal-content" style="max-width:880px;margin:150px auto 0;padding:0 32px 80px">
      <h1
        class="h2-title"
        style="margin:0;font-family:var(--font-display);font-weight:700;font-size:var(--t-h2);line-height:1;letter-spacing:-0.05em;color:#0A0C1A"
      >
        {pageTitle}
      </h1>
      <p style="margin:10px 0 40px;font-size:17px;color:var(--ink-muted)">Última actualización: {updated}</p>

      <div
        class="legal-card"
        style="background:#FFFFFF;border:1px solid rgba(13,27,42,.07);border-radius:28px;padding:clamp(24px,4vw,48px);box-shadow:0 1px 2px rgba(13,27,42,.03), 0 24px 60px -40px rgba(13,27,42,.35);display:flex;flex-direction:column;gap:28px"
      >
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</Layout>
