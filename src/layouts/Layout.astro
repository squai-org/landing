---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { getSiteContent } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
}

const { title, description, image, imageAlt, type, noindex, schemas } = Astro.props;
const { ui } = await getSiteContent();

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      schemas={schemas}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/familjen-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Las animaciones de entrada (.reveal) se ocultan por CSS solo si esta
      // clase esta presente, y solo se anade cuando el JS puede garantizar que
      // va a revelarlas. Va aqui, sincrono y antes de pintar, para que no haya
      // un parpadeo de contenido visible que se oculta.
      if (
        'IntersectionObserver' in window &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
    <script is:inline>
      window.squaiTurnstileSync = function () {
        document.querySelectorAll('form[data-form]').forEach(function (form) {
          if (!form.querySelector('.cf-turnstile')) return;
          var token = form.querySelector('input[name="cf-turnstile-response"]');
          var submit = form.querySelector('button[type="submit"]');
          if (submit) submit.disabled = !(token && token.value);
        });
      };
      document.addEventListener('DOMContentLoaded', window.squaiTurnstileSync);
    </script>
    {
      turnstileSiteKey && (
        <>
          <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
          <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
        </>
      )
    }
  </head>
  <body data-client-copy={JSON.stringify({ navigation: ui.navigation, modal: ui.modal, feedback: ui.feedback, contact: ui.contact })}>
    <a class="skip-link" href="#contenido">{ui.skip}</a>
    <slot />
  </body>
</html>

<script>
  import type { ClientCopy } from '../lib/content';

  const clientCopy: ClientCopy = JSON.parse(document.body.dataset.clientCopy!);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const navOffset = () => {
    const bar = document.querySelector<HTMLElement>('.nav-bar');
    return (bar ? bar.getBoundingClientRect().bottom : 96) + 28;
  };

  const scrollToSection = (id: string, instant = false) => {
    const el = document.getElementById(id);
    if (!el) return;
    const topPadding = parseFloat(getComputedStyle(el).paddingTop) || 0;
    const target = el.getBoundingClientRect().top + window.scrollY + topPadding - navOffset();
    if (prefersReducedMotion || instant) {
      window.scrollTo(0, target);
      return;
    }
    const start = window.scrollY;
    const dist = target - start;
    const dur = 450;
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const step = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      window.scrollTo(0, start + dist * ease(p));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if (location.hash.length > 1) {
    const targetId = decodeURIComponent(location.hash.slice(1));
    if (document.getElementById(targetId)) scrollToSection(targetId, true);
  }

  document.querySelectorAll<HTMLElement>('[data-scroll-to]').forEach((el) => {
    el.addEventListener('click', (event) => {
      const id = el.dataset.scrollTo!;
      if (!id || !document.getElementById(id)) return;
      event.preventDefault();
      scrollToSection(id);
    });
  });

  const header = document.querySelector<HTMLElement>('[data-header]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (header) {
    const scrollCue = document.querySelector<HTMLElement>('[data-hero-scroll]');

    /* El header va en claro mientras el hero siga ocupando la franja que hay
       debajo de el. Eso se sabia leyendo `hero.offsetTop + hero.offsetHeight`,
       una lectura de geometria que obligaba al navegador a calcular el layout
       de forma sincrona nada mas cargar: 24 ms sobre 342 de 377 objetos en el
       trace, el reflow forzado mas caro de la pagina.

       Un IntersectionObserver con el borde superior recortado 96px da la misma
       condicion sin leer geometria: el observador se cruza mientras
       `scrollY < heroTop + heroHeight - 96`, que es exactamente lo que
       calculaba la resta. El navegador lo resuelve en su propio ciclo, y se
       actualiza solo al cambiar el viewport sin necesidad de un listener.
       https://developer.mozilla.org/en-US/docs/Web/API/Intersection_Observer_API */
    if (hero) {
      new IntersectionObserver(
        ([entry]) => header.classList.toggle('over-hero', entry.isIntersecting),
        { rootMargin: '-96px 0px 0px 0px', threshold: 0 }
      ).observe(hero);
    } else {
      /* Las paginas legales no tienen hero: el header va siempre en oscuro.
         La clase viene puesta desde el servidor, asi que hay que quitarla. */
      header.classList.remove('over-hero');
    }

    /* scrollY no obliga a recalcular el layout, asi que esto puede seguir
       colgado del scroll. */
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          scrollCue?.classList.toggle('is-hidden', window.scrollY > 24);
          ticking = false;
        });
      },
      { passive: true }
    );
  }

  /* La clase la pone el script sincrono del <head>, que es tambien lo que el
     CSS mira para ocultar. Leerla aqui en vez de repetir la condicion evita que
     las dos comprobaciones se separen y quede contenido oculto sin nadie que lo
     revele. */
  if (document.documentElement.classList.contains('js-reveal')) {
    const targets = new Set<HTMLElement>();

    const addReveal = (el: HTMLElement, kind: string, delay = 0) => {
      el.dataset.revealKind = kind;
      el.style.setProperty('--reveal-delay', `${delay}ms`);
      targets.add(el);
    };

    document.querySelectorAll<HTMLElement>('.section').forEach((section) => {
      const cards = Array.from(section.querySelectorAll<HTMLElement>('.bento-card'));
      cards.forEach((card, index) => addReveal(card, card.classList.contains('faq-item') ? 'faq' : 'card', index * 60));

      const teamMembers = Array.from(section.querySelectorAll<HTMLElement>('.team-member'));
      teamMembers.forEach((member, index) => addReveal(member, 'card', (index % 2) * 70));

      const waitlistColumn = section.querySelector<HTMLElement>('.waitlist-column');
      if (waitlistColumn) addReveal(waitlistColumn, 'copy');

      const teamHeading = section.querySelector<HTMLElement>('.team-heading');
      if (teamHeading) {
        Array.from(teamHeading.children).forEach((child, index) =>
          addReveal(child as HTMLElement, index === 0 ? 'heading' : 'copy', index * 70)
        );
      }

      const root = section.querySelector<HTMLElement>(':scope > .shell');
      if (!root) return;

      Array.from(root.children).forEach((child, index) => {
        const el = child as HTMLElement;
        if (targets.has(el) || el.querySelector('.bento-card, .team-member, .waitlist-column')) return;

        const isSidebar = root.classList.contains('grid-sidebar');
        const kind = isSidebar
          ? index === 0 ? 'sidebar-title' : 'sidebar-copy'
          : el.matches('h1, h2, h3, .display') ? 'heading' : 'copy';
        addReveal(el, kind, index * 70);
      });
    });

    document.querySelectorAll<HTMLElement>('.hero-inner, .service-hero-inner').forEach((heroInner) => {
      Array.from(heroInner.children).forEach((child, i) => {
        const el = child as HTMLElement;
        addReveal(el, i === 0 ? 'copy' : i === 1 ? 'heading' : 'copy', i * 70);
      });
    });

    document.querySelectorAll<HTMLElement>('.footer-grid > *').forEach((column, index) =>
      addReveal(column, 'copy', index * 60)
    );
    const footerBottom = document.querySelector<HTMLElement>('.footer-bottom');
    if (footerBottom) addReveal(footerBottom, 'copy', 120);

    targets.forEach((el) => el.classList.add('reveal'));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
    );

    const riseEls = Array.from(document.querySelectorAll<HTMLElement>('.service-title-rise'));

    if (riseEls.length) {
      type Rise = { el: HTMLElement; card: HTMLElement; gap: number; current: number; target: number };
      let rises: Rise[] = [];

      /* Escribir y leer geometria alternadamente dentro del mismo bucle obliga al
         navegador a recalcular el layout en cada vuelta. Se separa en tres
         pasadas —quitar transformaciones, medir, restaurarlas— para que haga un
         solo recalculo por pasada en vez de uno por elemento.
         https://developer.mozilla.org/en-US/docs/Web/Performance/Guides/Reflow */
      const measureRises = () => {
        const prev = new Map(rises.map((r) => [r.el, r]));
        rises = [];

        const pending: { el: HTMLElement; card: HTMLElement; body: HTMLElement; transform: string }[] = [];
        riseEls.forEach((el) => {
          const card = el.closest<HTMLElement>('.bento-card');
          const body = card?.querySelector<HTMLElement>('.body');
          if (!card || !body) return;
          pending.push({ el, card, body, transform: el.style.transform });
        });

        /* En la primera medicion todavia no hay transformacion aplicada: escribir
           'none' solo invalidaria el estilo para dejarlo igual. */
        const dirty = pending.filter(({ transform }) => transform !== '');
        dirty.forEach(({ el }) => { el.style.transform = 'none'; });
        const gaps = pending.map(({ el, body }) => el.getBoundingClientRect().top - body.getBoundingClientRect().bottom);
        dirty.forEach(({ el, transform }) => { el.style.transform = transform; });

        pending.forEach(({ el, card }, index) => {
          const gap = gaps[index];
          if (gap <= 0) return;
          const carried = prev.get(el);
          rises.push({ el, card, gap, current: carried?.current ?? -gap, target: carried?.target ?? -gap });
        });
      };

      const computeTargets = () => {
        const vh = window.innerHeight;
        const navBottom = navOffset();
        rises.forEach((r) => {
          const bottom = r.card.getBoundingClientRect().bottom;
          const settled = Math.min(Math.max(vh - bottom, 0), r.gap);
          const raw = settled - r.gap;
          const naturalTop = r.el.getBoundingClientRect().top - r.current;
          const minTarget = Math.min(navBottom - naturalTop, 0);
          r.target = Math.max(raw, minTarget);
        });
      };

      /* computeTargets lee geometria y tick la escribe. Colgando computeTargets
         del evento de scroll, cada scroll leia despues de la escritura del
         ultimo frame y forzaba un layout sincrono, y los eventos de scroll son
         mucho mas frecuentes que los frames. Ahora los dos viven en el mismo
         frame y en el orden correcto: primero todas las lecturas, despues todas
         las escrituras, como maximo una vez por frame. */
      let needsMeasure = false;
      let needsCompute = false;

      const tick = () => {
        if (needsMeasure) { measureRises(); needsMeasure = false; needsCompute = true; }
        if (needsCompute) { computeTargets(); needsCompute = false; }

        rises.forEach((r) => {
          const diff = r.target - r.current;
          r.current = Math.abs(diff) < 0.05 ? r.target : r.current + diff * 0.12;
          r.el.style.transform = r.current === 0 ? '' : `translateY(${r.current}px)`;
        });
        requestAnimationFrame(tick);
      };

      /* La primera medicion espera al primer frame. Corriendo antes de que el
         navegador haya hecho su layout inicial, la lectura lo fuerza entero
         (342 de 377 objetos en el trace) y se paga dentro del script. */
      needsMeasure = true;
      window.addEventListener('scroll', () => { needsCompute = true; }, { passive: true });
      window.addEventListener('resize', () => { needsMeasure = true; });
      requestAnimationFrame(tick);
    }

    targets.forEach((el) => io.observe(el));
  }

  const navToggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
  const navMenu = document.querySelector<HTMLElement>('[data-nav-menu]');

  const setNavOpen = (open: boolean) => {
    navMenu?.classList.toggle('nav-open', open);
    navToggle?.setAttribute('aria-expanded', String(open));
    navToggle?.setAttribute('aria-label', open ? clientCopy.navigation.close : clientCopy.navigation.open);
  };

  navToggle?.addEventListener('click', () => {
    setNavOpen(!navMenu?.classList.contains('nav-open'));
  });

  navMenu?.querySelectorAll('a').forEach((el) => {
    el.addEventListener('click', () => setNavOpen(false));
  });

  document.addEventListener('click', (event) => {
    if (!navMenu?.classList.contains('nav-open')) return;
    const target = event.target as Node;
    if (navMenu.contains(target) || navToggle?.contains(target)) return;
    setNavOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !navMenu?.classList.contains('nav-open')) return;
    setNavOpen(false);
    navToggle?.focus();
  });

  const desktopNav = window.matchMedia('(min-width: 1024px)');
  desktopNav.addEventListener('change', (event) => {
    if (event.matches) setNavOpen(false);
  });

  const navSectionLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-section]'));
  if (location.pathname === '/' && navSectionLinks.length && 'IntersectionObserver' in window) {
    const currentSectionObserver = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        navSectionLinks.forEach((link) => {
          if (link.dataset.navSection === visible.target.id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: [0, .25, .5] }
    );
    navSectionLinks.forEach((link) => {
      const section = document.getElementById(link.dataset.navSection || '');
      if (section) currentSectionObserver.observe(section);
    });
  }

  let openFaq: string | null = null;

  document.querySelectorAll<HTMLElement>('[data-faq-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const index = toggle.dataset.faqToggle!;
      openFaq = openFaq === index ? null : index;

      document.querySelectorAll<HTMLElement>('[data-faq-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.faqPanel !== openFaq;
      });
      document.querySelectorAll<HTMLElement>('[data-faq-sign]').forEach((sign) => {
        sign.textContent = sign.dataset.faqSign === openFaq ? '−' : '+';
      });
      document.querySelectorAll<HTMLElement>('[data-faq-toggle]').forEach((btn) => {
        btn.setAttribute('aria-expanded', String(btn.dataset.faqToggle === openFaq));
      });
    });
  });

  interface ApiResponse {
    ok: boolean;
    error?: { code: string; message: string; fields?: Record<string, string> };
  }

  /* El modal reparte el formulario en pasos, y en el ultimo el formulario entero
     se oculta. El mensaje de estado vive fuera de el para seguir visible y
     anunciado ahi; en los formularios de una sola pieza sigue estando dentro. */
  const statusNode = (form: HTMLFormElement) =>
    form.querySelector<HTMLElement>('[data-form-status]') ??
    form.parentElement?.querySelector<HTMLElement>('[data-form-status]') ??
    null;

  const setStatus = (form: HTMLFormElement, text: string, state: '' | 'ok' | 'error') => {
    const status = statusNode(form);
    if (!status) return;
    status.textContent = text;
    if (state) status.dataset.state = state;
    else delete status.dataset.state;
  };

  const clearFieldErrors = (scope: HTMLElement) => {
    scope.querySelectorAll<HTMLElement>('[data-field-error]').forEach((error) => { error.textContent = ''; });
    scope.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((field) => field.removeAttribute('aria-invalid'));
  };

  const setFieldError = (form: HTMLFormElement, name: string, message: string) => {
    const field = form.elements.namedItem(name);
    const error = form.querySelector<HTMLElement>(`[data-field-error="${CSS.escape(name)}"]`);
    if (field instanceof HTMLElement) field.setAttribute('aria-invalid', 'true');
    if (error) error.textContent = message;
  };

  /* Los combobox de CustomSelect no son controles nativos: su valor viaja en un
     input type=hidden, que esta excluido de la validacion de restricciones. Lo
     obligatorio se comprueba aqui y se marca sobre el boton disparador, que es
     el elemento que el lector de pantalla anuncia y al que puede llegar el foco.
     https://www.w3.org/WAI/ARIA/apg/patterns/combobox/ */
  const invalidCustomSelects = (scope: HTMLElement) =>
    Array.from(scope.querySelectorAll<HTMLElement>('[data-custom-select][data-select-required="true"]')).filter(
      (root) => !root.querySelector<HTMLInputElement>('[data-select-value]')?.value
    );

  const markCustomSelect = (root: HTMLElement) => {
    const trigger = root.querySelector<HTMLElement>('[data-select-trigger]');
    const error = root.querySelector<HTMLElement>('[data-field-error]');
    trigger?.setAttribute('aria-invalid', 'true');
    if (error) error.textContent = root.dataset.selectMessage ?? '';
    return trigger;
  };

  const modal = document.querySelector<HTMLElement>('[data-modal]');
  const modalPanel = document.querySelector<HTMLElement>('[data-modal-panel]');
  const modalForm = document.querySelector<HTMLFormElement>('[data-form="contact"]');
  const stepPanels = modal ? Array.from(modal.querySelectorAll<HTMLElement>('[data-step-panel]')) : [];
  const totalSteps = stepPanels.length;
  /* El ultimo paso es el calendario: cuando se llega ahi la fila en la base de
     datos ya esta escrita, asi que no hay nada que reenviar ni a donde volver. */
  const bookingStep = totalSteps;

  const MODAL_COPY: Record<string, { title: string; copy: string; placeholder: string }> = clientCopy.modal;
  const CONTACT_COPY = clientCopy.contact;

  let currentStep = 1;
  let currentEco = 'grow';
  let submitted = false;
  let lastFocused: HTMLElement | null = null;
  let backgroundInertState = new Map<HTMLElement, boolean>();

  const stepOf = (element: Element | null | undefined) => {
    const panel = element?.closest<HTMLElement>('[data-step-panel]');
    return panel ? Number(panel.dataset.stepPanel) : null;
  };

  const setBackgroundInert = (inert: boolean) => {
    if (!modal) return;
    const background = Array.from(document.body.children).filter(
      (element): element is HTMLElement => element instanceof HTMLElement && element !== modal && element.tagName !== 'SCRIPT'
    );
    if (inert) {
      backgroundInertState = new Map(background.map((element) => [element, element.inert]));
      background.forEach((element) => { element.inert = true; });
      return;
    }
    backgroundInertState.forEach((wasInert, element) => { element.inert = wasInert; });
    backgroundInertState.clear();
  };

  /* El iframe de Google se pide solo al llegar al paso de la agenda: hasta
     entonces nadie que no vaya a reservar carga nada de calendar.google.com. */
  const loadBookingFrame = () => {
    const frame = modal?.querySelector<HTMLIFrameElement>('[data-booking-frame]');
    if (!frame || frame.getAttribute('src')) return;
    const src = frame.dataset.bookingSrc;
    if (src) frame.setAttribute('src', src);
  };

  const stepHeading = (step: number) => {
    if (step === 1) return MODAL_COPY[currentEco] ?? MODAL_COPY.grow;
    if (step === bookingStep) return CONTACT_COPY.booking;
    return CONTACT_COPY.context;
  };

  const setStep = (step: number, { moveFocus = true } = {}) => {
    if (!modal || !totalSteps) return;
    currentStep = Math.min(Math.max(step, 1), totalSteps);

    stepPanels.forEach((panel) => { panel.hidden = Number(panel.dataset.stepPanel) !== currentStep; });
    modal.querySelectorAll<HTMLElement>('[data-step-actions]').forEach((actions) => {
      actions.hidden = Number(actions.dataset.stepActions) !== currentStep;
    });
    modalPanel?.setAttribute('data-step', String(currentStep));
    if (modalForm) modalForm.hidden = currentStep === bookingStep;

    modal.querySelectorAll<HTMLElement>('[data-stepper-item]').forEach((item) => {
      const index = Number(item.dataset.stepperItem);
      item.dataset.state = index === currentStep ? 'current' : index < currentStep ? 'done' : 'todo';
    });

    const counter = modal.querySelector<HTMLElement>('[data-step-counter]');
    if (counter) {
      counter.textContent = CONTACT_COPY.counter
        .replace('{current}', String(currentStep))
        .replace('{total}', String(totalSteps));
    }

    const heading = stepHeading(currentStep);
    const title = modal.querySelector<HTMLElement>('[data-modal-title]');
    const copy = modal.querySelector<HTMLElement>('[data-modal-copy]');
    if (title) title.textContent = heading.title;
    if (copy) copy.textContent = heading.copy;

    if (currentStep === bookingStep) loadBookingFrame();

    /* Cada paso empieza arriba, con su titulo y el progreso a la vista. El foco
       va sin arrastrar el scroll: enfocar un panel alto lo subiria al borde de
       la ventana y dejaria la cabecera del modal fuera de plano. */
    if (moveFocus) stepPanels.find((panel) => !panel.hidden)?.focus({ preventScroll: true });
    modal.scrollTop = 0;
  };

  /* Un campo que falta puede haber quedado en un paso que ya no esta a la vista
     (lo devuelve el servidor, o se envia desde el ultimo paso). Un elemento
     oculto no admite foco, asi que primero hay que volver a su paso. */
  const focusInvalid = (field: HTMLElement | null | undefined) => {
    if (!field) return;
    const step = stepOf(field);
    if (step && step !== currentStep) setStep(step, { moveFocus: false });
    field.focus();
  };

  /** Valida solo lo que hay dentro de `scope`. `true` si no falta nada. */
  const validateScope = (form: HTMLFormElement, scope: HTMLElement) => {
    clearFieldErrors(scope);

    const invalidFields = Array.from(
      scope.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')
    ).filter((field) => !field.checkValidity());
    const customSelects = invalidCustomSelects(scope);
    if (!invalidFields.length && !customSelects.length) return true;

    invalidFields.forEach((field) => setFieldError(form, field.name, field.validationMessage));
    const customTriggers = customSelects.map(markCustomSelect);
    setStatus(form, clientCopy.feedback.invalid, 'error');
    /* El primero en el orden del documento, sea nativo o no, para que el foco
       no salte hacia atras. */
    const firstInvalid = [...invalidFields, ...customTriggers].filter(Boolean).sort((a, b) =>
      a!.compareDocumentPosition(b!) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1
    )[0];
    focusInvalid(firstInvalid);
    return false;
  };

  const setModal = (open: boolean, eco?: string) => {
    if (!modal) return;

    if (open) {
      if (eco && MODAL_COPY[eco]) currentEco = eco;
      modalForm?.setAttribute('data-eco', currentEco);
      const textarea = modal.querySelector<HTMLTextAreaElement>('[data-modal-textarea]');
      if (textarea) textarea.placeholder = MODAL_COPY[currentEco].placeholder;

      /* Tras un envio completado se vuelve a empezar de cero. Si solo se cerro a
         medias, los pasos siguen como estaban: reabrir no borra lo escrito, que
         es la causa mas tonta de abandonar un formulario. */
      if (submitted) {
        submitted = false;
        if (modalForm) setStatus(modalForm, CONTACT_COPY.responseTime, '');
        setStep(1, { moveFocus: false });
      } else {
        setStep(currentStep, { moveFocus: false });
      }
    }

    modal.hidden = !open;
    setBackgroundInert(open);
    document.body.style.overflow = open ? 'hidden' : '';

    if (open) {
      const panel = stepPanels.find((item) => !item.hidden);
      const field = panel?.querySelector<HTMLElement>(
        'input:not([type="hidden"]), textarea, [data-select-trigger], [data-country-trigger]'
      );
      (field ?? panel)?.focus({ preventScroll: true });
      modal.scrollTop = 0;
    } else {
      lastFocused?.focus();
    }
  };

  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((el) => {
    el.addEventListener('click', () => {
      lastFocused = el;
      setModal(true, el.dataset.openModal || 'grow');
    });
  });
  document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((el) => {
    el.addEventListener('click', () => setModal(false));
  });

  modal?.querySelectorAll<HTMLElement>('[data-step-next]').forEach((button) => {
    button.addEventListener('click', () => {
      const panel = stepPanels.find((item) => Number(item.dataset.stepPanel) === currentStep);
      if (!modalForm || !panel) return;
      if (!validateScope(modalForm, panel)) return;
      setStatus(modalForm, CONTACT_COPY.responseTime, '');
      setStep(currentStep + 1);
    });
  });

  modal?.querySelectorAll<HTMLElement>('[data-step-back]').forEach((button) => {
    button.addEventListener('click', () => setStep(currentStep - 1));
  });

  modal?.addEventListener('click', () => setModal(false));
  modalPanel?.addEventListener('click', (event) => event.stopPropagation());

  /* En fase de captura a proposito: los desplegables cierran su panel con su
     propio Escape, que corre despues. Si este se leyera en burbujeo, el panel ya
     estaria cerrado y el mismo Escape se llevaria por delante el modal entero. */
  document.addEventListener('keydown', (event) => {
    if (!modal || modal.hidden) return;

    if (event.key === 'Escape') {
      /* Con un desplegable abierto, Escape es suyo: cerrarlo y el modal a la vez
         echaria fuera a quien solo queria descartar la lista. */
      if (modal.querySelector('[data-select-panel]:not([hidden]), [data-country-panel]:not([hidden])')) return;
      setModal(false);
      return;
    }

    if (event.key !== 'Tab') return;

    /* Solo lo que esta a la vista: los pasos ocultos siguen en el DOM y, si
       contaran, el ciclo del tabulador terminaria en un elemento inalcanzable. */
    const focusables = Array.from(
      modal.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])'
      )
    ).filter((element) => element.getClientRects().length > 0);
    if (!focusables.length) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  }, true);

  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    form.addEventListener('input', (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return;
      field.removeAttribute('aria-invalid');
      const error = form.querySelector<HTMLElement>(`[data-field-error="${CSS.escape(field.name)}"]`);
      if (error) error.textContent = '';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!validateScope(form, form)) return;

      const kind = form.dataset.form!;
      const eco = form.dataset.eco || 'grow';
      const endpoint =
        kind === 'contact' ? form.dataset[eco === 'learn' ? 'endpointLearn' : 'endpointGrow'] : form.dataset.endpoint;
      if (!endpoint) return;

      const payload: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        payload[key] = String(value).trim();
      });
      if (kind === 'contact') payload.ecosystem = eco;

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const labelNode = submit?.querySelector<HTMLElement>('.btn-label');
      const label = labelNode?.textContent ?? '';
      if (submit) {
        submit.disabled = true;
        submit.setAttribute('aria-busy', 'true');
      }
      if (labelNode) labelNode.textContent = clientCopy.feedback.sending;
      setStatus(form, clientCopy.feedback.sending, '');

      const fallbackError = clientCopy.feedback.error;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = (await res.json().catch(() => null)) as ApiResponse | null;

        if (!res.ok) {
          if (data?.error?.fields) {
            Object.entries(data.error.fields).forEach(([name, message]) => setFieldError(form, name, message));
          }
          const fieldMessage = data?.error?.fields ? Object.values(data.error.fields)[0] : undefined;
          setStatus(form, fieldMessage ?? data?.error?.message ?? fallbackError, 'error');
          focusInvalid(form.querySelector<HTMLElement>('[aria-invalid="true"]'));
          return;
        }

        form.reset();
        clearFieldErrors(form);

        if (kind === 'contact') {
          /* La fila ya esta guardada. Aunque cierre el modal sin reservar, el
             lead no se pierde: el calendario es el paso de despues, no el
             requisito para quedar registrado. */
          submitted = true;
          setStatus(form, clientCopy.feedback.contactSuccess, 'ok');
          setStep(bookingStep);
        } else {
          setStatus(form, clientCopy.feedback.waitlistSuccess, 'ok');
        }
      } catch {
        setStatus(form, fallbackError, 'error');
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.removeAttribute('aria-busy');
        }
        if (labelNode) labelNode.textContent = label;
        const widget = form.querySelector<HTMLElement>('.cf-turnstile');
        if (widget) {
          window.turnstile?.reset(widget);
          window.squaiTurnstileSync?.();
        }
      }
    });
  });
</script>
