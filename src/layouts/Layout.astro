---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/urbanist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/outfit-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  // Smooth scroll to a section, matching the easing and 96px offset of the design.
  const scrollToSection = (id: string) => {
    const el = document.getElementById(id);
    if (!el) return;
    const target = el.getBoundingClientRect().top + window.scrollY - 96;
    const start = window.scrollY;
    const dist = target - start;
    const dur = 450;
    const t0 = performance.now();
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const step = (now: number) => {
      const p = Math.min((now - t0) / dur, 1);
      window.scrollTo(0, start + dist * ease(p));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  document.querySelectorAll<HTMLElement>('[data-scroll-to]').forEach((el) => {
    el.addEventListener('click', (event) => {
      const id = el.dataset.scrollTo!;
      // No matching section on this page (e.g. a header/footer link on a
      // legal page) — let the link's href navigate back to "/#id" normally.
      if (!document.getElementById(id)) return;
      event.preventDefault();
      scrollToSection(id);
    });
  });

  // Mobile/tablet hamburger menu.
  const navToggle = document.querySelector<HTMLElement>('[data-nav-toggle]');
  const navMenu = document.querySelector<HTMLElement>('[data-nav-menu]');

  const setNavOpen = (open: boolean) => {
    navMenu?.classList.toggle('nav-open', open);
    navToggle?.setAttribute('aria-expanded', String(open));
  };

  navToggle?.addEventListener('click', () => {
    setNavOpen(!navMenu?.classList.contains('nav-open'));
  });

  navMenu?.querySelectorAll('a, button').forEach((el) => {
    el.addEventListener('click', () => setNavOpen(false));
  });

  document.addEventListener('click', (event) => {
    if (!navMenu?.classList.contains('nav-open')) return;
    const target = event.target as Node;
    if (navMenu.contains(target) || navToggle?.contains(target)) return;
    setNavOpen(false);
  });

  // FAQ accordion: one panel open at a time, closed on load. (Homepage only —
  // the queries below simply match nothing on pages without a FAQ section.)
  let openFaq: string | null = null;

  document.querySelectorAll<HTMLElement>('[data-faq-toggle]').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const index = toggle.dataset.faqToggle!;
      openFaq = openFaq === index ? null : index;

      document.querySelectorAll<HTMLElement>('[data-faq-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.faqPanel !== openFaq;
      });
      document.querySelectorAll<HTMLElement>('[data-faq-sign]').forEach((sign) => {
        sign.textContent = sign.dataset.faqSign === openFaq ? '−' : '+';
      });
    });
  });

  // "Agendar llamada" modal. (Homepage only.)
  const modal = document.querySelector<HTMLElement>('[data-modal]');
  const modalPanel = document.querySelector<HTMLElement>('[data-modal-panel]');

  const setModal = (open: boolean) => {
    if (modal) modal.hidden = !open;
  };

  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((el) => {
    el.addEventListener('click', () => setModal(true));
  });
  document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((el) => {
    el.addEventListener('click', () => setModal(false));
  });
  modal?.addEventListener('click', () => setModal(false));
  modalPanel?.addEventListener('click', (event) => event.stopPropagation());
</script>
